+static CTeachingDock *TeachingDock=NULL;
+static void UpdateTeachingDock(){if(!TeachAlignLoaded){TeachAlignLoaded=true;TeachSmartAlign=theApp.GetProfileInt("Teaching","SmartAlign",0)!=0;}if(TeachingDock)TeachingDock->Sync();}
+static void HideTeachingDock(){if(TeachingDock&&TeachingDock->Opened())TeachingDock->OnCancel();}
+static void DestroyTeachingDock(){TeachDragId=0;if(TeachingDock){if(TeachingDock->GetSafeHwnd())TeachingDock->DestroyWindow();delete TeachingDock;TeachingDock=NULL;}}
+static void TeachingGraphClicked(tDocumentStruct *object){if(TeachingDock)TeachingDock->Follow(object);}
+void CMathomirView::OnTeachingTools(UINT command){if(TeachDragId)return;if(ParameterPanel&&ParameterPanel->Opened())ParameterPanel->OnCancel();if(!TeachingDock){TeachingDock=new CTeachingDock();if(!TeachingDock->Create(IDD_TEACHING_DOCK,this)){delete TeachingDock;TeachingDock=NULL;return;}}SyncTeachingTools();TeachingDock->Open((int)command-ID_GRAPH_EXPLORER);}
