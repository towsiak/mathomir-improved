+        if(!e||NativeSymbolic::Empty(e)){error="This curve is empty.";return false;}int equal=-1;
+        for(int i=0;i<e->m_NumElements;i++)if(e->m_pElementList[i].Type==2&&e->m_pElementList[i].pElementObject->Data1[0]=='=')equal=i;
+        std::string left="y";if(equal>0)try{left=NativeSymbolic::Formula(e,0,equal);}catch(...){left="y";}
+        // Named native functions retain y as their plotted ordinate.
+        if(equal>0&&e->m_pElementList[0].Type==6)left="y";
+        if(equal>0&&equal<=2&&e->m_pElementList[0].Type==1){auto a=e->m_pElementList[0].pElementObject;if(a&&std::isalpha((unsigned char)a->Data1[0])&&strcmp(a->Data1,"x")&&strcmp(a->Data1,"y")&&strcmp(a->Data1,"e")&&(a->Data2[0]&0xE0)!=0x60)left="y";}
+        return curve.Parse(left+"="+NativeSymbolic::Formula(e,equal>=0?equal+1:0),is_x_pi!=0,values,error);
+    }catch(const std::exception &e){error=e.what();return false;}
