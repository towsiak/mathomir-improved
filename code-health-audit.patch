+++ b/Mathomir/MomDecode.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <cstddef>
+#include <cstring>
+// Bounded decoder for the existing MOM token format. Capacity excludes the NUL.
+namespace MomDecode {
+inline const char *Token(unsigned char c){
+    switch(c){
+        case 1:return "<obj type=";
+        case 2:return "</obj>";
+        case 3:return "<draw type=";
+        case 4:return "<group";
+        case 5:return "</group>\r\n";
+        case 6:return " width=";
+        case 8:return "<expr fnt_h=";
+        case 9:return " brack=";
+        case 11:return "<elm tp=\"1\" tx=";
+        case 12:return "<elm tp=";
+        case 14:return " fnt=";
+        case 15:return "</expr>\r\n";
+        case 31:return "</elm>\r\n";
+        case 16:return " stp=";
+        case 17:return ">\r\n";
+        case 19:return " txt=";
+        case 20:return " alig=";
+        case 21:return " Exp1=";
+        case 22:return " Exp2=";
+        case 23:return " X=";
+        case 24:return " Y=";
+        case 25:return " X1=";
+        case 26:return " Y1=";
+        case 27:return " X2=";
+        case 28:return " Y2=";
+        case 29:return " X3=";
+        case 30:return " Y3=";
+        case 251:return "<bmp bits=";
+        case 252:return " fnthq_h=";
+        case 255:return " b_shape=";
+        case 254:return " b_height=";
+        case 253:return " b_data=";
+    }return NULL;
+}
+inline bool Payload(const char *input,size_t length,char *output,size_t capacity,size_t &written){
+    written=0;
+    if(!input || !output || !length || input[0]!='<')return false;
+    bool quoted=false;
+    for(size_t i=0;i<length;i++){
+        unsigned char c=(unsigned char)input[i];
+        if(c=='"')quoted=!quoted;
+        if(!quoted){
+            const char *token=Token(c);
+            if(token){size_t n=std::strlen(token);if(n>capacity-written)return false;
+                std::memcpy(output+written,token,n);written+=n;continue;}
+        }else if(c==18){
+            if(length-i<4)return false;
+            size_t count=(unsigned char)input[i+1]+1u;
+            if(count>(capacity-written)/2)return false;
+            for(size_t n=0;n<count;n++){output[written++]=input[i+2];output[written++]=input[i+3];}
+            i+=3;continue;
+        }else if(c==7){
+            if(capacity-written<4)return false;
+            std::memcpy(output+written,"000\"",4);written+=4;quoted=false;continue;
+        }
+        if(written>=capacity)return false;
+        output[written++]=(char)c;
+    }
+    output[written]=0;return true;
+}
+}
