+// Reuse the actual palette geometry. Rendering a sample must never call the
+// drawing creator: it stores the live gesture in process-wide state.
+bool CToolbox::CopyDrawingToolSample(int form,CDrawing *sample)
+{
+    if(!sample)return false;
+    for(int i=0;i<ToolboxNumMembers;i++)for(int j=0;j<ToolboxMembers[i].NumSubmembers;j++)
+        if(ToolboxMembers[i].Above[j]==-1 && !(ToolboxMembers[i].userdef_mask&(1u<<j))){
+            CDrawing *source=(CDrawing*)ToolboxMembers[i].Submembers[j];
+            if(source && source->OriginalForm==form){sample->CopyDrawing(source);sample->SelectDrawing(0);return true;}
+        }
+    return false;
+}
+
+// Opt-in regression entry: enumerate and pick up the real palette entries,
+// through the same function as a left-side click. Dialog actions are excluded.
+int CToolbox::PalettePlacementProbe(int index,bool pick)
+{
+    if(!getenv("MATHOMIR_PLACEMENT_DIAGNOSTICS"))return 0;
+    int current=0;
+    for(int i=0;i<ToolboxNumMembers;i++)for(int j=0;j<ToolboxMembers[i].NumSubmembers;j++,current++){
+        if(current!=index)continue;
+        int type=1;
+        if(ToolboxMembers[i].Above[j]==-1){
+            int form=((CDrawing*)ToolboxMembers[i].Submembers[j])->OriginalForm;
+            type=ToolboxMembers[i].userdef_mask&(1u<<j)?2:form>0 && form<60?100+form:0;
+        }
+        if(pick && type)PickUpElementFromToolbox(i,j);
+        return type;
+    }
+    return index<0?current:-1;
+}
