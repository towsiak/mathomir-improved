+inline Point Add(Point a,Point b){Point p={a.x+b.x,a.y+b.y};return p;}
+inline Point Scale(Point a,double n){Point p={a.x*n,a.y*n};return p;}
+// Under, over, right and left braces share the same ten-segment geometry.
+inline void Outline(double span,double depth,int side,Point *points){
+    double c=span>600?24:span>300?18:span>150?14:10;
+    double u[11]={0,span/c/4,span/c,(c/2-1)*span/c-span/c/3,span/2-span/c/3,span/2,span/2+span/c/3,(c/2+1)*span/c+span/c/3,(c-1)*span/c,span-span/c/4,span};
+    double v[11]={0,depth/4,depth/2,depth/2,depth*.75,depth,depth*.75,depth/2,depth/2,depth/4,0};
+    for(int i=0;i<11;i++){Point p={u[i],v[i]};if(side==1)p.y=-p.y;if(side>=2){p.x=(side==2?1:-1)*v[i];p.y=u[i];}points[i]=p;}
+}
+// Position the box on the brace's actual outward ray, including after rotation.
+inline Layout Place(Point first,Point last,Point tip,double width,double height,double angle,double gap){
+    Point outward={tip.x-(first.x+last.x)/2,tip.y-(first.y+last.y)/2};double length=std::hypot(outward.x,outward.y);
+    if(length<1e-9){outward.x=0;outward.y=1;length=1;}outward=Scale(outward,1/length);
+    double c=std::cos(angle),s=std::sin(angle),nx=outward.x*c+outward.y*s,ny=-outward.x*s+outward.y*c;
+    double reach=1e30;if(std::fabs(nx)>1e-12)reach=width/(2*std::fabs(nx));if(std::fabs(ny)>1e-12)reach=(std::min)(reach,height/(2*std::fabs(ny)));
+    Layout r;r.contact=Add(tip,Scale(outward,gap));r.center=Add(tip,Scale(outward,gap+reach));
+    const double x[4]={-width/2,width/2,width/2,-width/2},y[4]={-height/2,-height/2,height/2,height/2};
+    for(int i=0;i<4;i++){Point p={c*x[i]-s*y[i],s*x[i]+c*y[i]};r.corner[i]=Add(r.center,p);}return r;
+}
+inline bool Contains(const Point *corners,Point p){bool positive=false,negative=false;for(int i=0;i<4;i++){Point a=corners[i],b=corners[(i+1)%4];double cross=(b.x-a.x)*(p.y-a.y)-(b.y-a.y)*(p.x-a.x);positive|=cross>1e-6;negative|=cross<-1e-6;}return !(positive&&negative);}
+}
