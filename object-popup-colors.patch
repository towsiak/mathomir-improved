+static bool DrawingOwnsExpression(CDrawing *drawing,CExpression *expression,int depth=0)
+{
+    if(!drawing || depth>128)return false;
+    for(int i=0;i<drawing->NumItems;i++){
+        tDrawingItem *item=drawing->Items+i;
+        if(item->Type==2 && item->pSubdrawing==(CObject*)expression)return true;
+        if(item->Type==0 && DrawingOwnsExpression((CDrawing*)item->pSubdrawing,expression,depth+1))return true;
+    }
+    return false;
+}
+void PopupMenu::CaptureAppearanceTargets(CExpression *expression,int ownerType)
+{
+    m_AppearanceTargets.clear();
+    if(ownerType!=1 && ownerType!=2 && ownerType!=3)return;
+    CExpression *root=expression;
+    for(int depth=0;root && root->m_pPaternalExpression && depth<128;depth++)root=root->m_pPaternalExpression;
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;if(!object->Object)continue;
+        bool target=false;
+        if(root)target=(object->Type==1 && object->Object==(CObject*)root) || (object->Type==2 && DrawingOwnsExpression((CDrawing*)object->Object,root));
+        else if(ownerType==2)target=object->MovingDotState==3 ||
+            (object->Type==2 && ((CDrawing*)object->Object)->IsSelected) ||
+            (object->Type==1 && ((CExpression*)object->Object)->m_Selection==0x7FFF);
+        if(target)m_AppearanceTargets.push_back(object->Object);
+    }
+}
+void PopupMenu::AddAppearanceOptions(int commonColor,int baseData,bool background)
+{
+    AddMenuOption(0,3*TSize,"Color:",-950,1);
+    int cell=TSize/3;
+    AddCheckedMenuOption(0,cell,"A",commonColor==-1,baseData,0);
+    for(int i=0;i<8;i++)AddCheckedMenuOption((i+1)*cell,cell,(char*)ImprovedColorNames[i],commonColor==i,baseData+i+1,i==7);
+    if(!background || m_AppearanceTargets.empty())return;
+    int commonBackground=-2;bool supported=false;
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;
+        if(std::find(m_AppearanceTargets.begin(),m_AppearanceTargets.end(),object->Object)==m_AppearanceTargets.end())continue;
+        if(object->Type!=1 && (object->Type!=2 || ((CDrawing*)object->Object)->IsSpecialDrawing))return;
+        int color=object->Type==1?((CExpression*)object->Object)->m_BackgroundColor:((CDrawing*)object->Object)->m_BackgroundColor;
+        if(!supported)commonBackground=color;else if(commonBackground!=color)commonBackground=-2;supported=true;
+    }
+    if(!supported)return;
+    AddMenuOption(0,3*TSize,"Background:",-951,1);
+    for(int i=0;i<8;i++)AddCheckedMenuOption((i+1)*cell,cell,(char*)ImprovedBackgroundNames[i],commonBackground==(int)ImprovedBackgrounds[i],920+i,i==7);
+    AddCheckedMenuOption(0,3*TSize/2,"Clear",commonBackground==-1,929,0);
+    AddMenuOption(3*TSize/2,3*TSize/2,"Custom...",928,1);
+}
+void PopupMenu::ApplyBackgroundOption(int data)
+{
+    // Hide before opening a native color dialog. It can pump messages and change
+    // hover/selection; revalidate the captured identities against the live document.
+    std::vector<CObject*> targets=m_AppearanceTargets;
+    HidePopupMenu();
+    if(ViewOnlyMode)return;
+    int color=data==929?-1:data==928?ImprovedCustomBackground():(int)ImprovedBackgrounds[data-920];
+    if(data==928){CColorDialog dialog((COLORREF)color,CC_FULLOPEN,pMainView);if(dialog.DoModal()!=IDOK)return;color=(int)dialog.GetColor();ImprovedCustomBackground()=color;}
+    bool changed=false;
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;
+        if(!object->Object || object->MovingDotState==5 || std::find(targets.begin(),targets.end(),object->Object)==targets.end())continue;
+        int *background=NULL;
+        if(object->Type==1)background=&((CExpression*)object->Object)->m_BackgroundColor;
+        else if(object->Type==2 && !((CDrawing*)object->Object)->IsSpecialDrawing)background=&((CDrawing*)object->Object)->m_BackgroundColor;
+        if(!background || *background==color)continue;
+        if(!changed)((CMainFrame*)theApp.m_pMainWnd)->UndoSave("object background");
+        *background=color;changed=true;
+    }
+    if(changed){pMainView->GetDocument()->SetModifiedFlag();pMainView->RepaintTheView(1);}
+    pMainView->SetFocus();
+}
