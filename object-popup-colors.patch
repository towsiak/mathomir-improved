+// Use the same cached extents as the native size calculation. Children are
+// tested first by selection so a group background never hides its contents.
+bool CDrawing::BackgroundContains(double x,double y,double zoom) const
+{
+    if(m_BackgroundColor<0 || IsSpecialDrawing || x<0 || y<0)return false;
+    double width=0,height=0,scale=zoom/(100.0*DRWZOOM);
+    for(int i=0;i<NumItems;i++){
+        const tDrawingItem &item=Items[i];
+        double padding=item.Type==1?item.LineWidth+halfDRWZOOM:0;
+        width=max(width,(double)max(item.X1,item.X2)+padding);
+        height=max(height,(double)max(item.Y1,item.Y2)+padding);
+    }
+    return x<width*scale && y<height*scale;
 }
 
