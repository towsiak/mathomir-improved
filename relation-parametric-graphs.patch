+static bool NativeGraphRelation(CExpression *expression,RelationGraph::Program &program,bool radians)
+{
+    if(!expression)return false;
+    int equal=-1;
+    for(int n=0;n<expression->m_NumElements;n++)if(expression->m_pElementList[n].Type==2&&expression->m_pElementList[n].pElementObject->Data1[0]=='='){if(equal>=0)return false;equal=n;}
+    if(equal<0)return false;
+    try{std::string left=NativeSymbolic::Formula(expression,0,equal),right=NativeSymbolic::Formula(expression,equal+1);std::string error;
+        // Keep ordinary y=f(x) and x=constant on their established exact paths.
+        SymbolicDerivative::Parser p;auto rhs=p.Parse(right);
+        if(left=="y"&&!SymbolicDerivative::Depends(rhs,"y"))return false;
+        if(left=="x"&&!SymbolicDerivative::Depends(rhs,"x")&&!SymbolicDerivative::Depends(rhs,"y"))return false;
+        program.Parse(left+"="+right,radians,error);return true;
+    }catch(const std::exception &){
+        // Never reinterpret an invalid two-sided relation as its right-hand side.
+        try{return NativeSymbolic::Formula(expression,0,equal)!="y";}catch(const std::exception &){return true;}
+    }
+}
