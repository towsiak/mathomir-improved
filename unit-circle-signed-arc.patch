+++ b/Mathomir/UnitCircleGeometry.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <cmath>
+
+namespace UnitCircleGeometry {
+// Automatic keeps the signed rotation and its complete turns. Explicit
+// directions only wrap a rotation that disagrees with the chosen direction.
+inline double Sweep(double start,double end,int direction) {
+    double sweep=end-start;
+    if(direction==1 && sweep<0) {
+        sweep=std::fmod(sweep,360.);
+        if(sweep<0)sweep+=360.;
+        if(std::fabs(sweep)<1e-8)sweep=360.;
+    } else if(direction==2 && sweep>0) {
+        sweep=std::fmod(sweep,360.);
+        if(sweep>0)sweep-=360.;
+        if(std::fabs(sweep)<1e-8)sweep=-360.;
+    }
+    return sweep;
+}
+template<class Line> void Arc(double start,double end,int direction,double radius,double center,Line line) {
+    double sweep=Sweep(start,end,direction);
+    if(std::fabs(sweep)<1e-8)return;
+    const double pi=3.14159265358979323846;
+    int segments=(int)std::ceil(std::fabs(sweep)/2.);
+    for(int i=0;i<segments;i++) {
+        double a=(start+sweep*i/segments)*pi/180.,b=(start+sweep*(i+1)/segments)*pi/180.;
+        line(center+radius*std::cos(a),center-radius*std::sin(a),
+             center+radius*std::cos(b),center-radius*std::sin(b),3);
+    }
+    double angle=(start+sweep)*pi/180.,sign=sweep<0?-1.:1.;
+    double x=center+radius*std::cos(angle),y=center-radius*std::sin(angle);
+    double tx=-std::sin(angle)*sign,ty=-std::cos(angle)*sign;
+    line(x,y,x-tx*10+ty*5,y-ty*10-tx*5,2);
+    line(x,y,x-tx*10-ty*5,y-ty*10+tx*5,2);
+}
+}
