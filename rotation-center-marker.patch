+static CRect RotationCenterRect()
+{
+    int x=(int)floor((RotationCenterX-ViewX)*ViewZoom/100.0+0.5);
+    int y=(int)floor((RotationCenterY-ViewY)*ViewZoom/100.0+0.5);
+    return CRect(x-11,y-11,x+12,y+12);
+}
+void CMathomirView::ShowRotationCenter(double x,double y,unsigned int holdMilliseconds)
+{
+    CRect previous=RotationCenterRect();bool changed=!RotationCenterVisible || x!=RotationCenterX || y!=RotationCenterY;
+    RotationCenterVisible=true;RotationCenterX=x;RotationCenterY=y;
+    RotationCenterExpires=holdMilliseconds?GetTickCount()+holdMilliseconds:0;
+    if(changed){InvalidateRect(previous,FALSE);CRect current=RotationCenterRect();InvalidateRect(current,FALSE);UpdateWindow();}
+}
+void CMathomirView::ClearRotationCenter(bool keepFlash)
+{
+    if(!RotationCenterVisible || (keepFlash && RotationCenterExpires))return;
+    CRect previous=RotationCenterRect();RotationCenterVisible=false;RotationCenterExpires=0;
+    if(GetSafeHwnd())InvalidateRect(previous,FALSE);
+}
+void CMathomirView::PaintRotationCenter(CDC *dc)
+{
+    bool visible=RotationCenterVisible && !PrintRendering && !ViewOnlyMode && !IsDrawingMode;
+    CRect area=RotationCenterRect();int x=area.left+11,y=area.top+11;
+    if(getenv("MATHOMIR_ROTATION_DIAGNOSTICS")){
+        ::SetProp(GetSafeHwnd(),"RotationPivot_Visible",(HANDLE)(INT_PTR)(visible+1));
+        ::SetProp(GetSafeHwnd(),"RotationPivot_X",(HANDLE)(INT_PTR)(x+1));
+        ::SetProp(GetSafeHwnd(),"RotationPivot_Y",(HANDLE)(INT_PTR)(y+1));
+        tDocumentStruct *object=RotationHandleDocument();CPoint grip=object?RotationHandlePoint(object):CPoint(-1,-1);
+        ::SetProp(GetSafeHwnd(),"RotationPivot_GripX",(HANDLE)(INT_PTR)(grip.x+1));
+        ::SetProp(GetSafeHwnd(),"RotationPivot_GripY",(HANDLE)(INT_PTR)(grip.y+1));
+    }
+    if(!visible)return;
+    int saved=dc->SaveDC();dc->SetROP2(R2_COPYPEN);
+    CPen halo(PS_SOLID,3,RGB(255,255,255));CPen ink(PS_SOLID,1,RGB(20,55,90));
+    CBrush paper(RGB(255,255,255)),dot(RGB(20,55,90));
+    dc->SelectObject(&halo);dc->SelectObject(&paper);
+    dc->MoveTo(x-9,y);dc->LineTo(x+10,y);dc->MoveTo(x,y-9);dc->LineTo(x,y+10);
+    dc->SelectObject(&ink);
+    dc->MoveTo(x-9,y);dc->LineTo(x+10,y);dc->MoveTo(x,y-9);dc->LineTo(x,y+10);
+    dc->Ellipse(x-5,y-5,x+6,y+6);
+    dc->SelectObject(&dot);dc->Ellipse(x-2,y-2,x+3,y+3);
+    dc->RestoreDC(saved);
+}
