+static bool IsPopupSelectionObject(tDocumentStruct *object)
+{
+    return object->Object && (object->MovingDotState==3 ||
+        (object->Type==2 && ((CDrawing*)object->Object)->IsSelected) ||
+        (object->Type==1 && ((CExpression*)object->Object)->m_Selection==0x7FFF));
+}
+static bool PopupSelectionBounds(int &left,int &top,int &right,int &bottom)
+{
+    left=top=0x7FFFFFFF;right=bottom=INT_MIN;bool found=false;
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;if(!IsPopupSelectionObject(object))continue;
+        left=min(left,object->absolute_X);top=min(top,object->absolute_Y-object->Above);
+        right=max(right,object->absolute_X+object->Length);bottom=max(bottom,object->absolute_Y+object->Below);found=true;
+    }
+    return found;
+}
+static bool IsPopupRotationCommand(int data)
+{
+    return (data>=540 && data<=545) || (data>=571 && data<=575);
+}
