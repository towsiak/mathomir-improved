+// Dialog previews and placement use one native table constructor. Sample text
+// belongs only to the private preview and never reaches the placed expression.
+static CExpression *BuildConfiguredTable(int rows,int columns,int font,int borders,int alignment,bool sample=false)
+{
+    if(rows<1 || rows>20 || columns<1 || columns>12 || rows*columns<2 || font<40 || font>800 ||
+       borders<0 || borders>3 || alignment<0 || alignment>2)return NULL;
+    CExpression *table=new CExpression(NULL,NULL,font);
+    table->InsertEmptyElement(0,5,(char)0x80);
+    CExpression *cells=(CExpression*)table->m_pElementList->pElementObject->Expression1;
+    cells->m_ParenthesesFlags=0;cells->m_ParentheseShape=' ';
+    if(cells->FindMatrixElement(rows-1,columns-1,1)<0){delete table;return NULL;}
+    char align=alignment==0?'l':alignment==1?'c':'r';
+    // A native cell setter also updates its neighbor. Define shared edges by
+    // boundary index so a later row cannot erase an earlier header separator.
+    auto horizontal=[=](int edge){return borders==0 || (borders==1 && (edge==0 || edge==rows)) || (borders==2 && edge==1);};
+    auto vertical=[=](int edge){return borders==0 || (borders==1 && (edge==0 || edge==columns));};
+    for(int row=0;row<rows;row++)for(int col=0;col<columns;col++)
+        cells->SetCellAttributes(row,col,align,horizontal(row)?'-':' ',horizontal(row+1)?'-':' ',
+            vertical(col)?'-':' ',vertical(col+1)?'-':' ');
+    if(sample)for(int row=rows-1;row>=0;row--)for(int col=columns-1;col>=0;col--){
+        int cell=cells->FindMatrixElement(row,col,0);
+        if(cell<0){delete table;return NULL;}
+        cells->InsertEmptyElement(cell,1,'x');
+        if(row==0)strcpy(cells->m_pElementList[cell].pElementObject->Data1,"ABC");
+    }
+    return table;
+}
+class CTableLayoutPreview : public CStatic
+{
+public:
+    CExpression *table;
+    CTableLayoutPreview():table(NULL){}
+    ~CTableLayoutPreview(){delete table;}
+    void Set(CExpression *next){delete table;table=next;if(GetSafeHwnd())Invalidate(FALSE);}
+protected:
+    afx_msg void OnPaint(){
+        CPaintDC screen(this);CRect r;GetClientRect(&r);
+        CDC dc;CBitmap bitmap;
+        if(!dc.CreateCompatibleDC(&screen) || !bitmap.CreateCompatibleBitmap(&screen,max(1,r.Width()),max(1,r.Height())))return;
+        CBitmap *old=dc.SelectObject(&bitmap);int saved=dc.SaveDC();dc.FillSolidRect(r,RGB(255,255,255));dc.SetBkMode(TRANSPARENT);
+        if(table){
+            short width,above,below;table->CalculateSize(&dc,100,&width,&above,&below);
+            double fit=min(1.0,min((r.Width()-20.0)/max(1,(int)width),(r.Height()-20.0)/max(1,(int)above+below)));
+            short zoom=(short)max(1,(int)floor(fit*100));
+            table->CalculateSize(&dc,zoom,&width,&above,&below);
+            table->PaintExpression(&dc,zoom,max(5,(r.Width()-width)/2),max(5,(r.Height()-above-below)/2)+above,&r);
+            if(getenv("MATHOMIR_TABLE_DIAGNOSTICS")){
+                ::SetProp(GetSafeHwnd(),"TablePreview_Width",(HANDLE)(INT_PTR)(width+1));
+                ::SetProp(GetSafeHwnd(),"TablePreview_Height",(HANDLE)(INT_PTR)(above+below+1));
+                ::SetProp(GetSafeHwnd(),"TablePreview_Zoom",(HANDLE)(INT_PTR)(zoom+1));
+            }
+        }else{
+            dc.SetTextColor(RGB(120,70,50));CRect message=r;message.DeflateRect(12,12);
+            dc.DrawText("Enter valid settings to see the table layout.",message,DT_CENTER|DT_WORDBREAK|DT_VCENTER);
+        }
+        dc.RestoreDC(saved);screen.BitBlt(0,0,r.Width(),r.Height(),&dc,0,0,SRCCOPY);dc.SelectObject(old);
+    }
+    DECLARE_MESSAGE_MAP()
+};
