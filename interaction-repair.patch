+        CExpression label(NULL,NULL,100); label.InsertEmptyElement(0,1,end?'b':'a');
+        drawing->CopyExpressionIntoSubgroup(&label,x-4,y+12,0,0);
+    }
+    ClipboardDrawing=new CDrawing();
