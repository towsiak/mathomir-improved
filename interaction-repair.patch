+// Font sizes are percentages of the normal equation size. Scale nested parts
+// together so superscripts and fractions retain their proportions.
+static void ResizeObjectFonts(CObject *object, int type, int size)
+{
+    if (!object) return;
+    if (type==1)
+    {
+        CExpression *expression=(CExpression*)object;
+        expression->ChangeFontSize((float)size/max(10,(int)expression->m_FontSize));
+    }
+    else if (type==2)
+    {
+        CDrawing *drawing=(CDrawing*)object;
+        for (int i=0;i<drawing->NumItems;i++)
+        {
+            tDrawingItem *item=drawing->Items+i;
+            if (item->Type==0) ResizeObjectFonts((CObject*)item->pSubdrawing,2,size);
+            if (item->Type==2) ResizeObjectFonts((CObject*)item->pSubdrawing,1,size);
+        }
+    }
+}
+
+void CMathomirView::OnQuickFontSize(UINT command)
+{
+    if (ViewOnlyMode) return;
+    int size=100;
+    if (command==ID_FONT_SIZE_200) size=200;
+    if (command==ID_FONT_SIZE_400) size=400;
+    if (command==ID_FONT_SIZE_800) size=800;
+    UndoSave("font size",20501);
+    bool changed=false;
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (object->MovingDotState==3 || (NumSelectedObjects==0 &&
+            (object==(KeyboardEntryBaseObject ? KeyboardEntryBaseObject : SelectedDocumentObject))))
+        {
+            ResizeObjectFonts(object->Object,object->Type,size);
+            changed=true;
+        }
+    }
+    if (!changed) DefaultFontSize=size;
+    RepaintTheView(1);
+    if (KeyboardEntryObject) SendKeyStroke(-1,0,0);
+    ((CMainFrame*)theApp.m_pMainWnd)->AdjustMenu();
+}
+
+void CMathomirView::OnFontAllObjects()
+{
+    if (ViewOnlyMode) return;
+    CDC *dc=GetDC();
+    LOGFONT font;
+    ((CMainFrame*)theApp.m_pMainWnd)->GetLogicalFont(0,&font,dc);
+    font.lfHeight=-MulDiv(15,dc->GetDeviceCaps(LOGPIXELSY),72);
+    CHOOSEFONT choice;
+    ZeroMemory(&choice,sizeof(choice));
+    choice.lStructSize=sizeof(choice);
+    choice.hwndOwner=theApp.m_pMainWnd->m_hWnd;
+    choice.lpLogFont=&font;
+    choice.Flags=CF_SCREENFONTS|CF_INITTOLOGFONTSTRUCT|CF_SCALABLEONLY|CF_LIMITSIZE|CF_NOSTYLESEL;
+    choice.nSizeMin=6;
+    choice.nSizeMax=120;
+    if (ChooseFont(&choice))
+    {
+        UndoSave("font for all objects",20502);
+        int size=max(40,min(800,MulDiv(choice.iPointSize,100,150)));
+        // The application stores named font slots globally. Keep Symbol intact.
+        // Keep their original size calibration; size is stored in each equation.
+        for (int slot=0;slot<3;slot++)
+        {
+            LOGFONT original;
+            ((CMainFrame*)theApp.m_pMainWnd)->GetLogicalFont(slot,&original,dc);
+            lstrcpyn(original.lfFaceName,font.lfFaceName,LF_FACESIZE);
+            original.lfCharSet=font.lfCharSet;
+            ((CMainFrame*)theApp.m_pMainWnd)->SetLogicalFont(slot,&original,dc);
+        }
+        for (int i=0;i<NumDocumentElements;i++)
+            ResizeObjectFonts(TheDocument[i].Object,TheDocument[i].Type,size);
+        DefaultFontSize=size;
+        RepaintTheView(1);
+        if (KeyboardEntryObject) SendKeyStroke(-1,0,0);
+        Toolbox->InvalidateRect(NULL,1);
+        ((CMainFrame*)theApp.m_pMainWnd)->AdjustMenu();
+    }
+    ReleaseDC(dc);
+}
