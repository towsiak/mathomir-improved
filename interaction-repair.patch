+        CRect rect((15+left-ViewX)*ViewZoom/100,(5+page*PaperHeight+top-ViewY)*ViewZoom/100,
+            (15+PaperWidth-right-ViewX)*ViewZoom/100,(5+(page+1)*PaperHeight-bottom-ViewY)*ViewZoom/100);
+        dc->Rectangle(rect);
+    }
+    bool danger=false;
+    for(int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if(!object->Object || object->absolute_Y<0 || (object->Type!=1 && object->Type!=2))continue;
+        int page=max(0,(object->absolute_Y-5)/PaperHeight);
+        if(object->absolute_X<15+left || object->absolute_X+object->Length>15+PaperWidth-right ||
+            object->absolute_Y-object->Above<5+page*PaperHeight+top ||
+            object->absolute_Y+object->Below>5+(page+1)*PaperHeight-bottom){danger=true;break;}
+    }
+    if(danger && !SafePrintDanger){SafePrintWarningSince=GetTickCount();SafePrintWarningPhase=-1;}
+    SafePrintDanger=danger;
+    if(danger)
+    {
+        bool pulse=GetTickCount()-SafePrintWarningSince<3000 && ((GetTickCount()-SafePrintWarningSince)/250)%2;
+        CRect banner(18,8,min(TheClientRect.right-8,390),34);
+        dc->FillSolidRect(banner,pulse?RGB(255,224,175):RGB(255,246,228));
+        dc->SetBkMode(TRANSPARENT);dc->SetTextColor(RGB(170,100,20));
+        dc->SelectObject(GetFontFromPool(4,0,0,14));
+        dc->DrawText("Print warning: content outside safe area",banner,DT_CENTER|DT_VCENTER|DT_SINGLELINE);
+    }
+    dc->RestoreDC(saved);
+}
