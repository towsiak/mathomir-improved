+    double c,s,minX,minY; int width,height;
+    RotationGeometry(&c,&s,&minX,&minY,&width,&height);
+    XFORM transform={(FLOAT)c,(FLOAT)s,(FLOAT)-s,(FLOAT)c,(FLOAT)(X-minX),(FLOAT)(Y-height/2-minY)};
+    int saved=DC->SaveDC();
+    if (saved && ::SetGraphicsMode(DC->m_hDC,GM_ADVANCED) &&
+        ::ModifyWorldTransform(DC->m_hDC,&transform,MWT_LEFTMULTIPLY))
+    {
