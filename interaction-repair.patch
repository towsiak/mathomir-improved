+double CFunctionPlotter::PieceValue(int slot,double x,CExpression *function,void *variables)
+{
+    if(slot<(int)pieces.size())return pieces[slot].Contains(x)?pieces[slot].program.Value(x,pieceRadians):sqrt(-1.0);
