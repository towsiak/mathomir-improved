+static void IntervalLine(CDrawing *drawing,double x1,double y1,double x2,double y2,int width=1)
+{
+    int index=drawing->NumItems;
+    drawing->InsertItemAt(index);
+    tDrawingItem *item=drawing->Items+index;
+    item->Type=1; item->pSubdrawing=NULL;
+    item->X1=(int)floor(x1*DRWZOOM+0.5); item->Y1=(int)floor(y1*DRWZOOM+0.5);
