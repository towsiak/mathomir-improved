diff --git a/Mathomir/NativeSymbolic.h b/Mathomir/NativeSymbolic.h
new file mode 100644
index 0000000..2eb13b8
--- /dev/null
+++ b/Mathomir/NativeSymbolic.h
@@ -0,0 +1,55 @@
+#pragma once
+#include "SymbolicDerivative.h"
+#include "Expression.h"
+
+namespace NativeSymbolic {
+inline bool Empty(CExpression *e){if(!e)return true;for(int i=0;i<e->m_NumElements;i++)if(e->m_pElementList[i].Type>0)return false;return true;}
+inline std::string Formula(CExpression *e,int start=0,int end=-1,int depth=0){
+    if(!e||depth>40)throw std::runtime_error("The expression is too deeply nested.");if(end<0)end=e->m_NumElements;
+    std::string result;bool previous=false;
+    for(int i=start;i<end;i++){
+        tElementStruct *ts=e->m_pElementList+i;if(ts->Type==0)continue;CElement *element=ts->pElementObject;if(!element)throw std::runtime_error("Incomplete expression.");
+        CExpression *a=(CExpression*)element->Expression1,*b=(CExpression*)element->Expression2;std::string term;bool operand=true;
+        if(ts->Type==1){if(a||b)throw std::runtime_error("Use plain-letter variables without subscripts in the derivative finder.");term=element->Data1;if((element->Data2[0]&0xE0)==0x60){if(term=="p")term="pi";else throw std::runtime_error("Use plain-letter variables in the derivative finder.");}}
+        else if(ts->Type==2){char op=element->Data1[0];if(op==(char)0xD7)op='*';if(op!='+'&&op!='-'&&op!='*'&&op!='/')throw std::runtime_error("This operator is not supported by direct execution.");term=std::string(1,op);operand=false;}
+        else if(ts->Type==3||ts->Type==4)term="("+Formula(a,0,-1,depth+1)+")"+(ts->Type==3?"^":"/")+"("+Formula(b,0,-1,depth+1)+")";
+        else if(ts->Type==5){char shape=a?a->m_ParentheseShape:0;std::string name=shape=='|'?"abs":shape=='f'?"floor":shape=='c'?"ceil":"";term=name+"("+Formula(a,0,-1,depth+1)+")";}
+        else if(ts->Type==6){std::string name=element->Data1;if(name=="tg")name="tan";if(name=="arctg")name="atan";if(name=="sh")name="sinh";if(name=="ch")name="cosh";if(name=="th")name="tanh";
+            if(name=="log"&&!Empty(b))term="(ln("+Formula(a,0,-1,depth+1)+")/ln("+Formula(b,0,-1,depth+1)+"))";
+            else{if(!SymbolicDerivative::Known(name)&&name!="arcsin"&&name!="arccos"&&name!="arctan")throw std::runtime_error("Unsupported function: "+name+". Use the derivative finder for supported formulas.");term=name+"("+Formula(a,0,-1,depth+1)+")";if(!Empty(b))term="("+term+")^("+Formula(b,0,-1,depth+1)+")";}
+        }
+        else if(ts->Type==8)term=Empty(b)?"sqrt("+Formula(a,0,-1,depth+1)+")":"("+Formula(a,0,-1,depth+1)+")^(1/("+Formula(b,0,-1,depth+1)+"))";
+        else throw std::runtime_error("This expression type is not supported by direct execution.");
+        if(operand&&previous)result+="*";result+=term;previous=operand;if(result.size()>8192)throw std::runtime_error("The expression is too large.");
+    }if(result.empty())throw std::runtime_error("Fill in the expression before executing it.");return result;
+}
+inline bool Differentiate(CExpression *input,CExpression *variable,SymbolicDerivative::Result &r,std::string &error,int order=1){try{return r.Find(Formula(input),Formula(variable),order,error);}catch(const std::exception &e){error=e.what();return false;}}
+inline bool ReadDerivative(CExpression *input,SymbolicDerivative::Result &r,std::string &error){
+    try{
+        int position=0;while(position<input->m_NumElements&&input->m_pElementList[position].Type==0)position++;
+        if(position>=input->m_NumElements||input->m_pElementList[position].Type!=4)return false;
+        CElement *fraction=input->m_pElementList[position].pElementObject;CExpression *top=(CExpression*)fraction->Expression1,*bottom=(CExpression*)fraction->Expression2;
+        if(!top||!bottom||top->m_NumElements<1||bottom->m_NumElements<1)return false;
+        CElement *numerator=top->m_pElementList[0].pElementObject,*denominator=bottom->m_pElementList[0].pElementObject;if(!numerator||!denominator)return false;
+        bool nd=(top->m_pElementList[0].Type==6&&numerator->IsDifferential(1))||(top->m_NumElements==1&&top->m_pElementList[0].Type==1&&strcmp(numerator->Data1,"d")==0);
+        bool dd=(bottom->m_pElementList[0].Type==6&&denominator->IsDifferential(1))||(bottom->m_pElementList[0].Type==1&&strcmp(denominator->Data1,"d")==0);
+        if(!nd||!dd)return false;
+        CExpression *argument=top->m_pElementList[0].Type==6?(CExpression*)numerator->Expression1:NULL;
+        CExpression *variable=bottom->m_pElementList[0].Type==6?(CExpression*)denominator->Expression1:NULL;
+        int order=1;CExpression *power=(CExpression*)numerator->Expression2;
+        if(!Empty(power)){double number;int precision;if(!power->IsPureNumber(0,power->m_NumElements,&number,&precision)||number<1||number>5||number!=floor(number))throw std::runtime_error("Choose derivative order 1 through 5.");order=(int)number;}
+        std::string name;
+        if(variable && variable->m_NumElements==1 && variable->m_pElementList[0].Type==3){CElement *p=variable->m_pElementList[0].pElementObject;name=Formula((CExpression*)p->Expression1);}else if(variable)name=Formula(variable);else name=Formula(bottom,1);
+        if(Empty(argument)){
+            CExpression *combined=variable?variable:bottom;int first=variable?0:1;
+            if(combined && combined->m_NumElements>first+1 && combined->m_pElementList[first].Type==1){
+                CElement *letter=combined->m_pElementList[first].pElementObject;
+                if(letter && strlen(letter->Data1)==1)return r.Find(Formula(combined,first+1),letter->Data1,order,error);
+            }
+        }
+        if(!Empty(argument))return r.Find(Formula(argument),name,order,error);
+        // d/dx followed by a parenthesized function is the common typed operator.
+        return r.Find(Formula(input,position+1),name,order,error);
+    }catch(const std::exception &e){error=e.what();return false;}
+}
+}
diff --git a/Mathomir/PiAxis.h b/Mathomir/PiAxis.h
new file mode 100644
index 0000000..3bd012b
--- /dev/null
+++ b/Mathomir/PiAxis.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cmath>
+#include <cwchar>
+#include <string>
+namespace PiAxis {
+static const double pi=3.14159265358979323846;
+struct Step { long long numerator,denominator; double value() const { return pi*numerator/denominator; } };
+inline Step ChooseStep(double span,int width) {
+    Step result={1,1};
+    double count=width/75.0; if(count<2) count=2; if(count>20) count=20;
+    double desired=span/count;
+    if (!(desired>0) || !std::isfinite(desired)) return result;
+    if(desired>=pi) { while(result.value()<desired && result.numerator<(1LL<<40)) result.numerator*=2; }
+    else { const int denominators[]={2,3,4,6,8,12,16,24,32,48,64,96,128,192,256,384,512,1024,2048,4096};
+        for(unsigned i=0;i<sizeof(denominators)/sizeof(denominators[0]);i++) {
+            if(pi/denominators[i]<desired) break;
+            result.denominator=denominators[i];
+        }
+    }
+    return result;
+}
+inline std::wstring Label(long long tick,Step step) {
+    long long n=tick*step.numerator,d=step.denominator;
+    if(!n) return L"0";
+    bool negative=n<0; if(negative)n=-n;
