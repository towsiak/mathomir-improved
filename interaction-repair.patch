+        ShowWindow(ViewOnlyMode ? SW_HIDE : SW_SHOWNOACTIVATE);
+        int reserved=width>=330 ? 214 : (width>=210 ? 62 : 0);
+        int field=max(50,min(320,width-58-reserved));
+        label.MoveWindow(6,4,45,24); search.MoveWindow(52,3,field,26);
