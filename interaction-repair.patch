+static tDocumentStruct *MoveGripDocument()
+{
+    for (int i=0;i<NumDocumentElements;i++)
+        if (TheDocument[i].Object==MoveGripObject) return TheDocument+i;
+    return NULL;
+}
+bool CMathomirView::BeginGripMove(CPoint point)
+{
+    tDocumentStruct *object=ResizeHandleDocument();
+    if (!object || object->MovingDotState==5 || ViewOnlyMode || IsDrawingMode) return false;
+    CPoint grip=MoveGripPoint(object);
+    CPoint lower=LowerMoveGripPoint(object);
+    bool upperHit=abs(point.x-grip.x)<=9 && abs(point.y-grip.y)<=9;
+    bool lowerHit=abs(point.x-lower.x)<=9 && abs(point.y-lower.y)<=9;
+    if (!upperHit && !lowerHit) return false;
+    RestoreClipboardBackground();
+    if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+    if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+    if (KeyboardEntryObject) { ((CExpression*)KeyboardEntryObject)->KeyboardStop(); KeyboardEntryObject=NULL; KeyboardEntryBaseObject=NULL; }
+    LastQuickTypeObject=NULL; FunctionHelpText.Empty();
+    MoveGripObject=object->Object; MoveStartX=object->absolute_X; MoveStartY=object->absolute_Y; MoveStartPoint=point;
+    UndoSave("move with grip",20507); MouseMovingActive=true; MouseMode=105;
+    FreePlacementGesture=false; SetCapture(); SetCursor(::LoadCursor(NULL,IDC_SIZEALL));
+    return true;
+}
+void CMathomirView::UpdateGripMove(CPoint point)
+{
+    tDocumentStruct *object=MoveGripDocument();
+    if (!object) { EndGripMove(true); return; }
+    object->absolute_X=MoveStartX+(point.x-MoveStartPoint.x)*100/ViewZoom;
+    object->absolute_Y=MoveStartY+(point.y-MoveStartPoint.y)*100/ViewZoom;
+    GetDocument()->SetModifiedFlag(); InvalidateRect(NULL,FALSE); UpdateWindow();
+}
+void CMathomirView::EndGripMove(bool cancel)
+{
+    tDocumentStruct *object=MoveGripDocument();
+    if (cancel && object) { object->absolute_X=MoveStartX; object->absolute_Y=MoveStartY; }
+    MouseMovingActive=false; MouseMode=0; MoveGripObject=NULL;
+    if (GetCapture()==this) ReleaseCapture();
+    RepaintTheView(1); SetCursor(::LoadCursor(NULL,IDC_ARROW));
+}
+void CMathomirView::PaintMoveGrip(CDC *dc)
+{
+    tDocumentStruct *object=ResizeHandleDocument();
+    if (!object || object->MovingDotState==5) return;
+    for(int grip=0;grip<2;grip++)
+    {
+    CPoint p=grip==0?MoveGripPoint(object):LowerMoveGripPoint(object);
+    int saved=dc->SaveDC(); CPen pen(PS_SOLID,1,RGB(45,95,155));
+    dc->SelectObject(&pen); dc->FillSolidRect(p.x-8,p.y-8,17,17,RGB(255,255,255));
+    dc->MoveTo(p.x-6,p.y); dc->LineTo(p.x+7,p.y);
+    dc->MoveTo(p.x,p.y-6); dc->LineTo(p.x,p.y+7);
+    for (int n=-1;n<=1;n+=2)
+    {
+        dc->MoveTo(p.x+n*6,p.y); dc->LineTo(p.x+n*3,p.y-3);
+        dc->MoveTo(p.x+n*6,p.y); dc->LineTo(p.x+n*3,p.y+3);
+        dc->MoveTo(p.x,p.y+n*6); dc->LineTo(p.x-3,p.y+n*3);
+        dc->MoveTo(p.x,p.y+n*6); dc->LineTo(p.x+3,p.y+n*3);
+    }
+    dc->RestoreDC(saved);
+    }
+}
