diff --git a/Mathomir/MathDisplay.h b/Mathomir/MathDisplay.h
new file mode 100644
index 0000000..0b7e258
--- /dev/null
+++ b/Mathomir/MathDisplay.h
@@ -0,0 +1,66 @@
+#pragma once
+#include <string>
+#include <cmath>
+#include <limits>
+#include <sstream>
+#include <iomanip>
+#include <locale>
+#include <cstdlib>
+#include <cctype>
+
+// Presentation only: formulas, editable numbers and saved data retain their
+// original precision and syntax. Use wide text with Unicode Windows APIs.
+namespace MathDisplay {
+inline std::wstring Superscript(int exponent) {
+    static const wchar_t digits[]=L"\u2070\u00b9\u00b2\u00b3\u2074\u2075\u2076\u2077\u2078\u2079";
+    std::wstring out;if(exponent<0){out+=L'\u207b';exponent=-exponent;}
+    std::string n=std::to_string(exponent);for(size_t i=0;i<n.size();i++)out+=digits[n[i]-'0'];return out;
+}
+inline std::wstring NumericText(std::string text) {
+    if(text=="nan" || text=="-nan" || text=="undefined")return L"Undefined";
+    if(text=="inf" || text=="+inf")return L"+\u221e";
+    if(text=="-inf")return L"\u2212\u221e";
+    size_t e=text.find('e');std::wstring out;
+    std::string mantissa=e==std::string::npos?text:text.substr(0,e);
+    for(size_t i=0;i<mantissa.size();i++)out+=mantissa[i]=='-'?L'\u2212':(wchar_t)mantissa[i];
+    if(e!=std::string::npos)out+=L" \u00d7 10"+Superscript(std::atoi(text.c_str()+e+1));
+    return out;
+}
+inline std::wstring Number(double value) {
+    if(value!=value)return L"Undefined";
+    if(value==std::numeric_limits<double>::infinity())return L"+\u221e";
+    if(value==-std::numeric_limits<double>::infinity())return L"\u2212\u221e";
+    if(value==0)return L"0"; // Suppress negative zero, without hiding small values.
+    std::ostringstream text;text.imbue(std::locale::classic());text<<std::setprecision(12)<<value;
+    return NumericText(text.str());
+}
+inline std::wstring AxisLabel(std::string text) {
+    if(text.compare(0,4,"Int=")==0)return L"Integral \u2248 "+AxisLabel(text.substr(4));
+    // Legacy axes use engineering prefixes and +e12/-e15 suffixes.
+    size_t e=text.find('e');if(e!=std::string::npos && e>0 && (text[e-1]=='+' || text[e-1]=='-')){
+        std::string mantissa=text.substr(0,e-1);int exponent=std::atoi(text.c_str()+e+1);
+        if(text[e-1]=='-')exponent=-exponent;
+        return NumericText(mantissa)+L" \u00d7 10"+Superscript(exponent);
+    }
+    if(!text.empty() && text[text.size()-1]=='u')return NumericText(text.substr(0,text.size()-1))+L"\u00b5";
+    // A rounded tick must not read -0 or -0.000.
+    if(!text.empty() && text[0]=='-' && text.find_first_not_of("-0.")==std::string::npos)text.erase(0,1);
+    return NumericText(text);
+}
+inline bool Word(char c){return std::isalnum((unsigned char)c)!=0 || c=='_';}
+inline std::wstring HelpNotation(const std::string &text) {
+    std::wstring out;
+    for(size_t i=0;i<text.size();){
+        if(text.compare(i,8,"infinity")==0){out+=(i>0 && text[i-1]=='-')?L"\u221e":L"+\u221e";i+=8;continue;}
+        if(text.compare(i,2,"pi")==0 && (i==0 || !Word(text[i-1])) && (i+2==text.size() || !Word(text[i+2]))){out+=L'\u03c0';i+=2;continue;}
+        if(text.compare(i,3,"deg")==0 && (i==0 || !Word(text[i-1])) && (i+3==text.size() || !Word(text[i+3]))){if(!out.empty() && out[out.size()-1]==' ')out.erase(out.size()-1);out+=L'\u00b0';i+=3;continue;}
+        if(text.compare(i,2,">=")==0){out+=L'\u2265';i+=2;continue;}
+        if(text.compare(i,2,"<=")==0){out+=L'\u2264';i+=2;continue;}
+        if(text.compare(i,2,"!=")==0){out+=L'\u2260';i+=2;continue;}
+        if(text.compare(i,3,"e^x")==0){out+=L"e\u02e3";i+=3;continue;}
+        if(text[i]=='*'){out+=L'\u00b7';i++;continue;}
+        if(text[i]=='-' && i+1<text.size() && (std::isdigit((unsigned char)text[i+1]) || text.compare(i+1,2,"pi")==0 || text.compare(i+1,8,"infinity")==0)){out+=L'\u2212';i++;continue;}
+        out+=(unsigned char)text[i++];
+    }return out;
+}
+}
