+    dialog.Add(ID_TRIG_DEGREES,"Trig angles > Use degrees (DEG)","sin cos tan angle mode degree");
+    dialog.Add(ID_ROTATE_WITH_MOUSE,"Rotate > Drag text / equation with mouse","angle turn tilt orientation rotate rotation handle mouse");
+    dialog.Add(ID_FONT_ALL_OBJECTS,"Font > Change font and size for all objects",dialog.Aliases(ID_FONT_ALL_OBJECTS));
+    dialog.Add(ID_EDIT_ROTATE_EQUATION,"Rotate > Set text / equation angle",dialog.Aliases(ID_EDIT_ROTATE_EQUATION));
+    dialog.Add(ID_FONT_FIT_PAGE,"Smart font size > Fit equation to page width","large bigger smart intelligent auto automatic fit page width");
+    dialog.Add(ID_FONT_FIT_WINDOW,"Smart font size > Fit equation to window width","large bigger smart intelligent auto automatic fit screen window width");
+    dialog.Add(ID_FONT_SIZE_800,"Font size > Maximum (800%)",dialog.Aliases(ID_FONT_SIZE_800));
+    dialog.Add(ID_FONT_SIZE_400,"Font size > Huge (400%)",dialog.Aliases(ID_FONT_SIZE_400));
+    dialog.Add(ID_FONT_SIZE_200,"Font size > Extra large (200%)",dialog.Aliases(ID_FONT_SIZE_200));
+    dialog.Add(ID_FONT_SIZE_100,"Font size > Normal (100%)",dialog.Aliases(ID_FONT_SIZE_100));
+    ((CMainFrame*)theApp.m_pMainWnd)->AdjustMenu();
+    dialog.Collect(theApp.m_pMainWnd->GetMenu(),"");
+    dialog.Add(ID_GRAPH_PI_FRACTIONS,"Graph > X-axis: pi fractions (radians)","pi pie fractions radians trig graph ticks labels");
+    dialog.Add(ID_GRAPH_DECIMAL_LABELS,"Graph > X-axis: decimal labels","graph decimal numeric ticks labels");
+    dialog.Add(0,"Draw > Brace (drag to set its size)","bracket curly brace overbrace underbrace annotation",19);
+    dialog.Add(0,"Draw > Line","straight stroke segment",2);
+    dialog.Add(0,"Draw > Arrow","direction pointer vector",5);
+    dialog.Add(0,"Draw > Rectangle","box square shape",1);
+    dialog.Add(0,"Draw > Ellipse / circle","oval round shape",4);
+    dialog.Add(0,"Draw > Freehand","pen handwriting sketch",3);
+    dialog.Add(0,"Draw > Stop drawing / return to typing","cancel tool text equation",0);
+}
+void CMathomirView::RunFeatureCommand(UINT command,int drawingMode)
+{
+    if (drawingMode>=0)
+    {
+        if (ViewOnlyMode) return;
+        RestoreClipboardBackground();
+        if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+        if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+        IsDrawingMode=drawingMode;
+        SetMousePointer();
+        if (UseToolbar && Toolbox->Toolbar) Toolbox->Toolbar->ConfigureToolbar();
+        RepaintTheView();
+        SetFocus();
+    }
+    else if (command)
+    {
+        if (RotationHandleDocument()) prevTouchedObject=RotationHandleDocument();
+        theApp.m_pMainWnd->SendMessage(WM_COMMAND,MAKEWPARAM(command,0),0);
+    }
+
+    SetFocus();
+}
