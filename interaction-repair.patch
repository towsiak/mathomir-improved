+static CStringW BasicElementHelp(CElement *element)
+{
+    if (!element) return L"";
+    if (element->m_Type==6)
+    {
+        if ((unsigned char)element->Data1[0]==0xC2) return BasicFunctionHelp("Re");
+        if ((unsigned char)element->Data1[0]==0xC1) return BasicFunctionHelp("Im");
+        if ((unsigned char)element->Data1[0]==0xB6) return BasicFunctionHelp("partial derivative");
+        if ((unsigned char)element->Data1[0]==0xD1) return BasicFunctionHelp("nabla");
+        if (element->Data1[0]=='d' && (element->Data2[0]&0xE0)==0x60) return BasicFunctionHelp("Dirac delta");
+        return BasicFunctionHelp(element->Data1);
+    }
+    if (element->m_Type==8) return BasicFunctionHelp("root");
+    if (element->m_Type==5 && element->Expression1 && ((CExpression*)element->Expression1)->m_ParentheseShape=='|') return BasicFunctionHelp("abs");
+    if(element->m_Type==5 && element->Expression1){
+        char shape=((CExpression*)element->Expression1)->m_ParentheseShape;
+        if(shape=='f')return BasicFunctionHelp("floor");
+        if(shape=='c')return BasicFunctionHelp("ceil");
+    }
+    if (element->m_Type==4) return BasicFunctionHelp("fraction");
+    if (element->m_Type==7) return BasicFunctionHelp(element->Data1[0]=='S' ? "sum" : (element->Data1[0]=='P' ? "product" : "integral"));
+    if (element->m_Type==3)
+    {
+        CExpression *base=(CExpression*)element->Expression1,*exponent=(CExpression*)element->Expression2;
+        if (base && exponent && base->m_NumElements==1 && exponent->m_NumElements==1 &&
+            base->m_pElementList->Type==1 && exponent->m_pElementList->Type==1 &&
+            strcmp(base->m_pElementList->pElementObject->Data1,"x")==0)
+        {
+            const char *power=exponent->m_pElementList->pElementObject->Data1;
+            if (strcmp(power,"2")==0) return BasicFunctionHelp("square");
+            if (strcmp(power,"3")==0) return BasicFunctionHelp("cube");
+        }
+        return BasicFunctionHelp("power");
+    }
+    return L"";
+}
+// Resolve hover help through live ownership, without following parent links
+// that may be changing while an annotation is being inserted.
+static bool FindTouchedHelp(CExpression *expression,CObject *target,CStringW &help,int depth=0)
+{
+    if (!expression || !expression->m_pElementList || depth>128) return false;
+    if ((CObject*)expression==target)
+    {
+        if (expression->m_NumElements==1 && expression->m_pElementList)
+            help=BasicElementHelp(expression->m_pElementList->pElementObject);
+        return true;
+    }
+    for (int i=0;i<expression->m_NumElements;i++)
+    {
+        CElement *element=expression->m_pElementList[i].pElementObject;
+        if (!element) continue;
+        if ((CObject*)element==target) { help=BasicElementHelp(element); return true; }
+        CObject *children[]={element->Expression1,element->Expression2,element->Expression3};
+        for (int j=0;j<3;j++)
+            if (children[j] && FindTouchedHelp((CExpression*)children[j],target,help,depth+1))
+            { if (help.IsEmpty()) help=BasicElementHelp(element); return true; }
+    }
+    return false;
+}
+static CStringW HelpForTouchedExpression(CExpression *root,CObject *object)
+{
+    CStringW help;
+    if (object) FindTouchedHelp(root,object,help);
+    return help;
+}
