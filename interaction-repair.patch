diff --git a/Mathomir/PiAxis.h b/Mathomir/PiAxis.h
new file mode 100644
index 0000000..3bd012b
--- /dev/null
+++ b/Mathomir/PiAxis.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cmath>
+#include <cwchar>
+#include <string>
+namespace PiAxis {
+static const double pi=3.14159265358979323846;
+struct Step { long long numerator,denominator; double value() const { return pi*numerator/denominator; } };
+inline Step ChooseStep(double span,int width) {
+    Step result={1,1};
+    double count=width/75.0; if(count<2) count=2; if(count>20) count=20;
+    double desired=span/count;
+    if (!(desired>0) || !std::isfinite(desired)) return result;
+    if(desired>=pi) { while(result.value()<desired && result.numerator<(1LL<<40)) result.numerator*=2; }
+    else { const int denominators[]={2,3,4,6,8,12,16,24,32,48,64,96,128,192,256,384,512,1024,2048,4096};
+        for(unsigned i=0;i<sizeof(denominators)/sizeof(denominators[0]);i++) {
+            if(pi/denominators[i]<desired) break;
+            result.denominator=denominators[i];
+        }
+    }
+    return result;
+}
+inline std::wstring Label(long long tick,Step step) {
+    long long n=tick*step.numerator,d=step.denominator;
+    if(!n) return L"0";
+    bool negative=n<0; if(negative)n=-n;
+    long long a=n,b=d; while(b){long long r=a%b;a=b;b=r;} n/=a;d/=a;
+    wchar_t text[96];
+    std::wstring result=negative ? L"\x2212" : L"";
+    if(n!=1){std::swprintf(text,96,L"%lld",n);result+=text;}
+    result+=L"\x03C0";
+    if(d!=1){std::swprintf(text,96,L"/%lld",d);result+=text;}
+    return result;
+}
+}
