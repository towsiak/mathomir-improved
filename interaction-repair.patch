+void CMathomirView::OnRotateWithMouse()
+{
+    if (ViewOnlyMode) return;
+    tDocumentStruct *object=prevTouchedObject ? prevTouchedObject : RotationHandleDocument();
+    if (!object) object=KeyboardEntryBaseObject ? KeyboardEntryBaseObject : SelectedDocumentObject;
+    if (NumSelectedObjects)
+        for (int i=0;i<NumDocumentElements;i++)
+            if (TheDocument[i].Type==1 && TheDocument[i].MovingDotState==3) { object=TheDocument+i; break; }
+    if (!object || object->Type!=1 || !object->Object || object->MovingDotState==5)
+    { AfxMessageBox("Point at or select a text / equation object, then choose Rotate with mouse."); return; }
+    RestoreClipboardBackground();
+    if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+    if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+    IsDrawingMode=0;
+    RotationHandleObject=object->Object;
+    RepaintTheView();
+    SetFocus();
+}
+
+bool CMathomirView::BeginMouseRotation(CPoint point)
+{
+    tDocumentStruct *object=RotationHandleDocument();
+    if (ViewOnlyMode || IsDrawingMode || !object || object->MovingDotState==5) return false;
+    CPoint handle=RotationHandlePoint(object);
+    int dx=point.x-handle.x,dy=point.y-handle.y;
+    if (dx*dx+dy*dy>121) return false;
+    RestoreClipboardBackground();
+    if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+    if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+    CExpression *expression=(CExpression*)object->Object;
+    MouseRotationStartAngle=expression->m_RotationMilliDegrees;
+    MouseRotationStartVertical=expression->m_IsVertical;
+    MouseRotationStartX=object->absolute_X; MouseRotationStartY=object->absolute_Y;
+    MouseRotationCenterX=object->absolute_X+object->Length/2.0;
+    MouseRotationCenterY=object->absolute_Y+(object->Below-object->Above)/2.0;
+    double x=ViewX+point.x*100.0/ViewZoom,y=ViewY+point.y*100.0/ViewZoom;
+    MouseRotationStartDirection=atan2(y-MouseRotationCenterY,x-MouseRotationCenterX);
+    UndoSave("rotate equation with mouse",20504);
+    MouseRotationActive=true; MouseMode=103;
+    SetCapture(); SetCursor(::LoadCursor(NULL,IDC_CROSS));
+    return true;
+}
+
+void CMathomirView::UpdateMouseRotation(CPoint point,UINT flags)
+{
+    tDocumentStruct *object=RotationHandleDocument();
+    if (!object) { EndMouseRotation(true); return; }
+    double x=ViewX+point.x*100.0/ViewZoom,y=ViewY+point.y*100.0/ViewZoom;
+    double dx=x-MouseRotationCenterX,dy=y-MouseRotationCenterY;
+    if (dx*dx+dy*dy<1) return;
+    double delta=atan2(dy,dx)-MouseRotationStartDirection;
+    double angle=(MouseRotationStartVertical ? -90.0 : MouseRotationStartAngle/1000.0)+delta*180.0/3.14159265358979323846;
+    if (flags&MK_SHIFT) angle=floor(angle/15.0+0.5)*15.0;
+    angle=fmod(angle,360.0);
+    CExpression *expression=(CExpression*)object->Object;
+    expression->m_IsVertical=0;
+    expression->m_RotationMilliDegrees=(int)(angle*1000.0+(angle<0 ? -0.5 : 0.5));
+    short length,above,below; CDC *dc=GetDC();
+    expression->CalculateSize(dc,ViewZoom,&length,&above,&below); ReleaseDC(dc);
+    object->absolute_X=(int)floor(MouseRotationCenterX-length*50.0/ViewZoom+0.5);
+    object->absolute_Y=(int)floor(MouseRotationCenterY-(below-above)*50.0/ViewZoom+0.5);
+    object->Length=length*100/ViewZoom; object->Above=above*100/ViewZoom; object->Below=below*100/ViewZoom;
+    InvalidateRect(NULL,FALSE); UpdateWindow();
+}
+
+void CMathomirView::EndMouseRotation(bool cancel)
+{
+    tDocumentStruct *object=RotationHandleDocument();
+    if (cancel && object)
+    {
+        CExpression *expression=(CExpression*)object->Object;
+        expression->m_RotationMilliDegrees=MouseRotationStartAngle;
+        expression->m_IsVertical=MouseRotationStartVertical;
+        object->absolute_X=MouseRotationStartX; object->absolute_Y=MouseRotationStartY;
+    }
+    MouseRotationActive=false; MouseMode=0;
+    if (GetCapture()==this) ReleaseCapture();
+    RepaintTheView(1); SetCursor(::LoadCursor(NULL,IDC_ARROW));
+}
