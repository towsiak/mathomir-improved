+void CMathomirView::OnFitFontSize(UINT command)
+{
+    if (ViewOnlyMode) return;
+    tDocumentStruct *target=KeyboardEntryBaseObject ? KeyboardEntryBaseObject : (prevTouchedObject ? prevTouchedObject : RotationHandleDocument());
+    bool changed=false; CClientDC dc(this);
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (object->Type!=1 || !object->Object || object->MovingDotState==5) continue;
+        if (NumSelectedObjects ? object->MovingDotState!=3 : object!=target) continue;
+        CExpression *expression=(CExpression*)object->Object;
+        short length,above,below; expression->CalculateSize(&dc,ViewZoom,&length,&above,&below);
+        if (length<=0) continue;
+        int width=PaperWidth-max(0,object->absolute_X-15)-30;
+        if (command==ID_FONT_FIT_WINDOW) width=min(width,ViewX+TheClientRect.right*100/ViewZoom-object->absolute_X-30);
+        if (width<=0) continue;
+        int size=max(40,min(800,(int)floor(expression->m_FontSize*(width*ViewZoom/100.0)/length)));
+        if (size==expression->m_FontSize) continue;
+        if (!changed) UndoSave("smart font size",20505);
+        ResizeObjectFonts(object->Object,1,size); changed=true;
+    }
+    if (!changed && !target && !NumSelectedObjects) AfxMessageBox("Point at or select an equation, then choose a smart font size.");
+    if (changed) { GetDocument()->SetModifiedFlag(); RepaintTheView(1); }
+}
