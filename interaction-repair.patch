+void CMathomirView::OnInsertTable()
+{
+    if(ViewOnlyMode)return;
+    OnChar(27,1,0);
+    CTableSetupDialog dialog;
+    if(dialog.DoModal()!=IDOK)return;
+    CExpression *table=new CExpression(NULL,NULL,dialog.font);
+    table->InsertEmptyElement(0,5,(char)0x80);
+    CExpression *cells=(CExpression*)table->m_pElementList->pElementObject->Expression1;
+    cells->m_ParenthesesFlags=0; cells->m_ParentheseShape=' ';
+    if(cells->FindMatrixElement(dialog.rows-1,dialog.columns-1,1)<0){delete table;AfxMessageBox("Cannot create this table.");return;}
+    char align=dialog.alignment==0?'l':(dialog.alignment==1?'c':'r');
+    for(int row=0;row<dialog.rows;row++)for(int col=0;col<dialog.columns;col++)
+    {
+        char top=' ',bottom=' ',left=' ',right=' ';
+        if(dialog.borders==0)top=bottom=left=right='-';
+        if(dialog.borders==1){if(row==0)top='-';if(row==dialog.rows-1)bottom='-';if(col==0)left='-';if(col==dialog.columns-1)right='-';}
+        if(dialog.borders==2 && row==0)bottom='-';
+        cells->SetCellAttributes(row,col,align,top,bottom,left,right);
+    }
+    RestoreClipboardBackground();
+    if(ClipboardExpression){delete ClipboardExpression;ClipboardExpression=NULL;}
+    if(ClipboardDrawing){delete ClipboardDrawing;ClipboardDrawing=NULL;}
+    CDC *dc=GetDC();short length,above,below;table->CalculateSize(dc,ViewZoom,&length,&above,&below);ReleaseDC(dc);
+    ClipboardExpression=table;RootObjectCopy=-1;RootObjectFontSize=dialog.font; // configured font must survive preview layout changes
+    IsDrawingMode=0;MouseMode=0;
+    SetFocus();RepaintTheView();SetCursor(theApp.LoadCursor(IDC_POINTER_COPY));
+}
+
+void CMathomirView::OnDrawingTool(UINT command)
+{
+    if(ViewOnlyMode)return;
+    OnChar(27,1,0);
+    static const int modes[]={3,2,1,4};
+    if(command<ID_DRAW_PEN || command>ID_DRAW_ELLIPSE)return;
+    if(ClipboardExpression){delete ClipboardExpression;ClipboardExpression=NULL;}
+    if(ClipboardDrawing){delete ClipboardDrawing;ClipboardDrawing=NULL;}
+    IsDrawingMode=modes[command-ID_DRAW_PEN];MouseMode=0;
+    SetFocus();SetMousePointer();RepaintTheView();
+}
+
+void CMathomirView::ApplyPageWidthFit()
+{
+    if(!AutoFitPageWidth || ViewOnlyMode || PaperWidth<=0 || !GetSafeHwnd() || MouseSizingActive || MouseRotationActive)return;
+    CRect area;GetClientRect(&area);
+    if(area.Width()<50 || area.Height()<10)return;
+    // CView's client rectangle already excludes both native scrollbars.
+    // Round down: the last document coordinate must stay inside the viewport.
+    int zoom=max(1,min(32000,area.Width()*100/PaperWidth));
+    if (ViewZoom!=zoom || ViewX!=15)
+    {
+        RestoreClipboardBackground();
+        ViewZoom=(short)zoom;ViewX=15;
+    }
+    // Keep the bottom bar visible but give it no horizontal travel in fit mode.
+    SCROLLINFO info={sizeof(SCROLLINFO)};
+    info.fMask=SIF_RANGE|SIF_PAGE|SIF_POS|SIF_DISABLENOSCROLL;
+    info.nMin=0;info.nMax=0;info.nPage=1;info.nPos=0;
+    SetScrollInfo(SB_HORZ,&info,TRUE);
+}
+void CMathomirView::OnFitPageWidth()
+{
+    AutoFitPageWidth=true;
+    ApplyPageWidthFit();RepaintTheView(1);SetFocus();
+}
+
+void CMathomirView::OnSelectAllObjects()
+{
+    if(ViewOnlyMode)return;
+    SendMessage(WM_CHAR,VK_ESCAPE,0);
+    NumSelectedObjects=0;
+    for(int i=0;i<NumDocumentElements;i++)
+        if(TheDocument[i].Object && (TheDocument[i].Type==1 || TheDocument[i].Type==2))
+        {TheDocument[i].MovingDotState=3;NumSelectedObjects++;}
+    MouseMode=0;SetFocus();RepaintTheView();
+}
