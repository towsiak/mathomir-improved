+void CMathomirView::OnGraphZoom(UINT command)
+{
+    if(ViewOnlyMode)return;
+    tDocumentStruct *focus=prevTouchedObject;
+    bool focused=focus && focus>=TheDocument && focus<TheDocument+NumDocumentElements && focus->Type==2 && focus->Object && ((CDrawing*)focus->Object)->IsSpecialDrawing==51;
+    bool changed=false;
+    for(int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if(object->Type!=2 || !object->Object || object->MovingDotState==5)continue;
+        CDrawing *drawing=(CDrawing*)object->Object;
+        if(drawing->IsSpecialDrawing!=51 || !drawing->SpecialData || drawing->NumItems<8)continue;
+        if(NumSelectedObjects && object->MovingDotState!=3)continue;
+        if(!NumSelectedObjects && focused && object!=focus)continue;
+        if(!changed)UndoSave("graph smart zoom");
+        CFunctionPlotter *p=(CFunctionPlotter*)drawing->SpecialData;
+        p->is_x_pi=((CExpression*)(drawing->Items+4)->pSubdrawing)->m_Alignment==2;
+        p->is_x_log=((CExpression*)(drawing->Items+4)->pSubdrawing)->m_Alignment==1;
+        p->is_y_log=((CExpression*)(drawing->Items+6)->pSubdrawing)->m_Alignment==1;
+        bool ok=(command==ID_GRAPH_SMART_FIT || command==ID_GRAPH_RESET_VIEW)?p->SmartFit(command==ID_GRAPH_RESET_VIEW):p->StepZoom(command==ID_GRAPH_ZOOM_IN?0.8:1.25);
+        changed=ok||changed;
+    }
+    if(changed){GetDocument()->SetModifiedFlag();RepaintTheView(1);}
+    else AfxMessageBox("Point at or select a function graph, then search for Smart fit or Reset view.");
+}
