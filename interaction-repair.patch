+class CTableSetupDialog : public CDialog
+{
+public:
+    int rows,columns,font,borders,alignment;
+    CTableSetupDialog():CDialog(IDD_TABLE_SETUP,theApp.m_pMainWnd),rows(4),columns(3),font(100),borders(0),alignment(0){}
+    virtual BOOL OnInitDialog()
