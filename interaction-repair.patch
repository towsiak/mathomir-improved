+int CFunctionPlotter::XML_output(char * output,int num_tabs,char only_calculate)
+{
+    std::string text;
+    for(size_t i=0;i<pieces.size();i++){
+        const Piecewise::Row &r=pieces[i];
+        text+="<piece f=\""+Piecewise::Hex(r.formula)+"\" lo=\""+Piecewise::Number(r.low)+"\" hi=\""+Piecewise::Number(r.high)+"\" lc=\""+(r.leftClosed?"1":"0")+"\" hc=\""+(r.rightClosed?"1":"0")+"\" rad=\""+(pieceRadians?"1":"0")+"\" />\r\n";
+    }
+    if(!only_calculate)memcpy(output,text.c_str(),text.size());return (int)text.size();
+}
+char *CFunctionPlotter::XML_input(char *file)
+{
+    if(strncmp(file,"piece ",6)!=0)return file;
+    Piecewise::Row row;bool proposedRadians=pieceRadians;char attribute[64],value[384];file+=5;
+    do {
+        file=((CMainFrame*)theApp.m_pMainWnd)->XML_read_attribute(attribute,value,file,384);if(!file)return NULL;
+        if(strcmp(attribute,"f")==0)row.formula=Piecewise::Unhex(value);
+        if(strcmp(attribute,"lo")==0)row.low=Piecewise::StoredBound(value);
+        if(strcmp(attribute,"hi")==0)row.high=Piecewise::StoredBound(value);
+        if(strcmp(attribute,"lc")==0)row.leftClosed=atoi(value)!=0;
+        if(strcmp(attribute,"hc")==0)row.rightClosed=atoi(value)!=0;
+        if(strcmp(attribute,"rad")==0)proposedRadians=atoi(value)!=0;
+    }while(attribute[0]);
+    std::vector<Piecewise::Row> proposed=pieces;proposed.push_back(row);std::string error;
+    if(Piecewise::Validate(proposed,proposedRadians,error)){
+        pieces=proposed;pieceRadians=proposedRadians;
+        // Earlier editor builds saved valid pieces with empty native formula
+        // slots. Rebuild those slots from the authoritative piece definitions.
+        EnsureFunctionSlots();
+        for(size_t i=0;i<pieces.size() && i+8<(size_t)Base->NumItems;i++){
+            CExpression *expression=(CExpression*)Base->Items[8+i].pSubdrawing;
+            if(!expression)continue;
+            expression->Delete();
+            std::string xml="<ex fh=\"100\">"+pieces[i].program.Xml()+"</ex>";
+            std::vector<char> buffer(xml.begin(),xml.end());buffer.push_back(0);
+            expression->XML_input(&buffer[0]);
+        }
+    }
+    return file;
+}
 
 //this function plots the mathematical function
 //first four items are the frame
 //inputs: reset_plot-(0-plot the funciton, 1 - prepare no Y ranging, 2-prepare with Y ranging);  PrintDC - when printing the device context, or NULL
+struct GraphDomainPoint {double x,y;bool hole;bool closed;GraphDomainPoint():x(0),y(0),hole(false),closed(false){}};
+static void CollectGraphDivisors(CExpression *expression,std::vector<CExpression*>& divisors,int depth=0)
+{
+    if(!expression || depth>32 || divisors.size()>=24)return;
+    for(int i=0;i<expression->m_NumElements;i++)
+    {
+        tElementStruct *item=expression->m_pElementList+i;
+        CElement *element=item->pElementObject;
+        if(!element || !item->Type || item->Type==11 || item->Type==12)continue;
+        CExpression *denominator=NULL;
+        if(item->Type==4)denominator=(CExpression*)element->Expression2;
+        if(item->Type==3 && element->Expression1 && element->Expression2)
+        {
+            CExpression *power=(CExpression*)element->Expression2;double exponent;int precision;
+            if(power->IsPureNumber(0,power->m_NumElements,&exponent,&precision) && exponent<0)
+                denominator=(CExpression*)element->Expression1;
+        }
+        if(denominator && divisors.size()<24)
+        {
+            CExpression *copy=new CExpression(NULL,NULL,100);copy->CopyExpression(denominator,0);divisors.push_back(copy);
+        }
+        if(item->Type==2)
+        {
+            unsigned char op=(unsigned char)element->Data1[0];
+            if((op=='/' || op==0xF7) && i+1<expression->m_NumElements && divisors.size()<24)
+            {
+                CExpression *copy=new CExpression(NULL,NULL,100);
+                copy->InsertElement(expression->m_pElementList+i+1,0);divisors.push_back(copy);
+            }
+            continue;
+        }
+        if(item->Type!=1)
+        {
+            CollectGraphDivisors((CExpression*)element->Expression1,divisors,depth+1);
+            CollectGraphDivisors((CExpression*)element->Expression2,divisors,depth+1);
+            CollectGraphDivisors((CExpression*)element->Expression3,divisors,depth+1);
+        }
+    }
+}
+static void AnalyzeGraphDomain(CExpression *function,void *variables,const std::vector<CExpression*>& divisors,
+    double low,double high,bool radians,std::vector<GraphDomainPoint>& points,unsigned char *abort)
+{
+    std::vector<double> roots;
+    for(size_t i=0;i<divisors.size() && !*abort;i++)
+    {
+        void *positions=divisors[i]->PlotterPrepareVariablePositions();
+        if(!positions)continue;
+        GraphDiscontinuities::Roots([&](double x){return *abort ? sqrt(-1.0) : divisors[i]->PlotterCalculateFunctionValue(x,positions,radians);},low,high,roots);
+        divisors[i]->PlotterReleaseVariablePositions(positions);
+    }
+    for(size_t i=0;i<roots.size() && !*abort;i++)
+    {
+        GraphDomainPoint point;point.x=roots[i];point.y=0;
+        point.hole=GraphDiscontinuities::HoleLimit([&](double x){return function->PlotterCalculateFunctionValue(x,variables,radians);},point.x,high-low,point.y);
+        GraphDiagnostic(point.hole?"hole x,y,low,high":"excluded x,y,low,high",point.x,point.y,low,high);
+        points.push_back(point);
+    }
+}
+
+// Graphs can be nested in drawing groups (including earlier piecewise graphs).
+static bool FindGraphOffset(CDrawing *drawing,CDrawing *graph,int &x,int &y,int depth=0)
+{
+    if(!drawing || depth>32)return false;
+    if(drawing==graph){x=y=0;return true;}
+    for(int i=0;i<drawing->NumItems;i++){
+        tDrawingItem *item=drawing->Items+i;int dx,dy;
+        if(item->Type==0 && item->pSubdrawing && FindGraphOffset((CDrawing*)item->pSubdrawing,graph,dx,dy,depth+1)){
+            x=item->X1/DRWZOOM+dx;y=item->Y1/DRWZOOM+dy;return true;
+        }
+    }
+    return false;
+}
+
+// Recognize x = constant before the ordinary y=f(x) evaluator strips its left side.
+static bool GraphXEquation(CExpression *expression)
+{
+    if(expression->m_NumElements<3)return false;
+    tElementStruct *e=expression->m_pElementList;
+    return e[0].Type==1 && e[0].pElementObject && strcmp(e[0].pElementObject->Data1,"x")==0 &&
+        (e[0].pElementObject->Data2[0]&0xE0)!=0x60 && e[1].Type==2 && e[1].pElementObject && e[1].pElementObject->Data1[0]=='=';
+}
+static bool GraphVerticalValue(CExpression *expression,bool radians,double &value)
+{
+    CExpression rhs(NULL,NULL,100);rhs.CopyExpression(expression,0);rhs.DeleteElement(0);rhs.DeleteElement(0);
+    CExpression *variable=NULL;int position=0;
+    if(!rhs.IsSuitableForComputation() || rhs.PlotterGetEquationInfo(&variable,&position,NULL,NULL))return false;
+    void *variables=rhs.PlotterPrepareVariablePositions();if(!variables)return false;
+    value=rhs.PlotterCalculateFunctionValue(0,variables,radians);rhs.PlotterReleaseVariablePositions(variables);
