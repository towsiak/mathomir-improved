+void CMathomirView::OnRotateEquation()
+{
+    if (ViewOnlyMode) return;
+    tDocumentStruct *active=prevTouchedObject ? prevTouchedObject :
+        (KeyboardEntryBaseObject ? KeyboardEntryBaseObject : SelectedDocumentObject);
+    CExpression *first=NULL;
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (object->Object && object->Type==1 && object->MovingDotState!=5 &&
+            (object->MovingDotState==3 || (NumSelectedObjects==0 && object==active)))
+        { first=(CExpression*)object->Object; break; }
+    }
+    if (!first)
+    { AfxMessageBox("Select a text or equation object, or click inside it to edit, then choose Rotate."); return; }
+    CEquationRotationDialog dialog(first->m_RotationMilliDegrees/1000.0);
+    INT_PTR result=dialog.DoModal();
+    if (result==IDC_ROTATION_MOUSE) { OnRotateWithMouse(); return; }
+    if (result!=IDOK) return;
+    int angle=(int)(dialog.angle*1000.0+(dialog.angle<0 ? -0.5 : 0.5));
+    angle%=360000;
+    RestoreClipboardBackground();
+    if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+    if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+    UndoSave("rotate equation",20503);
+    CDC *dc=GetDC();
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (!object->Object || object->Type!=1 || object->MovingDotState==5 ||
+            !(object->MovingDotState==3 || (NumSelectedObjects==0 && object==active))) continue;
+        CExpression *expression=(CExpression*)object->Object;
+        short length,above,below;
+        expression->CalculateSize(dc,ViewZoom,&length,&above,&below);
+        int centerX=object->absolute_X+length*50/ViewZoom;
+        int centerY=object->absolute_Y+(below-above)*50/ViewZoom;
+        expression->m_IsVertical=0;
+        expression->m_RotationMilliDegrees=angle;
+        expression->CalculateSize(dc,ViewZoom,&length,&above,&below);
+        object->absolute_X=centerX-length*50/ViewZoom;
+        object->absolute_Y=centerY-(below-above)*50/ViewZoom;
+    }
+    ReleaseDC(dc);
+    RepaintTheView(1);
+}
+
+void CMathomirView::OnQuickFontSize(UINT command)
+{
+    if (ViewOnlyMode) return;
+    int size=100;
+    if (command==ID_FONT_SIZE_200) size=200;
+    if (command==ID_FONT_SIZE_400) size=400;
+    if (command==ID_FONT_SIZE_800) size=800;
+    UndoSave("font size",20501);
+    bool changed=false;
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (object->MovingDotState==3 || (NumSelectedObjects==0 &&
+            (object==(prevTouchedObject ? prevTouchedObject :
+                (KeyboardEntryBaseObject ? KeyboardEntryBaseObject : SelectedDocumentObject)))))
+        {
+            ResizeObjectFonts(object->Object,object->Type,size);
+            changed=true;
+        }
+    }
+    if (!changed) DefaultFontSize=size;
+    RepaintTheView(1);
+    if (KeyboardEntryObject) SendKeyStroke(-1,0,0);
+    ((CMainFrame*)theApp.m_pMainWnd)->AdjustMenu();
+}
+
+void CMathomirView::OnFontAllObjects()
+{
+    if (ViewOnlyMode) return;
+    CDC *dc=GetDC();
+    LOGFONT font;
+    ((CMainFrame*)theApp.m_pMainWnd)->GetLogicalFont(0,&font,dc);
+    font.lfHeight=-MulDiv(15,dc->GetDeviceCaps(LOGPIXELSY),72);
+    CHOOSEFONT choice;
+    ZeroMemory(&choice,sizeof(choice));
+    choice.lStructSize=sizeof(choice);
+    choice.hwndOwner=theApp.m_pMainWnd->m_hWnd;
+    choice.lpLogFont=&font;
+    choice.Flags=CF_SCREENFONTS|CF_INITTOLOGFONTSTRUCT|CF_SCALABLEONLY|CF_LIMITSIZE|CF_NOSTYLESEL;
+    choice.nSizeMin=6;
+    choice.nSizeMax=120;
+    if (ChooseFont(&choice))
+    {
+        UndoSave("font for all objects",20502);
+        int size=max(40,min(800,MulDiv(choice.iPointSize,100,150)));
+        // The application stores named font slots globally. Keep Symbol intact.
+        // Keep their original size calibration; size is stored in each equation.
+        for (int slot=0;slot<3;slot++)
+        {
+            LOGFONT original;
+            ((CMainFrame*)theApp.m_pMainWnd)->GetLogicalFont(slot,&original,dc);
+            lstrcpyn(original.lfFaceName,font.lfFaceName,LF_FACESIZE);
+            original.lfCharSet=font.lfCharSet;
+            ((CMainFrame*)theApp.m_pMainWnd)->SetLogicalFont(slot,&original,dc);
+        }
+        for (int i=0;i<NumDocumentElements;i++)
+            ResizeObjectFonts(TheDocument[i].Object,TheDocument[i].Type,size);
+        DefaultFontSize=size;
+        RepaintTheView(1);
+        if (KeyboardEntryObject) SendKeyStroke(-1,0,0);
+        Toolbox->InvalidateRect(NULL,1);
+        ((CMainFrame*)theApp.m_pMainWnd)->AdjustMenu();
+    }
+    ReleaseDC(dc);
+}
