diff --git a/Mathomir/ScalarFunctions.h b/Mathomir/ScalarFunctions.h
new file mode 100644
index 0000000..f6c90d6
--- /dev/null
+++ b/Mathomir/ScalarFunctions.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+// One definition for native calculations and the piecewise evaluator.
+namespace ScalarFunctions {
+inline const char *Name(int code) {
+    static const char *names[]={"floor","ceil","abs","round","trunc","sgn","fract","cbrt","exp","sinc"};
+    return code>=41 && code<=50 ? names[code-41] : "";
+}
+inline bool Known(const char *name) {
+    for(int code=41;code<=50;code++)if(std::strcmp(name,Name(code))==0)return true;
+    return false;
+}
+inline bool Steps(const char *name) {
+    return std::strcmp(name,"floor")==0 || std::strcmp(name,"ceil")==0 ||
+        std::strcmp(name,"round")==0 || std::strcmp(name,"trunc")==0 ||
+        std::strcmp(name,"sgn")==0 || std::strcmp(name,"fract")==0;
+}
+inline const char *Description(const char *name) {
+    if(std::strcmp(name,"floor")==0)return "Floor: greatest integer less than or equal to x. floor(-1.2) = -2.";
+    if(std::strcmp(name,"ceil")==0)return "Ceiling: least integer greater than or equal to x. ceil(-1.2) = -1.";
+    if(std::strcmp(name,"abs")==0)return "Absolute value: distance from zero. abs(-3) = 3.";
+    if(std::strcmp(name,"round")==0)return "Round to nearest integer; halfway values go away from zero. round(-1.5) = -2.";
+    if(std::strcmp(name,"trunc")==0)return "Truncate toward zero. trunc(-1.8) = -1.";
+    if(std::strcmp(name,"sgn")==0)return "Sign: -1 for negative x, 0 at zero, +1 for positive x.";
+    if(std::strcmp(name,"fract")==0)return "Fractional part: x - floor(x), in [0, 1). fract(-1.2) = 0.8. Use frac for a fraction template.";
+    if(std::strcmp(name,"cbrt")==0)return "Real cube root, including negative inputs. cbrt(-8) = -2.";
+    if(std::strcmp(name,"exp")==0)return "Exponential: exp(x) = e raised to x. exp(0) = 1.";
+    if(std::strcmp(name,"sinc")==0)return "Unnormalized sinc: sin(x)/x in radians; sinc(0) = 1. Independent of the angle setting.";
+    return "";
+}
+inline double Value(const char *name,double x) {
+    if(!std::isfinite(x))return std::numeric_limits<double>::quiet_NaN();
+    if(std::strcmp(name,"floor")==0)return std::floor(x);
+    if(std::strcmp(name,"ceil")==0)return std::ceil(x);
+    if(std::strcmp(name,"abs")==0)return std::fabs(x);
+    if(std::strcmp(name,"round")==0)return std::round(x);
+    if(std::strcmp(name,"trunc")==0)return std::trunc(x);
+    if(std::strcmp(name,"sgn")==0)return x>0?1:(x<0?-1:0);
+    if(std::strcmp(name,"fract")==0)return x-std::floor(x);
+    if(std::strcmp(name,"cbrt")==0)return std::cbrt(x);
+    if(std::strcmp(name,"exp")==0)return std::exp(x);
+    if(std::strcmp(name,"sinc")==0){if(std::fabs(x)<1e-4){double t=x*x;return 1-t/6+t*t/120;}return std::sin(x)/x;}
+    return std::numeric_limits<double>::quiet_NaN();
+}
+}
diff --git a/Mathomir/SmartShader.h b/Mathomir/SmartShader.h
new file mode 100644
index 0000000..e7d2db1
--- /dev/null
+++ b/Mathomir/SmartShader.h
@@ -0,0 +1,82 @@
+#pragma once
+#include <vector>
+#include <cmath>
+#include <algorithm>
+namespace SmartShader {
+struct Point {double x,y;Point(double a=0,double b=0):x(a),y(b){}};
+struct Edge {Point a,b;Edge(Point p,Point q):a(p),b(q){}};
+inline Point Sub(Point a,Point b){return Point(a.x-b.x,a.y-b.y);}
+inline double Cross(Point a,Point b){return a.x*b.y-a.y*b.x;}
+inline bool Near(Point a,Point b){return std::fabs(a.x-b.x)<=1 && std::fabs(a.y-b.y)<=1;}
+typedef std::vector<Point> Path;
+struct Shape {
+    std::vector<Path> paths;double area;
+    Shape():area(0){}
+    void Build(const std::vector<Edge>& edges){
+        paths.clear();std::vector<bool> used(edges.size(),false);
+        for(size_t start=0;start<edges.size();start++)if(!used[start]){
+            Path p;p.push_back(edges[start].a);p.push_back(edges[start].b);used[start]=true;
+            for(size_t step=0;step<edges.size() && !Near(p.back(),p.front());step++){
+                bool found=false;for(size_t j=0;j<edges.size();j++)if(!used[j]){
+                    if(Near(edges[j].a,p.back())){p.push_back(edges[j].b);used[j]=true;found=true;break;}
+                    if(Near(edges[j].b,p.back())){p.push_back(edges[j].a);used[j]=true;found=true;break;}
+                }if(!found)break;
+            }
+            if(p.size()>=4 && Near(p.back(),p.front())){p.back()=p.front();paths.push_back(p);}
+        }
+        area=0;for(size_t n=0;n<paths.size();n++){double a=0;for(size_t i=1;i<paths[n].size();i++)a+=Cross(paths[n][i-1],paths[n][i]);area+=std::fabs(a)/2;}
+    }
+    bool Contains(Point p)const {
+        bool inside=false;
+        for(size_t n=0;n<paths.size();n++)for(size_t i=1;i<paths[n].size();i++){
+            Point a=paths[n][i-1],b=paths[n][i];
+            Point v=Sub(b,a),q=Sub(p,a);double length=std::sqrt(v.x*v.x+v.y*v.y);
+            if(length>0 && std::fabs(Cross(q,v))/length<.5 && q.x*v.x+q.y*v.y>=0 && q.x*v.x+q.y*v.y<=length*length)return false;
+            if((a.y>p.y)!=(b.y>p.y))if(p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x)inside=!inside;
+        }return inside;
+    }
+};
+inline bool Clip(const std::vector<Shape>& scene,Point seed,int direction,double reach,double inset,double &negative,double &positive){
+    int target=-1;double area=0;
+    for(size_t i=0;i<scene.size();i++)if(scene[i].Contains(seed) && (target<0 || scene[i].area<area)){target=(int)i;area=scene[i].area;}
+    if(target<0)return false;
+    negative=positive=reach;Point d(1,direction);
+    // Every closed outline is a boundary: trim even at nested or overlapping drawings.
+    for(size_t shape=0;shape<scene.size();shape++)for(size_t n=0;n<scene[shape].paths.size();n++){
+        const Path &p=scene[shape].paths[n];
+        for(size_t i=1;i<p.size();i++){
+            Point s=Sub(p[i],p[i-1]),q=Sub(p[i-1],seed);double den=Cross(d,s);
+            if(std::fabs(den)<1e-12)continue;double t=Cross(q,s)/den,u=Cross(q,d)/den;
+            if(u<-1e-9 || u>1+1e-9)continue;
+            if(t>=0)positive=(std::min)(positive,t);else negative=(std::min)(negative,-t);
+        }
+    }
+    negative=(std::max)(0.,negative-inset);positive=(std::max)(0.,positive-inset);
+    return negative+positive>2*inset;
+}
+}
+namespace SmartShader {
+struct LineGuide {
+    int selected,side;
+    LineGuide():selected(-1),side(0){}
+    bool Clip(const std::vector<Edge>& lines,Point seed,int direction,double reach,double inset,double &negative,double &positive){
+        if(selected<0){
+            double nearest=reach*1.4142135623730951;
+            for(size_t i=0;i<lines.size();i++){
+                Point v=Sub(lines[i].b,lines[i].a),q=Sub(seed,lines[i].a);double length=std::sqrt(v.x*v.x+v.y*v.y);
+                if(length<1280)continue;double projection=(q.x*v.x+q.y*v.y)/(length*length);if(projection<0 || projection>1)continue;
+                double distance=std::fabs(Cross(v,q))/length;
+                if(distance<nearest && distance>inset){nearest=distance;selected=(int)i;}
+            }
+            if(selected<0)return false;
+            double signedSide=Cross(Sub(lines[selected].b,lines[selected].a),Sub(seed,lines[selected].a));side=signedSide>0?1:-1;
+        }
+        const Edge &e=lines[selected];Point v=Sub(e.b,e.a),q=Sub(seed,e.a),d(1,direction);
+        double start=Cross(v,q)*side,slope=Cross(v,d)*side;
+        if(start<=0)return false;
+        negative=positive=reach;
+        if(std::fabs(slope)>1e-12){double boundary=-start/slope;if(boundary<0)negative=(std::min)(negative,-boundary);else positive=(std::min)(positive,boundary);}
+        negative=(std::max)(0.,negative-inset);positive=(std::max)(0.,positive-inset);return negative+positive>2*inset;
+    }
+};
+}
diff --git a/Mathomir/SmartStroke.h b/Mathomir/SmartStroke.h
new file mode 100644
index 0000000..bebbe21
--- /dev/null
+++ b/Mathomir/SmartStroke.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <vector>
+#include <cmath>
+#include <algorithm>
+#include <utility>
+
+namespace SmartStroke {
+struct Point {double x,y;Point(double a=0,double b=0):x(a),y(b){}};
+inline double Distance(Point a,Point b){return std::sqrt((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y));}
+inline Point Mix(Point a,Point b,double t){return Point(a.x+(b.x-a.x)*t,a.y+(b.y-a.y)*t);}
+inline double SegmentDistance(Point p,Point a,Point b){double dx=b.x-a.x,dy=b.y-a.y,l=dx*dx+dy*dy;if(l==0)return Distance(p,a);double t=((p.x-a.x)*dx+(p.y-a.y)*dy)/l;t=t<0?0:t>1?1:t;return Distance(p,Mix(a,b,t));}
+inline std::vector<Point> Reduce(const std::vector<Point> &p,double tolerance){
+    if(p.size()<3)return p;std::vector<char> keep(p.size(),0);keep[0]=keep[p.size()-1]=1;
+    std::vector<std::pair<size_t,size_t> > work;work.push_back(std::make_pair(0,p.size()-1));
+    while(!work.empty()){size_t a=work.back().first,b=work.back().second;work.pop_back();double greatest=tolerance;size_t index=a;
+        for(size_t i=a+1;i<b;i++){double d=SegmentDistance(p[i],p[a],p[b]);if(d>greatest){greatest=d;index=i;}}
+        if(index!=a){keep[index]=1;work.push_back(std::make_pair(a,index));work.push_back(std::make_pair(index,b));}
+    }
+    std::vector<Point> out;for(size_t i=0;i<p.size();i++)if(keep[i])out.push_back(p[i]);return out;
+}
+// Work in screen pixels. Arc-length sampling avoids depending on mouse-event
+// frequency. Hard turns split the filter, while each move has a strict bound.
+inline std::vector<Point> Smooth(const std::vector<Point> &input,int strength){
+    if(strength<=0||input.size()<3||input.size()>12000)return input;
+    std::vector<Point> p;for(size_t i=0;i<input.size();i++)if(p.empty()||Distance(p.back(),input[i])>.001)p.push_back(input[i]);
+    if(p.size()<3)return input;std::vector<double> arc(p.size(),0);for(size_t i=1;i<p.size();i++)arc[i]=arc[i-1]+Distance(p[i-1],p[i]);
+    if(arc.back()<4||arc.back()>20000)return input;
+    std::vector<double> turn(p.size(),1);const double look=8;
+    for(size_t i=1;i+1<p.size();i++){size_t l=i-1,r=i+1;while(l>0&&arc[i]-arc[l]<look)l--;while(r+1<p.size()&&arc[r]-arc[i]<look)r++;
+        double ax=p[i].x-p[l].x,ay=p[i].y-p[l].y,bx=p[r].x-p[i].x,by=p[r].y-p[i].y;
+        double lengths=std::sqrt((ax*ax+ay*ay)*(bx*bx+by*by));if(lengths>1)turn[i]=(ax*bx+ay*by)/lengths;
+    }
+    std::vector<size_t> pins;pins.push_back(0);
+    for(size_t i=1;i+1<p.size();i++)if(turn[i]<.35){bool peak=true;for(size_t j=i;j>0&&arc[i]-arc[j-1]<5;j--)if(turn[j-1]<turn[i])peak=false;for(size_t j=i+1;j<p.size()&&arc[j]-arc[i]<5;j++)if(turn[j]<=turn[i])peak=false;if(peak)pins.push_back(i);}
+    pins.push_back(p.size()-1);std::vector<Point> output;
+    double bound=strength==1?.8:strength==2?1.6:2.5;int radius=strength==1?2:strength==2?3:4;
+    for(size_t part=1;part<pins.size();part++){
+        size_t first=pins[part-1],last=pins[part];double length=arc[last]-arc[first];int count=(int)std::ceil(length/1.5);if(count<1)count=1;
+        if(count>6000)return input;std::vector<Point> anchor;size_t cursor=first;
+        for(int n=0;n<=count;n++){double target=arc[first]+length*n/count;while(cursor+1<last&&arc[cursor+1]<target)cursor++;double segment=arc[cursor+1]-arc[cursor];anchor.push_back(Mix(p[cursor],p[cursor+1],segment>0?(target-arc[cursor])/segment:0));}
+        anchor.front()=p[first];anchor.back()=p[last];std::vector<Point> current=anchor;
+        for(int pass=0;pass<3;pass++){std::vector<Point> next=current;
+            for(size_t i=1;i+1<current.size();i++){Point average;double weight=0;
+                for(int offset=-radius;offset<=radius;offset++){int at=(int)i+offset;if(at<0||at>=(int)current.size())continue;double w=radius+1-std::abs(offset);average.x+=current[at].x*w;average.y+=current[at].y*w;weight+=w;}
+                average.x/=weight;average.y/=weight;double d=Distance(average,anchor[i]);if(d>bound)average=Mix(anchor[i],average,bound/d);next[i]=average;
+            }current.swap(next);
+        }
+        current=Reduce(current,.12);if(!output.empty())current.erase(current.begin());output.insert(output.end(),current.begin(),current.end());
+        if(output.size()>12000)return input;
+    }
+    output.front()=input.front();output.back()=input.back();return output;
+}
+}
diff --git a/Mathomir/SymbolicDerivative.h b/Mathomir/SymbolicDerivative.h
new file mode 100644
index 0000000..1cc31a5
--- /dev/null
+++ b/Mathomir/SymbolicDerivative.h
@@ -0,0 +1,171 @@
+#pragma once
+#include <string>
+#include <vector>
+#include <set>
+#include <memory>
+#include <cmath>
+#include <cstdlib>
+#include <cstdio>
+#include <cctype>
+#include <limits>
+#include <stdexcept>
+
+// A bounded, real-valued expression tree. Symbolic work is independent of the
+// numeric graph sampler and never estimates a derivative by finite differences.
+namespace SymbolicDerivative {
+struct Node;
+typedef std::shared_ptr<Node> Expr;
+struct Node { char op; double number; std::string name; Expr a,b;
+    Node(char o,double n=0,Expr l=Expr(),Expr r=Expr()):op(o),number(n),a(l),b(r){} };
+inline bool Finite(double n){return n==n && std::fabs(n)<std::numeric_limits<double>::infinity();}
+inline double NaN(){return std::numeric_limits<double>::quiet_NaN();}
+inline std::string Number(double n){char b[64];std::sprintf(b,"%.15g",n);return b;}
+inline Expr N(double n){return Expr(new Node('n',n));}
+inline Expr Name(const std::string &s){Expr n(new Node('v'));n->name=s;return n;}
+inline Expr F(const std::string &s,Expr a){Expr n(new Node('f',0,a));n->name=s;return n;}
+inline bool Is(Expr n,double x){return n && n->op=='n' && n->number==x;}
+inline bool Same(Expr a,Expr b){if(a==b)return true;if(!a||!b||a->op!=b->op||a->number!=b->number||a->name!=b->name)return false;return Same(a->a,b->a)&&Same(a->b,b->b);}
+inline Expr Make(char op,Expr a,Expr b=Expr()){
+    if(op=='~'){if(Is(a,0))return a;if(a->op=='n')return N(-a->number);if(a->op=='~')return a->a;return Expr(new Node(op,0,a));}
+    if(a->op=='n' && b && b->op=='n'){
+        double x=a->number,y=b->number,z=NaN();
+        if(op=='+')z=x+y;if(op=='-')z=x-y;if(op=='*')z=x*y;
