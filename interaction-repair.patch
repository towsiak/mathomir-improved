+BOOL CQuickSearchEdit::PreTranslateMessage(MSG *message)
+{
+    if (message->message==WM_KEYDOWN && bar)
+    {
+        if (message->wParam==VK_ESCAPE) { bar->HideResults(); if (bar->view) bar->view->SetFocus(); return TRUE; }
+        if (message->wParam==VK_RETURN) { if (!bar->dropdown.GetSafeHwnd() || !bar->dropdown.IsWindowVisible()) bar->ShowResults(); if (bar->dropdown.GetSafeHwnd()) bar->dropdown.RunChoice(); return TRUE; }
+        if (message->wParam==VK_UP || message->wParam==VK_DOWN) { if (!bar->dropdown.GetSafeHwnd() || !bar->dropdown.IsWindowVisible()) bar->ShowResults(); if (bar->dropdown.GetSafeHwnd()) bar->dropdown.MoveChoice(message->wParam==VK_DOWN ? 1 : -1); return TRUE; }
+    }
+    return CEdit::PreTranslateMessage(message);
+}
+static CQuickActionBar QuickActionBar;
+static void PositionQuickActionBar(CMathomirView *view) { QuickActionBar.Position(view); }
+static bool FocusQuickActionSearch()
+{
+    if (!QuickActionBar.search.GetSafeHwnd() || ViewOnlyMode) return false;
+    QuickActionBar.search.SetFocus(); QuickActionBar.search.SetSel(0,-1); QuickActionBar.ShowResults(); return true;
+}
+static void HideQuickActionSearch() { QuickActionBar.HideResults(); }
+static void UpdateQuickActionMode()
+{
+    if (!QuickActionBar.modeButton.GetSafeHwnd()) return;
+    CString current; QuickActionBar.modeButton.GetWindowText(current);
+    const char *mode=TrigDegrees ? "DEG" : "RAD";
+    if (current!=mode) QuickActionBar.modeButton.SetWindowText(mode);
+}
