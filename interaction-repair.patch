+inline double Clamp(double x,double a,double b){return (std::max)(a,(std::min)(b,x));}
+inline void Normalize(double &lo,double &hi,bool logarithmic=false) {
+ if(!std::isfinite(lo)||!std::isfinite(hi)||lo>=hi){lo=logarithmic?0.1:-10;hi=logarithmic?100:10;}
+ if(logarithmic){lo=Clamp(lo,1e-12,1e12/1.000001);hi=Clamp(hi,lo*1.000001,1e12);return;}
