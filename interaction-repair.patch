+        case ID_FILE_PRINT_PREVIEW: return "printer page preview before printing";
+        case ID_FILE_PRINT_SETUP: return "printer settings properties paper quality layout dialog";
+        case ID_VIEW_SHOWGRID: return "snap snapping spacing placement grid";
+        case ID_EDIT_DELETE: return "remove erase selected objects";
+        case ID_EDIT_UNDO: return "revert reverse change";
