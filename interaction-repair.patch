+void CFunctionPlotter::EnsureFunctionSlots()
+{
+    if(Base->NumItems<8 || Base->NumItems>=16)return;
+    if(!StopForZoom())return;
+    if(Base->NumItemsReserved<16){tDrawingItem *items=(tDrawingItem*)realloc(Base->Items,16*sizeof(tDrawingItem));if(!items)return;Base->Items=items;Base->NumItemsReserved=16;}
+    while(Base->NumItems<16){tDrawingItem *item=Base->Items+Base->NumItems;memset(item,0,sizeof(*item));item->Type=2;item->pSubdrawing=new CExpression(NULL,NULL,100);Base->NumItems++;}
+}
+
+bool CFunctionPlotter::StopForZoom()
+{
+    if (ThreadHandle) {abort_request=1;int count=0;while(ThreadHandle && count++<200) Sleep(10);if(ThreadHandle)return false;}
+    abort_request=0; return true;
+}
+void CFunctionPlotter::SetBounds(double xmin,double xmax,double ymin,double ymax)
