+
+// Geometry and rendering share the same transform. m_Overall* stays in the
+// equation's local coordinates so fractions, selection and typing stay editable.
+void CExpression::RotationGeometry(double *cosine, double *sine, double *minX, double *minY, int *width, int *height) const
+{
+    double angle=m_RotationMilliDegrees*3.14159265358979323846/180000.0;
+    *cosine=cos(angle); *sine=sin(angle);
+    if (fabs(*cosine)<1e-12) *cosine=0;
+    if (fabs(*sine)<1e-12) *sine=0;
+    double x[4]={0,*cosine*m_OverallLength,-*sine*(m_OverallAbove+m_OverallBelow),0};
+    double y[4]={0,*sine*m_OverallLength,*cosine*(m_OverallAbove+m_OverallBelow),0};
+    x[3]=x[1]+x[2]; y[3]=y[1]+y[2];
+    double maxX=0,maxY=0; *minX=0; *minY=0;
+    for (int i=0;i<4;i++)
+    {
+        *minX=min(*minX,x[i]); *minY=min(*minY,y[i]);
+        maxX=max(maxX,x[i]); maxY=max(maxY,y[i]);
+    }
+    *minX=floor(*minX); *minY=floor(*minY);
+    *width=max(1,(int)ceil(maxX)- (int)*minX);
+    *height=max(1,(int)ceil(maxY)- (int)*minY);
+}
+
+void CExpression::RotatePoint(int *X, int *Y) const
+{
+    if (!m_RotationMilliDegrees) return;
+    double c,s,minX,minY; int width,height;
+    RotationGeometry(&c,&s,&minX,&minY,&width,&height);
+    double localX=*X,localY=*Y+m_OverallAbove;
+    *X=(int)floor(c*localX-s*localY-minX+0.5);
+    *Y=(int)floor(s*localX+c*localY-minY-height/2+0.5);
+}
+
+void CExpression::CalculateSize(CDC *DC,short zoom,short *length,short *above,short *below,char HQR,char optimize_for_readability)
+{
+    CalculateSizeUnrotated(DC,zoom,length,above,below,HQR,optimize_for_readability);
+    if (m_RotationMilliDegrees)
+    {
+        double c,s,minX,minY; int width,height;
+        RotationGeometry(&c,&s,&minX,&minY,&width,&height);
+        *length=(short)min(32767,width);
+        *above=(short)min(32767,height/2);
+        *below=(short)min(32767,height-height/2);
+    }
+}
+
+void CExpression::PaintExpression(CDC *DC,short zoom,short X,short Y,RECT *ClipReg,int color)
+{
+    if (!m_RotationMilliDegrees)
+    { PaintExpressionUnrotated(DC,zoom,X,Y,ClipReg,color); return; }
+    double c,s,minX,minY; int width,height;
+    RotationGeometry(&c,&s,&minX,&minY,&width,&height);
+    XFORM transform={(FLOAT)c,(FLOAT)s,(FLOAT)-s,(FLOAT)c,(FLOAT)(X-minX),(FLOAT)(Y-height/2-minY)};
+    int saved=DC->SaveDC();
+    if (saved && ::SetGraphicsMode(DC->m_hDC,GM_ADVANCED) &&
+        ::ModifyWorldTransform(DC->m_hDC,&transform,MWT_LEFTMULTIPLY))
+    {
+        PaintExpressionUnrotated(DC,zoom,0,m_OverallAbove,NULL,color);
+        DC->RestoreDC(saved);
+        return;
+    }
+    if (saved) DC->RestoreDC(saved);
+    // A driver without world transforms can still receive a screen-rendered bitmap.
+    CDC *screen=theApp.m_pMainWnd->GetDC();
+    CDC memory; CBitmap bitmap;
+    if (memory.CreateCompatibleDC(screen) && bitmap.CreateCompatibleBitmap(screen,width,height))
+    {
+        CBitmap *old=memory.SelectObject(&bitmap);
+        memory.FillSolidRect(0,0,width,height,RGB(255,255,255));
+        transform.eDx=(FLOAT)-minX; transform.eDy=(FLOAT)-minY;
+        if (::SetGraphicsMode(memory.m_hDC,GM_ADVANCED) && ::SetWorldTransform(memory.m_hDC,&transform))
+        {
+            PaintExpressionUnrotated(&memory,zoom,0,m_OverallAbove,NULL,color);
+            ::ModifyWorldTransform(memory.m_hDC,NULL,MWT_IDENTITY);
+            DC->TransparentBlt(X,Y-height/2,width,height,&memory,0,0,width,height,RGB(255,255,255));
+        }
+        memory.SelectObject(old);
+    }
+    theApp.m_pMainWnd->ReleaseDC(screen);
+}
