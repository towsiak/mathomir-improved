+    if(ClipboardDrawing){delete ClipboardDrawing;ClipboardDrawing=NULL;}
+    ClipboardExpression=table;IsDrawingMode=0;MouseMode=0;
+    SetFocus();RepaintTheView();SetCursor(theApp.LoadCursor(IDC_POINTER_COPY));
+}
