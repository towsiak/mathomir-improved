+ double span=(std::max)(1e-9,(std::max)(std::fabs(lo),std::fabs(hi))*1e-12);
+ if(hi-lo<span){double middle=lo+(hi-lo)/2;lo=Clamp(middle-span/2,-1e12,1e12-span);hi=lo+span;}
+}
+inline double DragRatio(double start,double end){if(std::fabs(start)<1e-9)return 1;double f=end/start;return std::isfinite(f)&&f>0?Clamp(f,0.25,4):1;}
+inline void Zoom(double &lo,double &hi,double factor,bool logarithmic=false,double anchor=0.5){
+ Normalize(lo,hi,logarithmic);double a=logarithmic?std::log10(lo):lo,b=logarithmic?std::log10(hi):hi;
+ double center=a+(b-a)*Clamp(anchor,0,1),span=(b-a)*Clamp(factor,0.25,4);
+ a=center-span*anchor;b=center+span*(1-anchor);
+ lo=logarithmic?std::pow(10.0,Clamp(a,-12,12)):a;hi=logarithmic?std::pow(10.0,Clamp(b,-12,12)):b;Normalize(lo,hi,logarithmic);
