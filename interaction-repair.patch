+void CMathomirView::OnCaptureChanged(CWnd *window)
+{
+    if (MouseMovingActive && window!=this) EndGripMove(true);
+    if (MouseSizingActive && window!=this) EndMouseSizing(true);
+    if (MouseRotationActive && window!=this) EndMouseRotation(true);
+    CView::OnCaptureChanged(window);
