diff --git a/Mathomir/GraphZoom.h b/Mathomir/GraphZoom.h
new file mode 100644
index 0000000..46781e8
--- /dev/null
+++ b/Mathomir/GraphZoom.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <cmath>
+#include <algorithm>
+#include <vector>
+namespace GraphZoom {
+inline double Clamp(double x,double a,double b){return (std::max)(a,(std::min)(b,x));}
+inline void Normalize(double &lo,double &hi,bool logarithmic=false) {
+ if(!std::isfinite(lo)||!std::isfinite(hi)||lo>=hi){lo=logarithmic?0.1:-10;hi=logarithmic?100:10;}
+ if(logarithmic){lo=Clamp(lo,1e-12,1e12/1.000001);hi=Clamp(hi,lo*1.000001,1e12);return;}
+ lo=Clamp(lo,-1e12,1e12);hi=Clamp(hi,-1e12,1e12);
+ double span=(std::max)(1e-9,(std::max)(std::fabs(lo),std::fabs(hi))*1e-12);
+ if(hi-lo<span){double middle=lo+(hi-lo)/2;lo=Clamp(middle-span/2,-1e12,1e12-span);hi=lo+span;}
+}
+inline double DragRatio(double start,double end){if(std::fabs(start)<1e-9)return 1;double f=end/start;return std::isfinite(f)&&f>0?Clamp(f,0.25,4):1;}
+inline void Zoom(double &lo,double &hi,double factor,bool logarithmic=false,double anchor=0.5){
+ Normalize(lo,hi,logarithmic);double a=logarithmic?std::log10(lo):lo,b=logarithmic?std::log10(hi):hi;
+ double center=a+(b-a)*Clamp(anchor,0,1),span=(b-a)*Clamp(factor,0.25,4);
+ a=center-span*anchor;b=center+span*(1-anchor);
+ lo=logarithmic?std::pow(10.0,Clamp(a,-12,12)):a;hi=logarithmic?std::pow(10.0,Clamp(b,-12,12)):b;Normalize(lo,hi,logarithmic);
+}
+inline void Box(double &lo,double &hi,double first,double last,bool logarithmic=false){
+ Normalize(lo,hi,logarithmic);first=Clamp(first,0,1);last=Clamp(last,0,1);
+ double a=logarithmic?std::log10(lo):lo,b=logarithmic?std::log10(hi):hi;
+ double from=(std::min)(first,last),to=(std::max)(first,last);
+ if(to-from<0.02){Zoom(lo,hi,0.8,logarithmic,(first+last)/2);return;}
+ lo=logarithmic?std::pow(10.0,a+(b-a)*from):a+(b-a)*from;
+ hi=logarithmic?std::pow(10.0,a+(b-a)*to):a+(b-a)*to;Normalize(lo,hi,logarithmic);
+}
+inline bool Fit(const double *values,int count,bool logarithmic,double &lo,double &hi){
+ std::vector<double> finite;finite.reserve(count);
+ for(int i=0;i<count;i++)if(std::isfinite(values[i])&&std::fabs(values[i])<1e12&&(!logarithmic||values[i]>0))finite.push_back(logarithmic?std::log10(values[i]):values[i]);
+ if(finite.empty())return false;std::sort(finite.begin(),finite.end());
+ size_t trim=finite.size()>=40?finite.size()/20:0;lo=finite[trim];hi=finite[finite.size()-1-trim];
+ double pad=logarithmic?(std::max)(0.1,(hi-lo)*0.1):(std::max)((hi-lo)*0.1,(std::max)(1.0,std::fabs(lo)*0.05)*(hi-lo<1e-9?1:0));
+ lo-=pad;hi+=pad;
+ if(logarithmic){lo=std::pow(10.0,Clamp(lo,-12,12));hi=std::pow(10.0,Clamp(hi,-12,12));}Normalize(lo,hi,logarithmic);return true;
+}
+}
