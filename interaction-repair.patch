+        CComboBox *border=(CComboBox*)GetDlgItem(IDC_TABLE_BORDERS);
+        border->AddString("All grid lines");border->AddString("Outer border");border->AddString("Header separator");border->AddString("No borders");border->SetCurSel(0);
+        CComboBox *align=(CComboBox*)GetDlgItem(IDC_TABLE_ALIGN);
+        align->AddString("Left");align->AddString("Center");align->AddString("Right");align->SetCurSel(0);
+        return TRUE;
+    }
+    virtual void OnOK()
+    {
+        BOOL validRows,validColumns,validFont;
+        rows=GetDlgItemInt(IDC_TABLE_ROWS,&validRows,FALSE); columns=GetDlgItemInt(IDC_TABLE_COLUMNS,&validColumns,FALSE);font=GetDlgItemInt(IDC_TABLE_FONT,&validFont,FALSE);
+        if(!validRows || !validColumns || !validFont || rows<1 || rows>20 || columns<1 || columns>12 || rows*columns<2 || font<40 || font>800)
+        {AfxMessageBox("Choose 1-20 rows, 1-12 columns, at least two cells, and a font size from 40% to 800%.");return;}
+        borders=((CComboBox*)GetDlgItem(IDC_TABLE_BORDERS))->GetCurSel();alignment=((CComboBox*)GetDlgItem(IDC_TABLE_ALIGN))->GetCurSel();
