+// Four editable, scalable, rotatable interval diagrams. Choose a preset, click to place.
+static void IntervalLine(CDrawing *drawing,double x1,double y1,double x2,double y2,int width=1)
+{
+    int index=drawing->NumItems;
+    drawing->InsertItemAt(index);
+    tDrawingItem *item=drawing->Items+index;
+    item->Type=1; item->pSubdrawing=NULL;
+    item->X1=(int)floor(x1*DRWZOOM+0.5); item->Y1=(int)floor(y1*DRWZOOM+0.5);
+    item->X2=(int)floor(x2*DRWZOOM+0.5); item->Y2=(int)floor(y2*DRWZOOM+0.5);
+    item->LineWidth=width*DRWZOOM;
+}
+void CMathomirView::OnNumberLinePreset(UINT command)
+{
+    if(ViewOnlyMode)return;
+    RestoreClipboardBackground();
+    if(ClipboardExpression){delete ClipboardExpression;ClipboardExpression=NULL;}
+    if(ClipboardDrawing){delete ClipboardDrawing;ClipboardDrawing=NULL;}
+    CDrawing *drawing=new CDrawing(); drawing->m_Color=SelectedLineColor;
+    const int left=64,right=176,y=18,radius=5;
+    IntervalLine(drawing,0,y,left-radius,y);
+    IntervalLine(drawing,left+radius,y,right-radius,y,3);
+    IntervalLine(drawing,right+radius,y,240,y);
+    IntervalLine(drawing,0,y,8,y-5); IntervalLine(drawing,0,y,8,y+5);
+    IntervalLine(drawing,240,y,232,y-5); IntervalLine(drawing,240,y,232,y+5);
+    for(int end=0;end<2;end++)
+    {
+        int x=end?right:left;
+        bool closed=command==ID_INTERVAL_CLOSED_CLOSED || (end==0 && command==ID_INTERVAL_CLOSED_OPEN) || (end==1 && command==ID_INTERVAL_OPEN_CLOSED);
+        for(int segment=0;segment<32;segment++)
+        {
+            double a=segment*2*3.14159265358979323846/32,b=(segment+1)*2*3.14159265358979323846/32;
+            IntervalLine(drawing,x+radius*cos(a),y+radius*sin(a),x+radius*cos(b),y+radius*sin(b));
+        }
+        if(closed)for(int row=-4;row<=4;row++)
+        {double half=sqrt((double)(radius*radius-row*row));IntervalLine(drawing,x-half,y+row,x+half,y+row);}
+        CExpression label(NULL,NULL,100); label.InsertEmptyElement(0,1,end?'b':'a');
+        drawing->CopyExpressionIntoSubgroup(&label,x-4,y+12,0,0);
+    }
+    ClipboardDrawing=new CDrawing();
+    ClipboardDrawing->CopyDrawingIntoSubgroup(drawing,0,0); delete drawing;
+    IsDrawingMode=0; MouseMode=0; MovingStartX=MovingStartY=0;
+    SetFocus(); RepaintTheView(); SetCursor(theApp.LoadCursor(IDC_POINTER_COPY));
+}
