+#pragma once
+#include <math.h>
+
+static const char *const GeometryShapeNames[]={"Triangle","Right triangle","Square","Rectangle","Parallelogram","Trapezoid","Circle","Ellipse","Parallel lines","Z - alternate angles","F - corresponding angles","U - co-interior angles","Obtuse triangle"};
+
+// One outline definition for both palette previews and editable native drawings.
+template<class Line> void GeometryShapeOutline(int shape,double width,double height,Line line)
+{
+    if(shape==12){line(0,height*.5,width*.3,height*.1);line(width*.3,height*.1,width,height*.5);line(width,height*.5,0,height*.5);return;}
+    if(shape>=8)
+    {
+        if(shape==11)
+        {
+            line(width*.3,0,width*.3,height);line(width*.7,0,width*.7,height);
+            line(width*.1,height*.8,width*.9,height*.2);
+            for(int side=0;side<2;side++){double x=width*(side?.7:.3);line(x,height*.10,x-width*.025,height*.15);line(x,height*.10,x+width*.025,height*.15);}
+        }
+        else
+        {
+            line(0,height*.3,width,height*.3);line(0,height*.7,width,height*.7);
+            if(shape!=8)line(width*.8,height*.1,width*.2,height*.9);
+            for(int side=0;side<2;side++){double y=height*(side?.7:.3);line(width*.1,y,width*.06,y-height*.035);line(width*.1,y,width*.06,y+height*.035);}
+        }
+        return;
+    }
+    if(shape>=6)
+    {
+        const int segments=96;
+        for(int i=0;i<segments;i++)
+        {
+            double a=i*6.283185307179586/segments,b=(i+1)*6.283185307179586/segments;
+            line(width*(.5+.5*cos(a)),height*(.5+.5*sin(a)),width*(.5+.5*cos(b)),height*(.5+.5*sin(b)));
+        }
+        return;
+    }
+    double x[4]={0,width,width,0},y[4]={0,0,height,height};int count=4;
+    if(shape==0){count=3;x[0]=width/2;y[0]=0;x[1]=width;y[1]=height;x[2]=0;y[2]=height;}
+    if(shape==1){count=3;x[0]=0;y[0]=0;x[1]=width;y[1]=height;x[2]=0;y[2]=height;}
+    if(shape==4){x[0]=width*.25;x[1]=width;x[2]=width*.75;x[3]=0;}
+    if(shape==5){x[0]=width*.25;x[1]=width*.75;}
+    for(int i=0;i<count;i++){int j=(i+1)%count;line(x[i],y[i],x[j],y[j]);}
+    if(shape==1){double m=height*.10;line(0,height-m,m,height-m);line(m,height-m,m,height);}
+}
+
+// Emphasize the familiar angle pattern, while retaining full parallel lines.
+template<class Line> void GeometryAnglePattern(int shape,double w,double h,Line line)
+{
+    if(shape<9 || shape>11)return;
+    double px[4],py[4];
+    if(shape==9){px[0]=w*.35;py[0]=h*.3;px[1]=w*.65;py[1]=h*.3;px[2]=w*.35;py[2]=h*.7;px[3]=w*.65;py[3]=h*.7;}
+    else if(shape==10){px[0]=w*.8;py[0]=h*.1;px[1]=w*.2;py[1]=h*.9;line(w*.65,h*.3,w*.9,h*.3);line(w*.35,h*.7,w*.9,h*.7);line(px[0],py[0],px[1],py[1]);}
+    else {px[0]=w*.3;py[0]=h*.15;px[1]=w*.3;py[1]=h*.65;px[2]=w*.7;py[2]=h*.35;px[3]=w*.7;py[3]=h*.15;}
+    if(shape!=10)for(int i=0;i<3;i++)line(px[i],py[i],px[i+1],py[i+1]);
+    double slope=atan2(h*.4,w*.3),radius=h*.09;
+    for(int end=0;end<2;end++)
+    {
+        double x=w*(end?.35:.65),y=h*(end?.7:.3),start=-slope,stop=0;
+        if(shape==9 && !end){start=3.14159265358979323846-slope;stop=3.14159265358979323846;}
+        if(shape==11){x=w*(end?.7:.3);y=h*(end?.35:.65);start=end?atan2(h*.3,-w*.4):-1.5707963267948966;stop=end?4.71238898038469:atan2(-h*.3,w*.4);}
+        for(int i=0;i<16;i++){double a=start+(stop-start)*i/16,b=start+(stop-start)*(i+1)/16;line(x+radius*cos(a),y+radius*sin(a),x+radius*cos(b),y+radius*sin(b));}
+    }
+}
diff --git a/Mathomir/GraphDiscontinuities.h b/Mathomir/GraphDiscontinuities.h
new file mode 100644
index 0000000..eaa3757
--- /dev/null
+++ b/Mathomir/GraphDiscontinuities.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <cmath>
+#include <vector>
+#include <algorithm>
+#include <limits>
+
+// Numerical domain analysis; no function-name or example-specific cases.
+namespace GraphDiscontinuities {
+inline bool Finite(double value) { return std::isfinite(value) && std::fabs(value)<1e40; }
+// A true finite jump survives interval refinement. Continuous steep curves shrink.
+template<class Evaluate> bool FiniteJump(Evaluate evaluate,double a,double b,double fa,double fb,double visibleDelta) {
+    if(!Finite(fa)||!Finite(fb)||a>=b)return false;
+    double initial=std::fabs(fb-fa);
+    if(initial<=visibleDelta)return false;
+    for(int i=0;i<28;i++){
+        double m=a+(b-a)/2;if(m==a || m==b)break;
+        double fm=evaluate(m);if(!Finite(fm))return true;
+        if(std::fabs(fm-fa)>std::fabs(fb-fm)){b=m;fb=fm;}else{a=m;fa=fm;}
+    }
+    return std::fabs(fb-fa)>(std::max)(visibleDelta,initial*1e-6);
+}
+inline void AddRoot(std::vector<double>& roots,double x) {
+    // Deduplicate at numerical precision, not at a fraction of the viewport.
+    for (size_t i=0;i<roots.size();++i) {
+        double scale=(std::max)(1.0,(std::max)(std::fabs(x),std::fabs(roots[i])));
+        if(std::fabs(roots[i]-x)<=1e-10+64*std::numeric_limits<double>::epsilon()*scale)return;
+    }
+    if(roots.size()<128)roots.push_back(x);
+}
+template<class Evaluate> bool RootResidual(Evaluate evaluate,double x) {
+    double scale=(std::max)(1.0,std::fabs(x)),h=(std::max)(1e-4,64*std::numeric_limits<double>::epsilon()*scale);
+    double residual=evaluate(x),left=evaluate(x-h),right=evaluate(x+h);
+    return Finite(residual)&&Finite(left)&&Finite(right) &&
+        std::fabs(residual)<=1e-10*(1+std::fabs(left)+std::fabs(right));
+}
+template<class Evaluate> void Roots(Evaluate evaluate,double low,double high,std::vector<double>& roots,int depth=0) {
+    if(!Finite(low)||!Finite(high)||high<=low || roots.size()>=128)return;
+    const int count=256;double span=high-low,step=span/count;
+    double a=low,fa=evaluate(a),previous=fa;
+    for(int i=1;i<=count && roots.size()<128;i++) {
+        double b=low+step*i,fb=evaluate(b);
+        if(Finite(fa)&&Finite(fb)) {
+            if(fa==0 && fb!=0)AddRoot(roots,a);
+            if(fb==0 && fa!=0)AddRoot(roots,b);
+            if((fa<0 && fb>0)||(fa>0 && fb<0)) {
+                double l=a,r=b,fl=fa;bool valid=true;
+                for(int k=0;k<80;k++){double m=(l+r)/2,fm=evaluate(m);if(!Finite(fm)){valid=false;break;}if(fm==0){l=r=m;break;}if((fl<0)==(fm<0)){l=m;fl=fm;}else r=m;}
+                double root=(l+r)/2;
+                if(valid && RootResidual(evaluate,root))AddRoot(roots,root);
+            }
+            // Even multiplicity roots need not change sign.
+            if(i>1 && Finite(previous) && std::fabs(fa)<std::fabs(previous) && std::fabs(fa)<std::fabs(fb)) {
+                // Two or more roots can occupy one coarse sample interval.
+                // Re-scan valleys locally before minimizing an even root.
+                if(depth<6)Roots(evaluate,a-step,b,roots,depth+1);
+                double l=a-step,r=b;
+                for(int k=0;k<96;k++){double p=l+(r-l)/3,q=r-(r-l)/3;double fp=evaluate(p),fq=evaluate(q);if(!Finite(fp)||!Finite(fq))break;if(std::fabs(fp)<std::fabs(fq))r=q;else l=p;}
+                double root=(l+r)/2;
+                if(RootResidual(evaluate,root))AddRoot(roots,root);
+            }
+        }
+        previous=fa;a=b;fa=fb;
+    }
+}
+template<class Evaluate> bool HoleLimit(Evaluate evaluate,double x,double span,double& value) {
+    if(!Finite(x)||!Finite(span)||span<=0)return false;
+    // Use a local neighbourhood, rather than letting viewport zoom determine
+    // whether a removable discontinuity has a limit. Require repeated agreement
+    // before accepting it; poles and jumps must remain excluded.
+    const double scale=(std::max)(1.0,std::fabs(x));
+    double h=(std::max)(scale*1e-4,(std::min)(span*1e-3,scale*1e-2));
+    double previousValue=0;int agreements=0;
+    for(int i=0;i<14;i++,h*=0.1) {
+        if(x-h==x || x+h==x)return false;
+        double left=evaluate(x-h),right=evaluate(x+h);
+        if(!Finite(left)||!Finite(right)){agreements=0;continue;}
+        double gap=std::fabs(left-right),mean=(left+right)/2;
+        double tolerance=1e-7*(1+std::fabs(mean));
+        if(i>0 && gap<=tolerance && std::fabs(mean-previousValue)<=tolerance)
+            ++agreements;
+        else agreements=0;
+        previousValue=mean;
+        if(agreements>=3){value=mean;return true;}
+    }
+    return false;
+}
+}
