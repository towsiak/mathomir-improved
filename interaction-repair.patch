+bool CMathomirView::BeginMouseSizing(CPoint point)
+{
+    tDocumentStruct *object=ResizeHandleDocument();
+    if (!object || object->MovingDotState==5 || ViewOnlyMode || IsDrawingMode || MouseRotationActive) return false;
+    if (object->Type==2 && ((CDrawing*)object->Object)->IsSpecialDrawing && !IsGraphObject(object)) return false;
+    CPoint handle=ResizeHandlePoint(object);
+    if (abs(point.x-handle.x)>9 || abs(point.y-handle.y)>9) return false;
+    RestoreClipboardBackground();
+    if (ClipboardExpression) { delete ClipboardExpression; ClipboardExpression=NULL; }
+    if (ClipboardDrawing) { delete ClipboardDrawing; ClipboardDrawing=NULL; }
+    if (KeyboardEntryObject) { ((CExpression*)KeyboardEntryObject)->KeyboardStop(); KeyboardEntryObject=NULL; KeyboardEntryBaseObject=NULL; }
+    FunctionHelpText.Empty(); LastQuickTypeObject=NULL;
+    if(IsGraphObject(object) && !((CFunctionPlotter*)((CDrawing*)object->Object)->SpecialData)->StopForZoom())return false;
+    SizingStartX=object->absolute_X; SizingStartY=object->absolute_Y;
+    SizingAnchorX=object->absolute_X; SizingAnchorY=object->absolute_Y-object->Above;
+    SizingVectorX=ViewX+point.x*100.0/ViewZoom-SizingAnchorX;
+    SizingVectorY=ViewY+point.y*100.0/ViewZoom-SizingAnchorY;
+    SizingScale=1.0; SizingStartPoint=point;
+    if (object->Type==1)
+    {
+        CExpression *expression=(CExpression*)object->Object;
+        SizingFontSize=expression->m_FontSize;
+        SizingExpressionSnapshot=new CExpression(NULL,NULL,SizingFontSize);
+        SizingExpressionSnapshot->CopyExpression(expression,0,1,0);
+        SizingExpressionSnapshot->m_FontSize=SizingFontSize;
+    }
+    else { SizingDrawingSnapshot=new CDrawing(); SizingDrawingSnapshot->CopyDrawing((CDrawing*)object->Object); }
+    UndoSave("resize with grip",20506);
+    MouseSizingActive=true; MouseMode=104; FreePlacementGesture=false;
+    SetCapture(); SetCursor(::LoadCursor(NULL,IDC_SIZENWSE));
+    return true;
+}
+void CMathomirView::UpdateMouseSizing(CPoint point,UINT flags)
+{
+    tDocumentStruct *object=ResizeHandleDocument();
+    if (!object) { EndMouseSizing(true); return; }
+    // Project the drag onto the original corner diagonal. Always scale from
+    // the snapshot; the grip remains on the actual object, never a floating copy.
+    double vx=max(1.0,SizingVectorX*ViewZoom/100.0),vy=max(1.0,SizingVectorY*ViewZoom/100.0);
+    double delta=((point.x-SizingStartPoint.x)*vx+(point.y-SizingStartPoint.y)*vy)/(vx*vx+vy*vy);
+    if(flags&MK_SHIFT)delta/=4.0;
+    double scale=max(0.05,min(8.0,1.0+delta));
+    short length,above=0,below; CClientDC dc(this);
+    if (object->Type==1 && SizingExpressionSnapshot)
+    {
+        int size=max(40,min(800,(int)floor(SizingFontSize*scale+0.5)));
+        CExpression *expression=(CExpression*)object->Object;
+        if (size==expression->m_FontSize) return;
+        // CopyExpression preserves root size and scales children relative to it.
+        // Restore the original root size before copying, then apply drag once.
+        expression->m_FontSize=SizingFontSize;
+        expression->CopyExpression(SizingExpressionSnapshot,0,1,0);
+        expression->ChangeFontSize((float)size/max(10,SizingFontSize));
+        expression->CalculateSize(&dc,ViewZoom,&length,&above,&below);
+        object->absolute_Y=(int)SizingAnchorY+above*100/ViewZoom;
+    }
+    else if (object->Type==2 && SizingDrawingSnapshot)
+    {
+        if (fabs(scale-SizingScale)<0.002) return;
+        CDrawing *drawing=(CDrawing*)object->Object;
+        drawing->CopyDrawing(SizingDrawingSnapshot); drawing->ScaleForFactor((float)scale,(float)scale);
+        drawing->CalculateSize(&dc,ViewZoom,&length,&below);
+    }
+    else return;
+    SizingScale=scale;
+    object->Length=length*100/ViewZoom; object->Above=above*100/ViewZoom; object->Below=below*100/ViewZoom;
+    GetDocument()->SetModifiedFlag(); InvalidateRect(NULL,FALSE); UpdateWindow();
+}
+void CMathomirView::EndMouseSizing(bool cancel)
+{
+    tDocumentStruct *object=ResizeHandleDocument();
+    if (cancel && object)
+    {
+        if (object->Type==1 && SizingExpressionSnapshot)
+        {
+            CExpression *expression=(CExpression*)object->Object;
+            expression->m_FontSize=SizingFontSize;
+            expression->CopyExpression(SizingExpressionSnapshot,0,1,0);
+        }
+        if (object->Type==2 && SizingDrawingSnapshot) ((CDrawing*)object->Object)->CopyDrawing(SizingDrawingSnapshot);
+        object->absolute_X=SizingStartX; object->absolute_Y=SizingStartY;
+    }
+    MouseSizingActive=false; MouseMode=0;
+    if (GetCapture()==this) ReleaseCapture();
+    delete SizingExpressionSnapshot; SizingExpressionSnapshot=NULL;
+    delete SizingDrawingSnapshot; SizingDrawingSnapshot=NULL;
+    RepaintTheView(1); SetCursor(::LoadCursor(NULL,IDC_ARROW));
+}
