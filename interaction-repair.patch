+bool CDrawing::SmoothFreehand(int strength,short zoom)
+{
+    if((OriginalForm!=3 && !(OriginalForm==0 && NumItems>=5)) || IsSpecialDrawing || strength<=0 || NumItems<2 || NumItems>12000 || zoom<=0)return false;
+    const double scale=zoom/(100.0*DRWZOOM);std::vector<SmartStroke::Point> points;
+    for(int i=0;i<NumItems;i++){
+        if(Items[i].Type!=1 || (i>0 && (Items[i-1].X2!=Items[i].X1 || Items[i-1].Y2!=Items[i].Y1)))return false;
+        if(i==0)points.push_back(SmartStroke::Point(Items[i].X1*scale,Items[i].Y1*scale));
+        points.push_back(SmartStroke::Point(Items[i].X2*scale,Items[i].Y2*scale));
+    }
+    std::vector<SmartStroke::Point> filtered=SmartStroke::Smooth(points,strength);
+    if(filtered.size()<2 || filtered.size()>12001)return false;
+    short width=Items[0].LineWidth;tDrawingItem *replacement=(tDrawingItem*)malloc((filtered.size()-1)*sizeof(tDrawingItem));if(!replacement)return false;
+    int count=0;for(size_t i=1;i<filtered.size();i++){
+        tDrawingItem item;memset(&item,0,sizeof(item));item.Type=1;item.LineWidth=width;
+        item.X1=(int)floor(filtered[i-1].x/scale+.5);item.Y1=(int)floor(filtered[i-1].y/scale+.5);item.X2=(int)floor(filtered[i].x/scale+.5);item.Y2=(int)floor(filtered[i].y/scale+.5);
+        if(item.X1!=item.X2 || item.Y1!=item.Y2)replacement[count++]=item;
+    }
+    if(count==0){free(replacement);return false;}free(Items);Items=replacement;NumItems=(unsigned short)count;NumItemsReserved=(unsigned short)(filtered.size()-1);OriginalForm=3;return true;
+}
