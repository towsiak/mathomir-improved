+ double from=(std::min)(first,last),to=(std::max)(first,last);
+ if(to-from<0.02){Zoom(lo,hi,0.8,logarithmic,(first+last)/2);return;}
+ lo=logarithmic?std::pow(10.0,a+(b-a)*from):a+(b-a)*from;
+ hi=logarithmic?std::pow(10.0,a+(b-a)*to):a+(b-a)*to;Normalize(lo,hi,logarithmic);
+}
+inline bool Fit(const double *values,int count,bool logarithmic,double &lo,double &hi){
