+#pragma optimize("",on)
+// Recovery files are independent of the document path and the legacy autosave setting.
+CString CMathomirDoc::RecoveryFolder()
+{
+    char path[MAX_PATH];
+    DWORD size=GetEnvironmentVariableA("LOCALAPPDATA",path,MAX_PATH);
+    if (!size || size>=MAX_PATH-70) { if (!GetTempPathA(MAX_PATH,path)) return CString(); }
+    CString folder(path);
+    folder+="\\MathomirImproved";
+    if (!CreateDirectoryA(folder,NULL) && GetLastError()!=ERROR_ALREADY_EXISTS) return CString();
+    folder+="\\Recovery";
+    if (!CreateDirectoryA(folder,NULL) && GetLastError()!=ERROR_ALREADY_EXISTS) return CString();
+    return folder;
+}
+bool CMathomirDoc::SaveRecovery()
+{
+    // A graph can update its bounds on its worker thread. Retry after it finishes.
+    for (int i=0;i<NumDocumentElements;i++)
+        if (TheDocument[i].Type==2)
+        {
+            CDrawing *drawing=(CDrawing*)TheDocument[i].Object;
+            if (drawing->IsSpecialDrawing==51 && drawing->SpecialData)
+            {
+                CFunctionPlotter *plot=(CFunctionPlotter*)drawing->SpecialData;
+                if (plot->ThreadHandle && WaitForSingleObject(plot->ThreadHandle,0)==WAIT_TIMEOUT) return false;
+            }
+        }
+    CString folder=RecoveryFolder();
+    if (folder.IsEmpty()) return false;
+    SYSTEMTIME time; GetLocalTime(&time);
+    char name[128];
+    sprintf(name,"\\Recovery-%04d%02d%02d-%02d%02d%02d-%03d-%lu.mom",time.wYear,time.wMonth,time.wDay,time.wHour,time.wMinute,time.wSecond,time.wMilliseconds,GetCurrentProcessId());
+    CString version=folder+name, temporary=version+".tmp";
+    char oldXML=XMLFileVersion;
+    bool saved=SaveMOMFile(temporary.GetBuffer(), '2',true)!=0;
+    temporary.ReleaseBuffer(); XMLFileVersion=oldXML;
+    if (!saved) { DeleteFileA(temporary); return false; }
+    if (!MoveFileExA(temporary,version,MOVEFILE_WRITE_THROUGH)) { DeleteFileA(temporary); return false; }
+    CString latest=folder+"\\Latest.mom", pending=version+".latest.tmp";
+    if (!CopyFileA(version,pending,FALSE)) return false;
+    HANDLE file=CreateFileA(pending,GENERIC_WRITE,0,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);
+    if (file==INVALID_HANDLE_VALUE) return false;
+    bool flushed=FlushFileBuffers(file)!=0; CloseHandle(file);
+    if (!flushed) return false;
+    return MoveFileExA(pending,latest,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=0;
+}
+
+void CMathomirDoc::SetModifiedFlag(BOOL modified)
+{
+    if (modified)
+    {
+        extern DWORD RecoveryGeneration, RecoveryLastEdit;
+        RecoveryGeneration++; RecoveryLastEdit=GetTickCount();
+    }
+    CDocument::SetModifiedFlag(modified);
+}
