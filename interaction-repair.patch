+void CMathomirView::OnGraphAxisLabels(UINT command)
+{
+    if (ViewOnlyMode) return;
+    bool changed=false, piLabels=command==ID_GRAPH_PI_FRACTIONS;
+    tDocumentStruct *focus=prevTouchedObject;
+    bool focusGraph=focus && focus>=TheDocument && focus<TheDocument+NumDocumentElements &&
+        focus->Type==2 && ((CDrawing*)focus->Object)->IsSpecialDrawing==51;
+    for (int i=0;i<NumDocumentElements;i++)
+    {
+        tDocumentStruct *object=TheDocument+i;
+        if (object->Type!=2 || !object->Object || object->MovingDotState==5) continue;
+        CDrawing *drawing=(CDrawing*)object->Object;
+        if (drawing->IsSpecialDrawing!=51 || drawing->NumItems<7) continue;
+        if (NumSelectedObjects && object->MovingDotState!=3) continue;
+        if (!NumSelectedObjects && focusGraph && object!=focus) continue;
+        CExpression *minimum=(CExpression*)(drawing->Items+4)->pSubdrawing;
+        if (!minimum) continue;
+        int mode=piLabels ? 2 : 0;
+        if (minimum->m_Alignment==mode) continue;
+        if (!changed) UndoSave("graph axis labels",20508);
+        minimum->m_Alignment=mode;
+        CFunctionPlotter *plotter=(CFunctionPlotter*)drawing->SpecialData;
+        if (plotter) { plotter->is_x_pi=piLabels; plotter->is_x_log=0; plotter->PlotFunction(2); }
+        changed=true;
+    }
+    if (!changed) { AfxMessageBox("Point at or select a function graph, then search for pi fractions or decimal labels."); return; }
+    GetDocument()->SetModifiedFlag(); RepaintTheView(1);
+}
