+class CFeatureSearchDialog : public CDialog
+{
+public:
+    std::vector<CFeatureSearchEntry> entries;
+    CMathomirView *inlineView;
+    UINT command;
+    int drawingMode;
+    CFeatureSearchDialog() : CDialog(IDD_FEATURE_SEARCH,theApp.m_pMainWnd),inlineView(NULL),command(0),drawingMode(-1) {}
+    void Add(UINT id,const char *label,const char *aliases="",int tool=-1)
+    {
+        if (id==ID_FEATURE_SEARCH) return;
+        for (size_t i=0;id && i<entries.size();i++) if (entries[i].command==id) return;
+        CFeatureSearchEntry entry;
+        entry.command=id; entry.drawingMode=tool; entry.label=label;
+        entry.keywords=entry.label+" "+aliases; entry.keywords.MakeLower();
+        entries.push_back(entry);
+    }
+    CString Aliases(UINT id)
+    {
+        switch (id)
+        {
+        case ID_FONT_ALL_OBJECTS: return "typeface family change all global text equations font size";
+        case ID_EDIT_ROTATE_EQUATION: return "angle turn tilt degrees orientation text equation";
+        case ID_FONT_SIZE_800: return "font size maximum biggest huge larger enlarge text equation";
+        case ID_FONT_SIZE_400: return "font size bigger huge larger enlarge text equation";
+        case ID_FONT_SIZE_200: return "font size bigger large larger enlarge text equation";
+        case ID_FONT_SIZE_100: return "font size normal smaller reset medium text equation";
+        case ID_FILE_PRINT: return "printer paper output document";
+        case ID_FILE_PRINT_PREVIEW: return "printer page preview before printing";
+        case ID_FILE_PRINT_SETUP: return "printer settings properties paper quality layout dialog";
+        case ID_VIEW_SHOWGRID: return "snap snapping spacing placement grid";
+        case ID_EDIT_DELETE: return "remove erase selected objects";
+        case ID_EDIT_UNDO: return "revert reverse change";
+        case ID_EDIT_COPYLATEXCODE: return "export equation latex code";
+        case ID_EDIT_IMAGE: return "export copy equation picture image";
+        case ID_EDIT_SAVEEQUATIONIMAGE: return "export save equation picture image file";
+        case ID_SAVEOPTIONS_SAVEASDEFAULT: return "remember preferences settings fonts default";
+        }
+        return "";
+    }
+    void Collect(CMenu *menu,const CString &prefix)
+    {
+        if (!menu) return;
+        for (int i=0;i<menu->GetMenuItemCount();i++)
+        {
+            UINT state=menu->GetMenuState(i,MF_BYPOSITION);
+            if (state & MF_SEPARATOR) continue;
+            CString name;
+            menu->GetMenuString(i,name,MF_BYPOSITION);
+            name.Remove('&');
+            int tab=name.Find('\t'); if (tab>=0) name=name.Left(tab);
+            name.TrimLeft(); name.TrimRight();
+            if (name.IsEmpty()) continue;
+            CString path=prefix.IsEmpty() ? name : prefix+" > "+name;
+            CMenu *child=menu->GetSubMenu(i);
+            if (child) { Collect(child,path); continue; }
+            UINT id=menu->GetMenuItemID(i);
+            if (id==0 || id==(UINT)-1 || (state&(MF_DISABLED|MF_GRAYED))) continue;
+            CString aliases=Aliases(id);
+            if (state & MF_CHECKED) path+=" [on]";
+            Add(id,path,aliases);
+        }
+    }
+protected:
+    CFeatureResultList results;
+public:
+    void SetQuery(const CString &query) { SetDlgItemText(IDC_FEATURE_QUERY,query); Filter(); }
+    void MoveChoice(int direction) { int row=results.GetCurSel(); if (results.GetCount()) results.SetCurSel(max(0,min(results.GetCount()-1,row+direction))); }
+    void RunChoice() { OnOK(); }
+    void ArrangeInline(int width,int height)
+    {
+        ModifyStyle(WS_CAPTION|WS_SYSMENU,0,SWP_FRAMECHANGED);
+        GetDlgItem(IDC_FEATURE_QUERY)->ShowWindow(SW_HIDE);
+        GetDlgItem(IDOK)->ShowWindow(SW_HIDE); GetDlgItem(IDCANCEL)->ShowWindow(SW_HIDE);
+        results.MoveWindow(4,4,width-8,height-28);
+        GetDlgItem(IDC_FEATURE_STATUS)->MoveWindow(5,height-23,width-10,20);
+    }
+    virtual BOOL OnInitDialog()
+    {
+        CDialog::OnInitDialog();
+        results.SubclassDlgItem(IDC_FEATURE_RESULTS,this);
+        ((CEdit*)GetDlgItem(IDC_FEATURE_QUERY))->LimitText(128);
+        Filter();
+        if (!inlineView) GetDlgItem(IDC_FEATURE_QUERY)->SetFocus();
+        return FALSE;
+    }
+    afx_msg void Filter()
+    {
+        if (!results.GetSafeHwnd()) return;
+        CString query; GetDlgItemText(IDC_FEATURE_QUERY,query);
+        query.MakeLower(); query.TrimLeft(); query.TrimRight();
+        std::vector<CString> words;
+        int position=0;
+        while (position<query.GetLength())
+        {
+            while (position<query.GetLength() && (query[position]==' ' || query[position]=='\t')) position++;
+            int start=position;
+            while (position<query.GetLength() && query[position]!=' ' && query[position]!='\t') position++;
+            if (position>start) words.push_back(query.Mid(start,position-start));
+        }
+        results.SetRedraw(FALSE); results.ResetContent();
+        // Name matches appear ahead of matches found only through synonyms.
+        for (int pass=0;pass<2;pass++)
+        for (size_t i=0;i<entries.size();i++)
+        {
+            bool matches=true;
+            for (size_t w=0;w<words.size();w++)
+                if (entries[i].keywords.Find(words[w])<0) { matches=false; break; }
+            if (!matches) continue;
+            CString label=entries[i].label; label.MakeLower();
+            bool nameMatch=query.IsEmpty() || label.Find(query)>=0;
+            if ((pass==0)!=nameMatch) continue;
+            int row=results.AddString(entries[i].label);
+            if (row>=0) results.SetItemData(row,(DWORD_PTR)i);
+        }
+        if (results.GetCount()>0) results.SetCurSel(0);
+        results.SetRedraw(TRUE); results.Invalidate();
+        GetDlgItem(IDOK)->EnableWindow(results.GetCount()>0);
+        SetDlgItemText(IDC_FEATURE_STATUS,results.GetCount() ?
+            "Click a result or press Enter. Arrow keys choose a result." :
+            "No matching feature. Try a shorter word, such as font or print.");
+    }
+    virtual BOOL PreTranslateMessage(MSG *message)
+    {
+        if (message->message==WM_KEYDOWN && (message->wParam==VK_DOWN || message->wParam==VK_UP) &&
+            message->hwnd==GetDlgItem(IDC_FEATURE_QUERY)->GetSafeHwnd())
+        {
+            int row=results.GetCurSel();
+            row+=(message->wParam==VK_DOWN ? 1 : -1);
+            if (results.GetCount()) results.SetCurSel(max(0,min(results.GetCount()-1,row)));
+            return TRUE;
+        }
+        return CDialog::PreTranslateMessage(message);
+    }
+    virtual void OnOK()
+    {
+        int row=results.GetCurSel();
+        if (row<0) return;
+        DWORD_PTR index=results.GetItemData(row);
+        if (index>=entries.size()) return;
+        command=entries[index].command; drawingMode=entries[index].drawingMode;
+        if (inlineView) { ShowWindow(SW_HIDE); inlineView->RunFeatureCommand(command,drawingMode); }
+        else CDialog::OnOK();
+    }
+    virtual void OnCancel() { if (inlineView) { ShowWindow(SW_HIDE); inlineView->SetFocus(); } else CDialog::OnCancel(); }
+    DECLARE_MESSAGE_MAP()
+};
+BEGIN_MESSAGE_MAP(CFeatureSearchDialog,CDialog)
+    ON_EN_CHANGE(IDC_FEATURE_QUERY,Filter)
+    ON_LBN_DBLCLK(IDC_FEATURE_RESULTS,OnOK)
+END_MESSAGE_MAP()
