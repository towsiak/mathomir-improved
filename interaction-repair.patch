+    ((CExpression*)(Base->Items+4)->pSubdrawing)->m_Alignment=is_x_pi?2:(is_x_log?1:0);
+    ((CExpression*)(Base->Items+6)->pSubdrawing)->m_Alignment=is_y_log?1:0;
+}
+bool CFunctionPlotter::SmartFit(bool resetX)
+{
+    if(Base->NumItems<8 || !StopForZoom()) return false;
+    double xmin,xmax,ymin,ymax;PlotFunctionGetBondaries(&xmin,&xmax,&ymin,&ymax);
