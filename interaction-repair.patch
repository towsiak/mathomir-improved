+    {
+        tPureFactors factors;factors.N1=factors.N2=1.;factors.is_frac1=factors.prec1=0;
+        if(!arg->StrikeoutCommonFactors(0,arg->m_NumElements-1,1,NULL,0,0,1,&factors) || factors.N2==0)return changed;
+        input=factors.N1/factors.N2;
+    }
+    double result=ScalarFunctions::Value(name,input);
+    if(!std::isfinite(result))return changed;
+    // Avoid narrowing large integers. Keep the native full-precision number cache.
+    bool integerFits=std::fabs(result)<9e18;
+    long long integer=integerFits?(long long)result:0;
+    DeleteElement(Position);
