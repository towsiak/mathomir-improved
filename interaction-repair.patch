+class CEquationRotationDialog : public CDialog
+{
+public:
+    double angle;
+    CEquationRotationDialog(double initial) : CDialog(IDD_ROTATE_EQUATION,theApp.m_pMainWnd),angle(initial) {}
+    virtual BOOL OnCommand(WPARAM wParam,LPARAM lParam)
+    {
+        if (LOWORD(wParam)==IDC_ROTATION_MOUSE) { EndDialog(IDC_ROTATION_MOUSE); return TRUE; }
+        return CDialog::OnCommand(wParam,lParam);
+    }
+protected:
+    virtual BOOL OnInitDialog()
+    {
+        CDialog::OnInitDialog();
+        CString value; value.Format("%.3f",angle);
+        SetDlgItemText(IDC_ROTATION_ANGLE,value);
+        CEdit *entry=(CEdit*)GetDlgItem(IDC_ROTATION_ANGLE);
+        entry->LimitText(64); entry->SetSel(0,-1); entry->SetFocus();
+        return FALSE;
+    }
+    virtual void OnOK()
+    {
+        CString value; GetDlgItemText(IDC_ROTATION_ANGLE,value);
+        const char *text=value; char *end=NULL;
+        double entered=strtod(text,&end);
+        const bool hasNumber=(end!=text);
+        while (end && (*end==' ' || *end=='\t')) end++;
+        if (!hasNumber || !end || *end || !_finite(entered))
+        {
+            AfxMessageBox("Enter an angle in degrees, for example 17.5 or -45.");
+            GetDlgItem(IDC_ROTATION_ANGLE)->SetFocus(); return;
+        }
+        angle=fmod(entered,360.0);
+        CDialog::OnOK();
+    }
+};
