+static bool ReadUnitAngle(CString text,bool radians,double &degrees)
+{
+    text.MakeLower();text.Remove(' ');CString coefficient=text;
+    int pi=text.Find("pi");
+    char *end=NULL;
+    double value=0;
+    if(pi>=0)
+    {
+        if(!radians)return false;
+        CString before=text.Left(pi);before.TrimRight('*');
+        value=before.IsEmpty()||before=="+"?1:before=="-"?-1:strtod(before,&end);
+        if(!before.IsEmpty() && before!="+" && before!="-" && (!end || *end))return false;
+        CString after=text.Mid(pi+2);
+        if(!after.IsEmpty()){if(after[0]!='/')return false;CString divisorText=after.Mid(1);double divisor=strtod(divisorText,&end);if(!end||*end||divisor==0)return false;value/=divisor;}
+        degrees=value*180;
+    }
+    else
+    {
+        value=strtod(text,&end);if(text.IsEmpty()||!end||*end)return false;
+        degrees=radians?value*180/3.14159265358979323846:value;
+    }
+    return _finite(degrees) && fabs(degrees)<=3600;
+}
