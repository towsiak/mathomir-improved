+static bool ApplyHighlightedStyle(CExpression *e,int color,bool bold,bool apply)
+{
+    if(!e || !e->m_pElementList)return false;bool found=false;
+    for(int i=0;i<e->m_NumElements;i++)
+    {
+        tElementStruct *t=e->m_pElementList+i;CElement *part=t->pElementObject;if(!part)continue;
+        if(t->IsSelected==2)
+        {
+            found=true;if(apply){if(!bold)part->SetColor(color);else if(t->Type==1)for(int j=0;j<24;j++)part->Data2[j]^=1;}
+        }
+        else {found=ApplyHighlightedStyle((CExpression*)part->Expression1,color,bold,apply)||found;found=ApplyHighlightedStyle((CExpression*)part->Expression2,color,bold,apply)||found;found=ApplyHighlightedStyle((CExpression*)part->Expression3,color,bold,apply)||found;}
+    }return found;
+}
