+static int UnitAppend(CExpression *expression,int type,char symbol)
+{
+    int position=expression->m_NumElements;
+    if(position>0 && expression->m_pElementList[position-1].Type==0)position--;
+    expression->InsertEmptyElement(position,type,symbol);
+    return position;
+}
+static void UnitNumber(CExpression *expression,double value)
+{
+    int position=UnitAppend(expression,1,'0');
+    CString number;number.Format("%.3f",value);number.TrimRight('0');number.TrimRight('.');
+    strncpy(expression->m_pElementList[position].pElementObject->Data1,number,23);
+    expression->m_pElementList[position].pElementObject->Data1[23]=0;
+}
+static void UnitValue(CExpression *label,double value)
+{
+    if(fabs(value)<1e-8)value=0;
+    if(value<0)label->InsertEmptyElement(label->m_NumElements,2,'-');
+    value=fabs(value);int p=label->m_NumElements;
+    if(fabs(value-1)<1e-8 || value==0){label->InsertEmptyElement(p,1,value==0?'0':'1');return;}
+    int root=fabs(value-.5)<1e-8?0:fabs(value-sqrt(.5))<1e-8?2:fabs(value-sqrt(3.)/2)<1e-8?3:-1;
+    if(root>=0)
+    {
+        p=UnitAppend(label,4,0);CExpression *n=(CExpression*)label->m_pElementList[p].pElementObject->Expression1,*d=(CExpression*)label->m_pElementList[p].pElementObject->Expression2;
+        n->DeleteElement(0);d->DeleteElement(0);
+        if(root){n->InsertEmptyElement(0,8,1);CExpression *r=(CExpression*)n->m_pElementList[0].pElementObject->Expression1;r->DeleteElement(0);r->InsertEmptyElement(0,1,'0'+root);}else n->InsertEmptyElement(0,1,'1');
+        d->InsertEmptyElement(0,1,'2');
+    }
+    else UnitNumber(label,value);
+}
+static void UnitAngleLabel(CExpression *label,double angle,bool radians)
+{
+    if(!radians){UnitNumber(label,angle);label->InsertEmptyElement(label->m_NumElements,1,(char)0xB0);return;}
+    double fraction=angle/180.;int denominator=1;
+    for(;denominator<=360;denominator++)if(fabs(fraction*denominator-floor(fraction*denominator+.5))<1e-8)break;
+    if(denominator>360){double rad=angle*3.14159265358979323846/180;UnitNumber(label,rad);return;}
+    int numerator=(int)floor(fraction*denominator+.5);
+    if(!numerator){label->InsertEmptyElement(0,1,'0');return;}
+    if(numerator<0){label->InsertEmptyElement(0,2,'-');numerator=-numerator;}
+    CExpression *n=label;
+    if(denominator>1){int p=label->m_NumElements;p=UnitAppend(label,4,0);n=(CExpression*)label->m_pElementList[p].pElementObject->Expression1;CExpression *d=(CExpression*)label->m_pElementList[p].pElementObject->Expression2;n->DeleteElement(0);d->DeleteElement(0);UnitNumber(d,denominator);}
+    if(numerator!=1)UnitNumber(n,numerator);
+    int p=n->m_NumElements;p=UnitAppend(n,1,'p');n->m_pElementList[p].pElementObject->Data2[0]=0x60;
+}
+static void UnitPoint(CDrawing *drawing,double x,double y)
+{
+    for(int row=-4;row<=4;row++){double half=sqrt(16.-row*row);IntervalLine(drawing,x-half,y+row,x+half,y+row);}
+}
