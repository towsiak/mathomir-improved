+void CMathomirView::PaintRotationHandle(CDC *dc)
+{
+    if (FunctionHelpVisible && !FunctionHelpText.IsEmpty() && MouseMode==0 && !IsDrawingMode && !ClipboardExpression && !ClipboardDrawing)
+    {
+        int saved=dc->SaveDC(); dc->SelectObject(GetStockObject(DEFAULT_GUI_FONT));
+        dc->SetTextAlign(TA_LEFT|TA_TOP); dc->SetTextColor(RGB(30,30,30)); dc->SetBkMode(TRANSPARENT);
+        CRect box(0,0,390,0); ::DrawTextW(dc->GetSafeHdc(),FunctionHelpText,FunctionHelpText.GetLength(),&box,DT_CALCRECT|DT_WORDBREAK|DT_NOPREFIX);
+        int w=box.Width()+16, h=box.Height()+16;
+        int x=max(0,min(FunctionHelpPoint.x+18,TheClientRect.right-w));
+        int y=max(0,min(FunctionHelpPoint.y+24,TheClientRect.bottom-h));
+        box.SetRect(x,y,x+w,y+h); dc->FillSolidRect(box,RGB(255,255,225)); dc->Draw3dRect(box,RGB(110,110,110),RGB(110,110,110));
+        box.DeflateRect(8,8); ::DrawTextW(dc->GetSafeHdc(),FunctionHelpText,FunctionHelpText.GetLength(),&box,DT_WORDBREAK|DT_NOPREFIX); dc->RestoreDC(saved);
+    }
+
+    if (ViewOnlyMode || IsDrawingMode || FreePlacementGesture) return;
+    tDocumentStruct *hover=ResizeHandleDocument();
+    if(hover && !ViewOnlyMode && !IsDrawingMode && !PrintRendering)
+    {
+        CRect outline((hover->absolute_X-ViewX)*ViewZoom/100-3,
+            (hover->absolute_Y-hover->Above-ViewY)*ViewZoom/100-3,
+            (hover->absolute_X+hover->Length-ViewX)*ViewZoom/100+3,
+            (hover->absolute_Y+hover->Below-ViewY)*ViewZoom/100+3);
+        int saved=dc->SaveDC();CPen pen(PS_DOT,1,RGB(232,232,232));
+        dc->SelectObject(&pen);dc->SelectStockObject(NULL_BRUSH);dc->Rectangle(outline);
+        dc->RestoreDC(saved);
+    }
+    PaintMoveGrip(dc);
+    PaintSizeHandle(dc);
+    if(hover && !PrintRendering){
+        CPoint p=DeleteGripPoint(hover);int saved=dc->SaveDC();
+        CPen pen(PS_SOLID,2,RGB(180,45,45));dc->SelectObject(&pen);
+        dc->FillSolidRect(p.x-8,p.y-8,17,17,RGB(255,245,245));
+        dc->MoveTo(p.x-4,p.y-4);dc->LineTo(p.x+5,p.y+5);
+        dc->MoveTo(p.x+4,p.y-4);dc->LineTo(p.x-5,p.y+5);
+        dc->RestoreDC(saved);
+    }
+    tDocumentStruct *object=RotationHandleDocument();
+    if (!object || object->MovingDotState==5) return;
+    CPoint point=RotationHandlePoint(object);
+    CPen pen(PS_SOLID,1,RGB(45,95,155));
+    CBrush brush(RGB(255,255,255));
+    CPen *oldPen=dc->SelectObject(&pen); CBrush *oldBrush=dc->SelectObject(&brush);
+    dc->MoveTo(point.x-8,point.y+8); dc->LineTo(point.x-3,point.y+3);
+    dc->Ellipse(point.x-8,point.y-8,point.x+9,point.y+9);
+    dc->Arc(point.x-5,point.y-5,point.x+6,point.y+6,point.x+5,point.y,point.x,point.y-5);
+    dc->MoveTo(point.x,point.y-5); dc->LineTo(point.x+4,point.y-5); dc->LineTo(point.x+3,point.y-1);
+    dc->SelectObject(oldBrush); dc->SelectObject(oldPen);
+    if (MouseRotationActive)
+    {
+        CString angle; angle.Format("%.1f degrees",object->Type==1 ? ((CExpression*)object->Object)->m_RotationMilliDegrees/1000.0 : RotationDrawingDegrees);
+        int saved=dc->SaveDC(); dc->SelectObject(GetStockObject(DEFAULT_GUI_FONT)); dc->SetTextAlign(TA_LEFT|TA_TOP);
+        dc->SetBkMode(OPAQUE); dc->SetBkColor(RGB(255,255,255)); dc->SetTextColor(RGB(0,0,0));
+        dc->TextOut(point.x+13,point.y-7,angle); dc->RestoreDC(saved);
+    }
+}
