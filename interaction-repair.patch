+static void CollectShaderEdges(CDrawing *drawing,double x,double y,std::vector<SmartShader::Edge>& edges,int depth=0)
+{
+    if(!drawing || drawing->IsSpecialDrawing || depth>16 || edges.size()>2048)return;
+    for(int i=0;i<drawing->NumItems && edges.size()<2048;i++){
+        tDrawingItem *item=drawing->Items+i;
+        if(item->Type==1 && (item->X1!=item->X2 || item->Y1!=item->Y2))edges.push_back(SmartShader::Edge(SmartShader::Point(x+item->X1,y+item->Y1),SmartShader::Point(x+item->X2,y+item->Y2)));
+        if(item->Type==0)CollectShaderEdges((CDrawing*)item->pSubdrawing,x+item->X1,y+item->Y1,edges,depth+1);
+    }
+}
+static void PrepareSmartShader(CDrawing *current)
+{
+    SmartShaderScene.clear();SmartShaderLines.clear();SmartShaderGuide=SmartShader::LineGuide();
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;if(object->Type!=2 || !object->Object || object->Object==(CObject*)current || object->MovingDotState==5)continue;
+        std::vector<SmartShader::Edge> edges;CollectShaderEdges((CDrawing*)object->Object,object->absolute_X*DRWZOOM,object->absolute_Y*DRWZOOM,edges);
+        SmartShader::Shape shape;shape.Build(edges);if(!shape.paths.empty())SmartShaderScene.push_back(shape);
+        else for(size_t edge=0;edge<edges.size();edge++)SmartShaderLines.push_back(edges[edge]);
+    }
+}
