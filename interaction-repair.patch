+{
+    FunctionHelpMouseTracking=false; FunctionHelpText.Empty();
+    if (FunctionHelpVisible) { FunctionHelpVisible=false; InvalidateRect(NULL,FALSE); }
+    CView::OnMouseLeave();
+}
