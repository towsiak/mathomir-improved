+    std::vector<DWORD> pixels(width*height);int rows=::GetDIBits(screen.m_hDC,(HBITMAP)bitmap.GetSafeHandle(),0,height,&pixels[0],&data,DIB_RGB_COLORS);
+    if(!restored||rows!=height)return -4;
+    long count=0;for(size_t i=0;i<pixels.size();i++){DWORD p=pixels[i]&0xffffff;if(p!=0xffffff && p!=0)count++;}
+    return count;
