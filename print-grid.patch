+        CPreviewDC preview;preview.m_bPrinting=TRUE;
+        preview.SetAttribDC(screen.m_hDC);preview.SetOutputDC(output.m_hDC);preview.SetScaleRatio(1,mode==3?2:1);
+        OnPrint(&preview,&info);preview.ReleaseOutputDC();preview.ReleaseAttribDC();
+    }else{output.m_bPrinting=TRUE;OnPrint(&output,&info);output.m_bPrinting=FALSE;}
+    bool restored=ViewX==oldX && ViewY==oldY && ViewZoom==oldZoom;PagePrinted=oldPage;
+    output.SelectObject(old);BITMAPINFO data={};data.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);
