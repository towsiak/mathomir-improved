+static bool UnitCommonAngle(double angle)
+{
+    const int angles[]={0,30,45,60,90,120,135,150,180,210,225,240,270,300,315,330};
+    for(int i=0;i<16;i++)if(fabs(remainder(angle-angles[i],360.))<1e-8)return true;
+    return false;
+}
+static void UnitCoordinatePair(CExpression *label,double angle)
+{
+    const double a=angle*3.14159265358979323846/180.;
+    label->InsertEmptyElement(0,2,'(');UnitValue(label,cos(a));
+    label->InsertEmptyElement(label->m_NumElements,2,',');UnitValue(label,sin(a));
+    label->InsertEmptyElement(label->m_NumElements,2,')');
+}
