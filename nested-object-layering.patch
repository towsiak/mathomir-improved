+// Enclosing diagrams are background interaction layers, regardless of creation
+// order. This does not reorder document objects or merge their Undo histories.
+static bool InteractionChild(tDocumentStruct *child,tDocumentStruct *container)
+{
+    if(AnnotationInsideLargeExpression(child,container))return true;
+    if(!child || !container || child==container || !child->Object || !container->Object ||
+        container->Type!=2 || IsGraphObject(child) ||
+        (child->Type==2 && ((CDrawing*)child->Object)->IsSpecialDrawing))return false;
+    double childArea=max(1,child->Length)*double(max(1,child->Above+child->Below));
+    double containerArea=max(1,container->Length)*double(max(1,container->Above+container->Below));
+    return childArea*1.5<containerArea && child->absolute_X>=container->absolute_X &&
+        child->absolute_X+child->Length<=container->absolute_X+container->Length &&
+        child->absolute_Y-child->Above>=container->absolute_Y-container->Above &&
+        child->absolute_Y+child->Below<=container->absolute_Y+container->Below;
+}
