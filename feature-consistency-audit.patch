+// Per-plot, per-slot immutable results shared by the UI and graph worker.
+// The complete source string is the key, including invalid input. No document
+// pointers or formatting-only checksums can leave stale numeric coordinates.
+class Cache {
+    std::mutex mutex;std::shared_ptr<const Entry> entry;
+public:
+    std::shared_ptr<const Entry> Resolve(const std::string &source){
+        std::lock_guard<std::mutex> lock(mutex);
+        if(!entry||entry->source!=source)entry=std::make_shared<const Entry>(source);
+        return entry;
+    }
