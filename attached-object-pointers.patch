+static int PointerLengthPreference=48;
+void PopupMenu::AddPointerOptions()
+{
+    if(m_AppearanceTargets.empty())return;
+    int direction=-1,length=-1;
+    for(int i=0;i<NumDocumentElements;i++){
+        tDocumentStruct *object=TheDocument+i;
+        if(!object->Object || std::find(m_AppearanceTargets.begin(),m_AppearanceTargets.end(),object->Object)==m_AppearanceTargets.end())continue;
+        CDrawing *drawing=object->Type==2?(CDrawing*)object->Object:NULL;
+        if(drawing && drawing->IsSpecialDrawing)return;
+        int d=drawing && drawing->HasObjectPointer()?drawing->m_PointerDirection:0;
+        int l=d?drawing->m_PointerLength:PointerLengthPreference;
+        if(direction==-1){direction=d;length=l;}else {if(direction!=d)direction=-2;if(length!=l)length=-2;}
+    }
+    AddMenuOption(0,3*TSize,"Pointer:",-952,1);
+    const int grid[9]={8,1,2,7,0,3,6,5,4};
+    const char *names[9]={"None","Up","Up-right","Right","Down-right","Down","Down-left","Left","Up-left"};
+    for(int i=0;i<9;i++)AddCheckedMenuOption((i%3)*TSize,TSize,(char*)names[grid[i]],direction==grid[i],960+grid[i],i%3==2);
+    const char *sizes[3]={"Short","Medium","Long"};const int lengths[3]={24,48,80};
+    for(int i=0;i<3;i++)AddCheckedMenuOption(i*TSize,TSize,(char*)sizes[i],length==lengths[i],969+i,i==2);
+}
+void PopupMenu::ApplyPointerOption(int data)
+{
+    std::vector<CObject*> targets=m_AppearanceTargets;HidePopupMenu();
+    if(ViewOnlyMode)return;
+    const int lengths[3]={24,48,80};bool sizeOnly=data>=969;
+    if(sizeOnly)PointerLengthPreference=lengths[data-969];
+    bool changed=false;
+    for(size_t k=0;k<targets.size();k++){
+        for(int i=0;i<NumDocumentElements;i++){
+            tDocumentStruct *object=TheDocument+i;if(object->Object!=targets[k] || object->MovingDotState==5)continue;
+            CDrawing *drawing=object->Type==2?(CDrawing*)object->Object:NULL;
+            if(drawing && drawing->IsSpecialDrawing)continue;
+            bool attached=drawing && drawing->HasObjectPointer();
+            int direction=sizeOnly?(attached?drawing->m_PointerDirection:0):data-960;
+            int length=sizeOnly?PointerLengthPreference:attached?drawing->m_PointerLength:PointerLengthPreference;
+            if(!direction && !attached)break;
+            if(attached && direction==drawing->m_PointerDirection && length==drawing->m_PointerLength)break;
+            if(!changed)((CMainFrame*)theApp.m_pMainWnd)->UndoSave("object pointer");
+            if(pMainView->SetObjectPointer(targets[k],direction,length))changed=true;
+            break;
+        }
+    }
+    if(changed){pMainView->GetDocument()->SetModifiedFlag();pMainView->RepaintTheView(1);}
+    pMainView->SetFocus();
+}
