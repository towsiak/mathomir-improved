+#pragma once
+#include <cmath>
+namespace ObjectPointer {
+struct Point {double x,y;};
+struct Line {Point a,b;};
+struct Arrow {Line line[3];};
+inline Point Direction(int direction){
+    const double diagonal=0.7071067811865475244;
+    const Point directions[8]={{0,-1},{diagonal,-diagonal},{1,0},{diagonal,diagonal},{0,1},{-diagonal,diagonal},{-1,0},{-diagonal,-diagonal}};
+    return directions[direction>=1 && direction<=8?direction-1:2];
+}
+inline Arrow Build(double width,double height,int direction,double length,double gap=6){
+    Point d=Direction(direction),center={width/2,height/2};
+    double reach=1e30;
+    if(d.x!=0)reach=width/(2*std::fabs(d.x));
+    if(d.y!=0){double vertical=height/(2*std::fabs(d.y));if(vertical<reach)reach=vertical;}
+    Point tail={center.x+d.x*(reach+gap),center.y+d.y*(reach+gap)};
+    Point tip={tail.x+d.x*length,tail.y+d.y*length};
+    double head=length/3;if(head>8)head=8;
+    Point left={tip.x-d.x*head-d.y*head/2,tip.y-d.y*head+d.x*head/2};
+    Point right={tip.x-d.x*head+d.y*head/2,tip.y-d.y*head-d.x*head/2};
+    Arrow arrow={{{tail,tip},{tip,left},{tip,right}}};return arrow;
+}
+}
