+// Traverse only the current live expression tree; never dereference a cached pointer.
+static bool ContainsCursorExpression(CExpression *root,CExpression *wanted,int depth=0)
+{
+    if(!root || depth>64)return false;
+    if(root==wanted)return true;
+    for(int i=0;i<root->m_NumElements;i++)
+    {
+        CElement *element=root->m_pElementList[i].pElementObject;
+        if(!element)continue;
+        if(ContainsCursorExpression((CExpression*)element->Expression1,wanted,depth+1) ||
+           ContainsCursorExpression((CExpression*)element->Expression2,wanted,depth+1) ||
+           ContainsCursorExpression((CExpression*)element->Expression3,wanted,depth+1))return true;
+    }
+    return false;
+}
