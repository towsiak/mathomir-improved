--- a/Mathomir/GraphPointLists.h
+++ b/Mathomir/GraphPointLists.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "TeachingTools.h"
+
+// Ordered pairs belong to a curve slot, so ordinary native editing, copying,
+// save/reopen and Undo all use the expression that the user actually typed.
+namespace GraphPointLists {
+enum Result { NotPoints, Invalid, Ready };
+inline Result Parse(const std::string &raw,std::vector<RelationGraph::Point> &points,std::string &error){
+    points.clear();error.clear();std::string s=TeachingTools::Trim(raw);
+    if(s.empty()||s[0]!='(')return NotPoints;
+    int depth=0;bool candidate=false;
+    for(char c:s){if(c=='(')++depth;else if(c==')'){if(--depth<=0)break;}else if(c==','&&depth==1){candidate=true;break;}}
+    if(!candidate)return NotPoints;
+    auto invalid=[&](const char *why){points.clear();error=why;return Invalid;};
+    if(s.size()>8192)return invalid("Point list is too long; use up to 8192 characters.");
+    size_t at=0;std::vector<RelationGraph::Point> parsed;
+    while(at<s.size()){
+        while(at<s.size()&&std::isspace((unsigned char)s[at]))++at;
+        if(at==s.size()||s[at]!='(')return invalid("Enter points as (1,2), (3,4). Each point needs parentheses.");
+        size_t start=++at,comma=std::string::npos;depth=1;
+        for(;at<s.size()&&depth;at++){
+            char c=s[at];if(c=='(')++depth;else if(c==')')--depth;
+            else if(c==','&&depth==1){if(comma!=std::string::npos)return invalid("Each point needs exactly two coordinates.");comma=at;}
+        }
+        if(depth||comma==std::string::npos)return invalid("Finish each point with two coordinates and a closing parenthesis.");
+        RelationGraph::Point p;
+        if(!TeachingTools::Constant(s.substr(start,comma-start),p.x)||!TeachingTools::Constant(s.substr(comma+1,at-comma-2),p.y))return invalid("Point coordinates must be finite numbers or constant expressions.");
+        if(std::fabs(p.x)>1e12||std::fabs(p.y)>1e12)return invalid("Point coordinates must have magnitude at most one trillion.");
+        parsed.push_back(p);if(parsed.size()>4096)return invalid("Use at most 4096 points in one entry.");
+        while(at<s.size()&&std::isspace((unsigned char)s[at]))++at;
+        if(at==s.size())break;
+        if(s[at++]!=',')return invalid("Separate points with a comma: (1,2), (3,4).");
+        if(TeachingTools::Trim(s.substr(at)).empty())return invalid("Add another point after the comma, or remove the comma.");
+    }
+    points.swap(parsed);return Ready;
+}
