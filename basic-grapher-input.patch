+// A child of the page, positioned inside its graph. Targets are resolved by
+// document epoch and stable object ID on every action; never retain a plot pointer.
+class CBasicGraphEditor;
+static CBasicGraphEditor *BasicGraphEditor=NULL;
+class CBasicGraphEditor:public CWnd {
+    unsigned int target,epoch;CBrush background;
+    CFunctionPlotter *Target(InteractiveNode *node=NULL){return epoch==InteractiveObjects::DocumentEpoch()?TeachPlot(target,node):NULL;}
+    void Control(const wchar_t *kind,const wchar_t *text,int id,int x,int y,int w,int h,DWORD style=0){
+        HWND control=::CreateWindowExW(!wcscmp(kind,L"EDIT")?WS_EX_CLIENTEDGE:0,kind,text,WS_CHILD|WS_VISIBLE|style,x,y,w,h,m_hWnd,(HMENU)(INT_PTR)id,AfxGetInstanceHandle(),NULL);
+        ::SendMessage(control,WM_SETFONT,(WPARAM)::GetStockObject(DEFAULT_GUI_FONT),FALSE);
+        if(!wcscmp(kind,L"EDIT"))::SendMessage(control,EM_SETLIMITTEXT,80,0);
+    }
+    void Close(){DestroyWindow();if(pMainView&&::IsWindow(pMainView->m_hWnd)){pMainView->SetFocus();pMainView->Invalidate(FALSE);}}
+    void Apply(){
+        auto plot=Target();if(!plot){Close();return;}TeachingTools::Axes value;
+        value.xName=TeachingTools::Trim(TeachGet(m_hWnd,1711));value.xUnit=TeachingTools::Trim(TeachGet(m_hWnd,1712));
+        value.yName=TeachingTools::Trim(TeachGet(m_hWnd,1713));value.yUnit=TeachingTools::Trim(TeachGet(m_hWnd,1714));
+        if(value.xName.empty()||value.yName.empty()||value.xName.size()>80||value.yName.size()>80||value.xUnit.size()>80||value.yUnit.size()>80){::SetDlgItemTextW(m_hWnd,1717,L"Use short names and optional units (80 bytes).");return;}
+        if(!plot->StopForZoom())return;
+        if(plot->axes.xName!=value.xName||plot->axes.yName!=value.yName||plot->axes.xUnit!=value.xUnit||plot->axes.yUnit!=value.yUnit){pMainView->UndoSave("graph axis names and units");plot->axes=value;pMainView->GetDocument()->SetModifiedFlag();}
+        Close();
+    }
+public:
+    CBasicGraphEditor(unsigned int id):target(id),epoch(InteractiveObjects::DocumentEpoch()),background(RGB(246,250,254)){}
+    bool Open(){
+        CString cls=AfxRegisterWndClass(CS_HREDRAW|CS_VREDRAW,::LoadCursor(NULL,IDC_ARROW),(HBRUSH)background.GetSafeHandle());
+        if(!CreateEx(0,cls,"Graph axis names and units",WS_CHILD|WS_VISIBLE|WS_BORDER|WS_CLIPCHILDREN,CRect(0,0,300,140),pMainView,1710))return false;
+        Control(L"STATIC",L"Axis names and units",-1,9,7,218,16);
+        Control(L"STATIC",L"Axis",-1,9,28,36,16);Control(L"STATIC",L"Name",-1,49,28,60,16);Control(L"STATIC",L"Units (optional)",-1,123,28,140,16);
+        Control(L"STATIC",L"Horiz.",-1,9,51,38,18);Control(L"EDIT",L"",1711,49,47,63,22,ES_AUTOHSCROLL|WS_TABSTOP);Control(L"EDIT",L"",1712,123,47,152,22,ES_AUTOHSCROLL|WS_TABSTOP);
+        Control(L"STATIC",L"Vert.",-1,9,78,38,18);Control(L"EDIT",L"",1713,49,74,63,22,ES_AUTOHSCROLL|WS_TABSTOP);Control(L"EDIT",L"",1714,123,74,152,22,ES_AUTOHSCROLL|WS_TABSTOP);
+        Control(L"BUTTON",L"Apply",1715,49,103,66,23,BS_DEFPUSHBUTTON|WS_TABSTOP);Control(L"BUTTON",L"Cancel",1716,123,103,66,23,WS_TABSTOP);
+        Control(L"STATIC",L"",1717,9,131,270,18);
+        auto plot=Target();if(!plot){Close();return false;}
+        TeachSet(m_hWnd,1711,plot->axes.xName);TeachSet(m_hWnd,1712,plot->axes.xUnit);TeachSet(m_hWnd,1713,plot->axes.yName);TeachSet(m_hWnd,1714,plot->axes.yUnit);
+        SetTimer(1,120,NULL);if(!Position())return false;::SetFocus(::GetDlgItem(m_hWnd,1712));return true;
+    }
+    bool Position(){
+        InteractiveNode node;auto plot=Target(&node);if(!plot||ViewOnlyMode||InteractiveHidden(node.root)){Close();return false;}
+        RelationGraph::Viewport viewport;CRect graph,client,visible;
+        if(!TeachViewport(node,plot,viewport,graph)){Close();return false;}pMainView->GetClientRect(client);visible.IntersectRect(graph,client);
+        int width=min(300,visible.Width()-12),height=154;
+        if(width<215||visible.Height()<height+8){Close();return false;}
+        int x=visible.left+6,y=min(visible.bottom-height-4,visible.top+42);
+        CRect current;GetWindowRect(current);pMainView->ScreenToClient(current);CRect desired(x,y,x+width,y+height);
+        if(current!=desired)SetWindowPos(&wndTop,x,y,width,height,SWP_NOACTIVATE);
+        int unitWidth=max(55,width-139);
+        for(int id:{1712,1714})GetDlgItem(id)->SetWindowPos(NULL,123,id==1712?47:74,unitWidth,22,SWP_NOZORDER|SWP_NOACTIVATE);
+        GetDlgItem(1717)->SetWindowPos(NULL,9,131,width-18,18,SWP_NOZORDER|SWP_NOACTIVATE);
+        return true;
+    }
+    virtual BOOL PreTranslateMessage(MSG *message){
+        if(message->message==WM_KEYDOWN){if(message->wParam==VK_ESCAPE){Close();return TRUE;}if(message->wParam==VK_RETURN){Apply();return TRUE;}
+            if(message->wParam==VK_TAB){HWND next=::GetNextDlgTabItem(m_hWnd,::GetFocus(),::GetKeyState(VK_SHIFT)<0);if(next)::SetFocus(next);return TRUE;}}
+        return CWnd::PreTranslateMessage(message);
+    }
+    virtual BOOL OnCommand(WPARAM wp,LPARAM lp){if(HIWORD(wp)==BN_CLICKED){if(LOWORD(wp)==1715){Apply();return TRUE;}if(LOWORD(wp)==1716){Close();return TRUE;}}return CWnd::OnCommand(wp,lp);}
+    virtual void PostNcDestroy(){if(BasicGraphEditor==this)BasicGraphEditor=NULL;delete this;}
+    afx_msg void OnTimer(UINT_PTR id){Position();}
+    afx_msg HBRUSH OnCtlColor(CDC *dc,CWnd *,UINT){dc->SetTextColor(RGB(25,35,45));dc->SetBkColor(RGB(246,250,254));return (HBRUSH)background.GetSafeHandle();}
+    DECLARE_MESSAGE_MAP()
+};
+BEGIN_MESSAGE_MAP(CBasicGraphEditor,CWnd)
+    ON_WM_TIMER()
+    ON_WM_CTLCOLOR()
+END_MESSAGE_MAP()
+static void UpdateBasicGraphEditor(){if(BasicGraphEditor&&::IsWindow(BasicGraphEditor->m_hWnd))BasicGraphEditor->Position();}
+void OpenBasicGraphAxes(CFunctionPlotter *plot){
+    auto nodes=InteractiveNodes(NULL);EnsureInteractiveIds(nodes);unsigned int target=0;
+    for(auto &node:nodes)if(node.type==2&&node.object==(CObject*)plot->Base){target=node.info->id;break;}
+    if(!target||ViewOnlyMode)return;
+    if(BasicGraphEditor)BasicGraphEditor->DestroyWindow();
+    if(KeyboardEntryObject)pMainView->SendMessage(WM_CHAR,VK_ESCAPE,0);
+    auto editor=new CBasicGraphEditor(target);BasicGraphEditor=editor;
+    if(!editor->Open()&&BasicGraphEditor==editor){BasicGraphEditor=NULL;delete editor;}
+}
