+inline std::string Lower(std::string s){for(char &c:s)c=(char)std::tolower((unsigned char)c);return s;}
+inline bool Match(const Entry&e,const std::string&q){std::string text=Lower(std::string(e.title)+" "+e.meaning+" "+e.when+" "+e.words+" "+e.tex+" "+Categories()[e.category]+(e.category>=5?" physics":""));std::string query=Lower(q);size_t p=0;while(p<query.size()){while(p<query.size()&&std::isspace((unsigned char)query[p]))p++;size_t start=p;while(p<query.size()&&!std::isspace((unsigned char)query[p]))p++;if(p>start&&text.find(query.substr(start,p-start))==text.npos)return false;}return true;}
