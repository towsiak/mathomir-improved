+++ b/Mathomir/MouseResizeFonts.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <vector>
+
+// Resizing changes font sizes, never the identity of editable math nodes.
+// Keeping the authored values makes every update independent of earlier drags.
+namespace MouseResizeFonts {
+struct FontState { CExpression *expression; short fontSize; };
+static std::vector<FontState> fonts;
+static void Capture(CExpression *expression)
+{
+    FontState state={expression,expression->m_FontSize};fonts.push_back(state);
+    for(int i=0;i<expression->m_NumElements;i++){
+        tElementStruct *item=expression->m_pElementList+i;
+        if(!item->Type || !item->pElementObject)continue;
+        CElement *element=item->pElementObject;
+        if(element->Expression1)Capture((CExpression*)element->Expression1);
+        if(element->Expression2)Capture((CExpression*)element->Expression2);
+        if(element->Expression3)Capture((CExpression*)element->Expression3);
+    }
+}
+static bool IsLive(CExpression *expression,size_t &index)
+{
+    if(index>=fonts.size() || fonts[index++].expression!=expression)return false;
+    for(int i=0;i<expression->m_NumElements;i++){
+        tElementStruct *item=expression->m_pElementList+i;
+        if(!item->Type || !item->pElementObject)continue;
+        CElement *element=item->pElementObject;
+        if(element->Expression1 && !IsLive((CExpression*)element->Expression1,index))return false;
+        if(element->Expression2 && !IsLive((CExpression*)element->Expression2,index))return false;
+        if(element->Expression3 && !IsLive((CExpression*)element->Expression3,index))return false;
+    }
+    return true;
+}
+static bool Apply(CExpression *expression,double factor)
+{
+    size_t index=0;
+    // Undo/open may replace a tree: inspect live nodes before touching old ones.
+    if(!IsLive(expression,index) || index!=fonts.size())return false;
+    for(size_t i=0;i<fonts.size();i++)
+        fonts[i].expression->m_FontSize=(short)max(10,min(32700,(int)floor(fonts[i].fontSize*factor+0.5)));
+    return true;
+}
+static int LargestFont(int rootSize)
+{
+    for(size_t i=0;i<fonts.size();i++)rootSize=max(rootSize,(int)fonts[i].fontSize);
+    return rootSize;
+}
+}
