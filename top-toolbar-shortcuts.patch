--- a/Mathomir/QuickToolbar.h
+++ b/Mathomir/QuickToolbar.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <vector>
+#include <algorithm>
+namespace QuickToolbar {
+struct Rect {int left,top,width,height;};
+struct Layout {std::vector<Rect> buttons;int height;Layout():height(0){}};
+// Keep every labeled shortcut visible. Measured button widths wrap in order;
+// the same height reserves the toolbar's space above the document.
+inline Layout Arrange(int width,const std::vector<int>& widths){
+    Layout result;if(width<=0||widths.empty())return result;
+    const int margin=width>=12?6:0,usable=(std::max)(1,width-2*margin);
+    int x=margin,y=4;
+    for(int wanted:widths){int w=(std::min)(usable,(std::max)(1,wanted));
+        if(x>margin&&x+w>width-margin){x=margin;y+=30;}
+        result.buttons.push_back({x,y,w,26});x+=w+6;
+    }
+    result.height=y+30;return result;
+}
+}
