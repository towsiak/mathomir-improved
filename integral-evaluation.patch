diff --git a/Mathomir/IntegralArea.h b/Mathomir/IntegralArea.h
new file mode 100644
--- /dev/null
+++ b/Mathomir/IntegralArea.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "SymbolicDerivative.h"
+#include "GraphDiscontinuities.h"
+#include "MathDisplay.h"
+
+// Proper finite real integrals. Adaptive refinement integrates f and |f|
+// independently; cancelling positive/negative areas must not hide an error.
+namespace IntegralArea {
+struct Settings {
+    std::string formula;double a,b;bool enabled,radians,hatch,labels;
+    Settings():formula("sin(x)"),a(0),b(3.14159265358979323846),enabled(false),radians(true),hatch(false),labels(true){}
+};
+struct Result {
+    SymbolicDerivative::Expr expression;double integral,area,error,ymin,ymax;int evaluations;bool ready;
+    Result():integral(0),area(0),error(0),ymin(0),ymax(0),evaluations(0),ready(false){}
+};
+inline double Value(const Settings &s,const Result &r,double x){return SymbolicDerivative::Value(r.expression,"x",x,s.radians);}
+inline bool Constant(const std::string &text,double &value,std::string &error){
+    try{SymbolicDerivative::Parser p;value=SymbolicDerivative::Value(p.Parse(text),"",0);
+        if(!SymbolicDerivative::Finite(value))throw std::runtime_error("Enter a finite constant, such as -2, 1/2 or pi.");return true;
+    }catch(const std::exception &e){error=e.what();return false;}
+}
+inline void Denominators(SymbolicDerivative::Expr n,std::vector<SymbolicDerivative::Expr> &out){
+    if(!n)return;if(n->op=='/')out.push_back(n->b);
+    if(n->op=='^' && n->b && n->b->op=='n' && n->b->number<0)out.push_back(n->a);
+    if(n->op=='f' && (n->name=="tan"||n->name=="sec"))out.push_back(SymbolicDerivative::F("cos",n->a));
+    if(n->op=='f' && (n->name=="cot"||n->name=="csc"))out.push_back(SymbolicDerivative::F("sin",n->a));
+    Denominators(n->a,out);Denominators(n->b,out);
+}
+struct Pair {double signedValue,absoluteValue;Pair(double s=0,double a=0):signedValue(s),absoluteValue(a){}};
+inline Pair Simpson(double a,double b,double fa,double fm,double fb){double h=(b-a)/6;return Pair(h*(fa+4*fm+fb),h*(std::fabs(fa)+4*std::fabs(fm)+std::fabs(fb)));}
+class Integrator {
+    const Settings &settings;Result &result;double low,high;
+    double At(double x){if(++result.evaluations>250000)throw std::runtime_error("This integral needs too much refinement. Reduce the interval or simplify the function.");
+        double y=Value(settings,result,x);if(!SymbolicDerivative::Finite(y))throw std::runtime_error("The function is undefined or unbounded inside these bounds. Improper integrals are not supported.");
+        result.ymin=(std::min)(result.ymin,y);result.ymax=(std::max)(result.ymax,y);return y;}
+    Pair Refine(double a,double b,double fa,double fm,double fb,Pair whole,double tolerance,int depth){
+        double m=a+(b-a)/2,l=a+(m-a)/2,r=m+(b-m)/2;
+        double fl=At(l),fr=At(r);Pair left=Simpson(a,m,fa,fl,fm),right=Simpson(m,b,fm,fr,fb);
+        Pair total(left.signedValue+right.signedValue,left.absoluteValue+right.absoluteValue);
+        double e=(std::max)(std::fabs(total.signedValue-whole.signedValue),std::fabs(total.absoluteValue-whole.absoluteValue))/15;
+        if(e<=tolerance || depth==0 || l==a || r==b){result.error+=e;return total;}
+        Pair x=Refine(a,m,fa,fl,fm,left,tolerance/2,depth-1),y=Refine(m,b,fm,fr,fb,right,tolerance/2,depth-1);
+        return Pair(x.signedValue+y.signedValue,x.absoluteValue+y.absoluteValue);
+    }
+public:
+    Integrator(const Settings &s,Result &r):settings(s),result(r),low((std::min)(s.a,s.b)),high((std::max)(s.a,s.b)){}
+    void Run(){
+        std::vector<SymbolicDerivative::Expr> denominators;Denominators(result.expression,denominators);
+        for(auto denominator:denominators){std::vector<double> roots;GraphDiscontinuities::Roots([&](double x){return SymbolicDerivative::Value(denominator,"x",x,settings.radians);},low,high,roots);
+            if(!roots.empty())throw std::runtime_error("A denominator is zero in this interval. Choose bounds that avoid the excluded point; improper integrals are not supported.");}
+        // Seed subintervals avoid missing broad peaks or isolated domain gaps.
+        const int count=128;double previous=At(low);Pair sum;
+        for(int i=0;i<count;i++){double a=low+(high-low)*i/count,b=low+(high-low)*(i+1)/count,m=a+(b-a)/2;
+            double fm=At(m),fb=At(b);Pair part=Refine(a,b,previous,fm,fb,Simpson(a,b,previous,fm,fb),1e-9/count,28);
+            sum.signedValue+=part.signedValue;sum.absoluteValue+=part.absoluteValue;previous=fb;}
+        result.integral=settings.b<settings.a?-sum.signedValue:sum.signedValue;result.area=sum.absoluteValue;
+        if(!SymbolicDerivative::Finite(result.integral)||!SymbolicDerivative::Finite(result.area)||result.error>1e-7*(1+result.area))throw std::runtime_error("The numerical estimate did not converge reliably. Reduce the interval; check for poles or rapid oscillations.");
+    }
+};
+inline bool Calculate(const Settings &s,Result &r,std::string &error){
+    r=Result();try{if(!SymbolicDerivative::Finite(s.a)||!SymbolicDerivative::Finite(s.b)||s.a==s.b||!SymbolicDerivative::Finite(s.b-s.a))throw std::runtime_error("Enter two distinct finite bounds. Reversed bounds are allowed.");
+        SymbolicDerivative::Parser p;r.expression=p.Parse(s.formula);Integrator(s,r).Run();r.ready=true;return true;
+    }catch(const std::exception &e){error=e.what();return false;}
+}
+inline std::wstring Report(const Settings &s,const Result &r){
+    return L"Bounds: "+MathDisplay::Number(s.a)+L" \u2192 "+MathDisplay::Number(s.b)+L"    Signed integral \u2248 "+MathDisplay::Number(r.integral)+L"\r\nTotal area \u2248 "+MathDisplay::Number(r.area)+L"    Estimated numerical error \u2248 "+MathDisplay::Number(r.error)+L"\r\nBlue: above the x-axis. Rose: below. Reversing bounds changes the integral sign, not the total area.";
+}
+}
diff --git a/Mathomir/IntegralPaint.h b/Mathomir/IntegralPaint.h
new file mode 100644
--- /dev/null
+++ b/Mathomir/IntegralPaint.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "IntegralArea.h"
+
+inline void PaintIntegralArea(CDC &dc,const IntegralArea::Settings &s,const IntegralArea::Result &r,
+    CRect plot,double xmin,double xmax,double ymin,double ymax,bool curve=false)
+{
+    if(!r.ready || xmin>=xmax || ymin>=ymax || plot.Width()<2 || plot.Height()<2)return;
+    int saved=dc.SaveDC();dc.IntersectClipRect(plot);dc.SetROP2(R2_COPYPEN);
+    auto px=[&](double x){return plot.left+(int)((x-xmin)/(xmax-xmin)*(plot.Width()-1));};
+    auto py=[&](double y){double f=(y-ymin)/(ymax-ymin);f=(std::max)(-1.,(std::min)(2.,f));return plot.bottom-1-(int)(f*(plot.Height()-1));};
+    double low=(std::min)(s.a,s.b),high=(std::max)(s.a,s.b);
+    CBrush positive,negative;positive.CreateHatchBrush(HS_BDIAGONAL,RGB(80,125,185));negative.CreateHatchBrush(HS_BDIAGONAL,RGB(180,95,115));
+    dc.SetBkMode(OPAQUE);
+    for(int i=0;i<plot.Width();i++){
+        double x=xmin+(xmax-xmin)*(i+.5)/plot.Width();if(x<low||x>high)continue;
+        double y=IntegralArea::Value(s,r,x);if(!SymbolicDerivative::Finite(y))continue;
+        int y0=py(0),yf=py(y);CRect strip(plot.left+i,(std::min)(y0,yf),plot.left+i+1,(std::max)(y0,yf));
+        COLORREF tint=y>=0?RGB(219,234,253):RGB(252,222,229);
+        if(s.hatch){dc.SetBkColor(tint);dc.FillRect(strip,y>=0?&positive:&negative);}else dc.FillSolidRect(strip,tint);
+    }
+    CPen bounds(PS_DASH,1,RGB(110,115,125)),axis(PS_SOLID,1,RGB(165,170,178)),line(PS_SOLID,2,RGB(25,35,50));
+    dc.SelectObject(&axis);if(ymin<=0&&ymax>=0){dc.MoveTo(plot.left,py(0));dc.LineTo(plot.right,py(0));}
+    dc.SelectObject(&bounds);for(double x:{s.a,s.b})if(x>=xmin&&x<=xmax){dc.MoveTo(px(x),plot.top);dc.LineTo(px(x),plot.bottom);}
+    if(curve){dc.SelectObject(&line);bool previous=false;for(int i=0;i<plot.Width();i++){
+        double x=xmin+(xmax-xmin)*i/(plot.Width()-1),y=IntegralArea::Value(s,r,x);
+        if(!SymbolicDerivative::Finite(y)){previous=false;continue;}if(previous)dc.LineTo(plot.left+i,py(y));else dc.MoveTo(plot.left+i,py(y));previous=true;
+    }}
+    dc.RestoreDC(saved);
+}
+inline void IntegralViewport(const IntegralArea::Settings &s,const IntegralArea::Result &r,double &xmin,double &xmax,double &ymin,double &ymax)
+{
+    xmin=(std::min)(s.a,s.b);xmax=(std::max)(s.a,s.b);double xp=(xmax-xmin)*.1;xmin-=xp;xmax+=xp;
+    ymin=r.ymin;ymax=r.ymax;double yp=(std::max)((ymax-ymin)*.15,1e-6);ymin-=yp;ymax+=yp;
+}
