+// Drawing bounds describe node coordinates; thick strokes also extend left
+// and above them. Include that ink in both the preview and its saved background.
+static int PlacementStrokePadding(CDrawing *drawing,int depth=0)
+{
+    if(!drawing || depth>64)return 2;
+    int padding=2;
+    for(int i=0;i<drawing->NumItems;i++){
+        tDrawingItem *item=drawing->Items+i;
+        if(item->Type==1)padding=max(padding,(max(0,(int)item->LineWidth)*ViewZoom+199*DRWZOOM)/(200*DRWZOOM)+2);
+        else if(item->Type==0 && item->pSubdrawing)padding=max(padding,PlacementStrokePadding((CDrawing*)item->pSubdrawing,depth+1));
+    }
+    return padding;
+}
+
+// The native graph worker can render a prepared graph without a document
+// entry. Its atomic flag stays with that private held graph until cancellation.
+static bool PlacementGraphState(CDrawing *drawing,bool enable,int depth=0)
+{
+    if(!drawing || depth>64)return false;
+    bool busy=false;
+    if(drawing->IsSpecialDrawing==51 && drawing->SpecialData){
+        CFunctionPlotter *plot=(CFunctionPlotter*)drawing->SpecialData;
+        if(enable)plot->FloatingPreview=true;
+        busy=plot->ThreadHandle!=NULL;
+    }
+    for(int i=0;i<drawing->NumItems;i++)if(drawing->Items[i].Type==0 && drawing->Items[i].pSubdrawing)
+        busy=PlacementGraphState((CDrawing*)drawing->Items[i].pSubdrawing,enable,depth+1)||busy;
+    return busy;
+}
+
+// Preview and commit use the same font and document-coordinate calculations.
+static int ClipboardPlacementFont()
+{
+    return ClipboardExpression && (RootObjectCopy==-1 || RootObjectCopy==ClipboardExpression->CalcChecksum())
+        ? RootObjectFontSize : DefaultFontSize;
+}
+
+static void ResolveExpressionPlacement(int cursorX,int cursorY,int &x,int &y,bool separate)
+{
+    x=ViewX+cursorX*100/ViewZoom;y=ViewY+cursorY*100/ViewZoom;
+    if(!separate && GuidlineElement>=0)x=prevGuidlineX;
+    else if(IsCanvasGridSnapActive() && !(GetKeyState(VK_MENU)&0xFFFE))SnapCanvasGridPoint(x,y,3);
+}
+
+static void ResolveDrawingPlacement(CDrawing *drawing,int cursorX,int cursorY,int &x,int &y)
+{
+    x=ViewX+cursorX*100/ViewZoom-MovingStartX;
+    y=ViewY+cursorY*100/ViewZoom-MovingStartY;
+    if(MouseMode==9 || MouseMode==11)return;
+    if(SpecialDrawingHover && ((CDrawing*)SpecialDrawingHover->Object)->IsSpecialDrawing==50){
+        if((GetKeyState(VK_MENU)&0xFFFE) && tmpDrawing){
+            int px=x+MovingStartX,py=y+MovingStartY;
+            if(tmpDrawing->FindNerbyPoint(&px,&py,NULL,0,0,0,0)){x=px-MovingStartX;y=py-MovingStartY;}
+        }
+    }else if(IsCanvasGridSnapActive() && !(GetKeyState(VK_MENU)&0xFFFE)){
+        SnapCanvasGridPoint(x,y);
+        int cornerX,cornerY;drawing->FindRealCorner(&cornerX,&cornerY);x-=cornerX;y-=cornerY;
+    }
+}
