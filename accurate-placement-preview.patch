+int CMathomirView::PaintClipboard(int X,int Y)
+{
+    RestoreClipboardBackground();
+    if(PlacementPreviewPaused || (!ClipboardExpression && !ClipboardDrawing) || ViewZoom<=0)return 0;
+    CRect client;GetClientRect(&client);
+    if(!client.PtInRect(CPoint(X,Y)))return 0;
+    CPoint screen(X,Y);ClientToScreen(&screen);
+    if(::WindowFromPoint(screen)!=GetSafeHwnd())return 0;
+
+    CClientDC dc(this);
+    const bool separate=(GetKeyState(VK_SHIFT)&0x8000)!=0;
+    bool compact=false;
+    int font=ClipboardPlacementFont();
+    if(ClipboardExpression && !separate){
+        tDocumentStruct *target=FrontContentAtPoint(CPoint(X,Y));
+        if(target && target->Type==1){compact=true;font=((CExpression*)target->Object)->m_FontSize;}
+        // Insertion may reflow an existing equation. Show a labelled payload
+        // thumbnail beside its native insertion marker, not a false drop site.
+        for(int i=0;i<NumDocumentElements;i++)if(TheDocument+i==IsInsertionPointTouched && TheDocument[i].Type==1){
+            compact=true;font=((CExpression*)TheDocument[i].Object)->m_FontSize;break;
+        }
+        int row=NewlineAddObject&0x3FFFFFFF;
+        if(NewlineAddObject>=0 && row<NumDocumentElements && TheDocument[row].Type==1){
+            compact=true;font=((CExpression*)TheDocument[row].Object)->m_FontSize;
+        }
+    }
+    CExpression expression(NULL,NULL,font);
+    short length=0,above=0,below=0;
+    int docX=0,docY=0,paintX=0,paintY=0,zoom=ViewZoom;
+    struct Item { CExpression *expression;CDrawing *drawing;int x,y,docX,docY;CRect bounds; };
+    std::vector<Item> items;
+    CRect bounds;bounds.SetRectEmpty();
+    if(ClipboardExpression){
+        // The same copy operation as commit preserves nested sizes, rotation,
+        // colors and table formatting without modifying the held source.
+        expression.CopyExpression(ClipboardExpression,0,1,0);expression.DeselectExpression();
+        expression.CalculateSize(&dc,zoom,&length,&above,&below);
+        if(compact){
+            double scale=min(1.0,min(220.0/max(1,(int)length),140.0/max(1,(int)above+below)));
+            zoom=max(5,(int)(ViewZoom*scale));
+            expression.CalculateSize(&dc,zoom,&length,&above,&below,0,0);
+            paintX=max(4,min(X+16,client.right-(int)length-8));
+            int top=max(24,min(Y+20,client.bottom-(int)above-below-8));paintY=top+above;
+        }else{
+            ResolveExpressionPlacement(X,Y,docX,docY,separate);
+            paintX=(docX-ViewX)*ViewZoom/100;paintY=(docY-ViewY)*ViewZoom/100;
+        }
+        bounds=CRect(paintX,paintY-above,paintX+max(1,(int)length),paintY+max(1,(int)below));
+        Item item={&expression,NULL,paintX,paintY,docX,docY,bounds};items.push_back(item);
+    }else{
+        ClipboardDrawing->SelectDrawing(0);
+        ClipboardDrawing->CalculateSize(&dc,ViewZoom,&length,&below);
+        ResolveDrawingPlacement(ClipboardDrawing,X,Y,docX,docY);
+        // A held group is unpacked on commit. Match each child's rounding and
+        // expression baseline exactly, instead of painting an approximate group.
+        for(int i=0;i<ClipboardDrawing->NumItems;i++){
+            tDrawingItem *source=ClipboardDrawing->Items+i;
+            if(!source->pSubdrawing || (source->Type!=0 && source->Type!=2))continue;
+            Item item={};item.docX=docX+source->X1/DRWZOOM;item.docY=docY+source->Y1/DRWZOOM;
+            short l=0,a=0,b=0;
+            if(source->Type==0){
+                item.drawing=(CDrawing*)source->pSubdrawing;item.drawing->CalculateSize(&dc,ViewZoom,&l,&b);
+            }else{
+                item.expression=(CExpression*)source->pSubdrawing;item.expression->CalculateSize(&dc,ViewZoom,&l,&a,&b);
+                item.docY+=a*100/ViewZoom;
+            }
+            item.x=(item.docX-ViewX)*ViewZoom/100;item.y=(item.docY-ViewY)*ViewZoom/100;
+            item.bounds=CRect(item.x,item.y-a,item.x+max(1,(int)l),item.y+max(1,(int)b));
+            if(item.drawing){int padding=PlacementStrokePadding(item.drawing);item.bounds.InflateRect(padding,padding);}
+            if(bounds.IsRectEmpty())bounds=item.bounds;else bounds.UnionRect(bounds,item.bounds);
+            items.push_back(item);
+        }
+        paintX=(docX-ViewX)*ViewZoom/100;paintY=(docY-ViewY)*ViewZoom/100;
+    }
+    if(items.empty() || bounds.IsRectEmpty())return 0;
+
+    const char *label=compact?"Insert into math":"Preview   Click to place   Esc to cancel";
+    CFont *oldFont=dc.SelectObject((CFont*)CFont::FromHandle((HFONT)::GetStockObject(DEFAULT_GUI_FONT)));
+    CSize text=dc.GetTextExtent(label,(int)strlen(label));dc.SelectObject(oldFont);
+    int badgeX=max(3,min(bounds.left,client.right-text.cx-12));
+    int badgeY=bounds.top-text.cy-11;if(badgeY<3)badgeY=min(client.bottom-text.cy-9,bounds.bottom+8);
+    CRect badge(badgeX,badgeY,badgeX+text.cx+10,badgeY+text.cy+6);
+    CRect footprint=bounds;footprint.InflateRect(4,4);
+    CRect region;region.UnionRect(footprint,badge);region.InflateRect(2,2);region.IntersectRect(region,client);
+    if(region.IsRectEmpty())return 0;
+
+    // Save only visible canvas pixels: very large objects never require a
+    // bitmap the size of the entire object, and never get silently shrunk.
+    if(!ClipboardBackground.bmp || ClipboardBackground.Cx!=region.Width() || ClipboardBackground.Cy!=region.Height()){
+        if(ClipboardBackground.DC){ClipboardBackground.DC->DeleteDC();delete ClipboardBackground.DC;ClipboardBackground.DC=NULL;}
+        if(ClipboardBackground.bmp){delete ClipboardBackground.bmp;ClipboardBackground.bmp=NULL;}
+        ClipboardBackground.bmp=new CBitmap();ClipboardBackground.DC=new CDC();
+        if(!ClipboardBackground.bmp->CreateCompatibleBitmap(&dc,region.Width(),region.Height()) || !ClipboardBackground.DC->CreateCompatibleDC(&dc)){
+            delete ClipboardBackground.DC;ClipboardBackground.DC=NULL;
+            delete ClipboardBackground.bmp;ClipboardBackground.bmp=NULL;return 0;
+        }
+        ClipboardBackground.DC->SelectObject(ClipboardBackground.bmp);
+    }
+    ClipboardBackground.X=region.left;ClipboardBackground.Y=region.top;
+    ClipboardBackground.Cx=region.Width();ClipboardBackground.Cy=region.Height();ClipboardBackground.ZoomLevel=ViewZoom;
+    ClipboardBackground.DC->BitBlt(0,0,region.Width(),region.Height(),&dc,region.left,region.top,SRCCOPY);
+    CDC buffer;CBitmap image;
+    if(!buffer.CreateCompatibleDC(&dc) || !image.CreateCompatibleBitmap(&dc,region.Width(),region.Height()))return 0;
+    CBitmap *oldBitmap=buffer.SelectObject(&image);
+    buffer.BitBlt(0,0,region.Width(),region.Height(),ClipboardBackground.DC,0,0,SRCCOPY);
+    int state=buffer.SaveDC();buffer.SetViewportOrg(-region.left,-region.top);
+    if(compact)buffer.FillSolidRect(bounds,RGB(255,255,255));
+    for(size_t i=0;i<items.size();i++){
+        Item &item=items[i];
+        CRect visible;visible.IntersectRect(item.bounds,client);if(visible.IsRectEmpty())continue;
+        int itemState=buffer.SaveDC();
+        if(item.expression)item.expression->PaintExpression(&buffer,(short)zoom,(short)item.x,(short)item.y);
+        else{PlacementGraphState(item.drawing,true);item.drawing->PaintDrawing(&buffer,ViewZoom,(short)item.x,(short)item.y,item.docX,item.docY);}
+        buffer.RestoreDC(itemState);
+    }
+    CPen outline(PS_DOT,1,RGB(112,139,162));buffer.SelectObject(&outline);buffer.SelectStockObject(NULL_BRUSH);buffer.SetBkMode(TRANSPARENT);
+    buffer.Rectangle(footprint);
+    buffer.FillSolidRect(badge,RGB(255,255,255));buffer.Draw3dRect(badge,RGB(204,214,222),RGB(204,214,222));
+    buffer.SelectStockObject(DEFAULT_GUI_FONT);buffer.SetTextAlign(TA_LEFT|TA_TOP);buffer.SetBkMode(TRANSPARENT);buffer.SetTextColor(RGB(45,55,65));buffer.TextOut(badge.left+5,badge.top+3,label);
+    buffer.RestoreDC(state);
+    dc.BitBlt(region.left,region.top,region.Width(),region.Height(),&buffer,0,0,SRCCOPY);
+    buffer.SelectObject(oldBitmap);ClipboardBackground.Restored=0;
+    if(getenv("MATHOMIR_PLACEMENT_DIAGNOSTICS")){
+        const char *names[]={"Active","Left","Top","Right","Bottom","X","Y","Zoom","Kind"};
+        int values[]={1,bounds.left,bounds.top,bounds.right,bounds.bottom,docX,docY,ViewZoom,compact?3:ClipboardExpression?1:2};
+        for(int i=0;i<9;i++){CString key="MathomirPlacement_";key+=names[i];::SetProp(GetSafeHwnd(),key,(HANDLE)(INT_PTR)(values[i]+1));}
+    }
+    return 1;
+}
