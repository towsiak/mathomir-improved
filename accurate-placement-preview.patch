+// Opt-in Windows regression probe. Use the real clipboard-copy paths while
+// keeping test setup independent of the native click-to-copy selection gesture.
+LRESULT CMathomirView::OnPlacementPreviewProbe(WPARAM kind,LPARAM)
+{
+    if(!getenv("MATHOMIR_PLACEMENT_DIAGNOSTICS") || !NumDocumentElements)return 0;
+    if(kind==3){
+        if(PlacementGraphState(ClipboardDrawing,false))return 1;
+        for(int i=0;i<NumDocumentElements;i++)if(TheDocument[i].Type==2 && PlacementGraphState((CDrawing*)TheDocument[i].Object,false))return 1;
+        return 0;
+    }
+    CancelFloatingPlacement();
+    if(kind==1 && TheDocument[0].Type==1){
+        CExpression *source=(CExpression*)TheDocument[0].Object;
+        ClipboardExpression=new CExpression(NULL,NULL,100);
+        ClipboardExpression->CopyExpression(source,0,1,0);
+        RootObjectCopy=-1;RootObjectFontSize=source->m_FontSize;
+    }else if(kind==2){
+        int x=0,y=0;ClipboardDrawing=(CDrawing*)ComposeDrawing(&x,&y,1,0);
+    }
+    for(int i=0;i<NumDocumentElements;i++){
+        TheDocument[i].MovingDotState=0;
+        if(TheDocument[i].Type==1)((CExpression*)TheDocument[i].Object)->DeselectExpression();
+        else if(TheDocument[i].Type==2)((CDrawing*)TheDocument[i].Object)->SelectDrawing(0);
+    }
+    NumSelectedObjects=0;MouseMode=0;IsDrawingMode=0;TouchMouseMode=0;
+    MovingStartX=MovingStartY=0;IsInsertionPointTouched=NULL;NewlineAddObject=-1;GuidlineElement=-2;
+    SetFocus();RepaintTheView();return ClipboardExpression||ClipboardDrawing?1:0;
 }
 
