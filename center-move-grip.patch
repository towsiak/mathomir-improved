+// A fixed screen-size control near the visible center. Prefer whitespace and
+// never cover a foreground annotation; layout is deterministic while hovering.
+static bool CenterMoveGripPoint(tDocumentStruct *object,CPoint &point)
+{
+    if(!object || !object->Object || object->MovingDotState==5 || PrintRendering || NumSelectedObjects>1)return false;
+    if(MouseMovingActive && CenterMovePending && MoveGripObject==object->Object){
