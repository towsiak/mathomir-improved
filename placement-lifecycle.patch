+// Internal clipboard objects are a floating preview, not the system clipboard.
+// Cancel them before replacing a document so placement mode cannot leak into it.
+void CMathomirView::CancelFloatingPlacement()
+{
+    RestoreClipboardBackground();
+    if(ClipboardExpression){delete ClipboardExpression;ClipboardExpression=NULL;}
+    if(ClipboardDrawing){delete ClipboardDrawing;ClipboardDrawing=NULL;}
+    RootObjectCopy=0;
+    ExplicitTypingRoot=NULL;
+    ClipboardBackground.Restored=1;
+    SetCursor(::LoadCursor(NULL,IDC_ARROW));
+    Invalidate(FALSE);
+}
