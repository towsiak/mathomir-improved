+#include <wincred.h>
+#include <atomic>
+#include <memory>
+#include <thread>
+#pragma comment(lib,"winhttp.lib")
+#pragma comment(lib,"advapi32.lib")
+
+namespace MathomirAI {
+inline std::string ToUtf8(const std::wstring &s){if(s.empty())return "";int n=WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,s.data(),(int)s.size(),NULL,0,NULL,NULL);if(!n)throw std::runtime_error("The entered text contains an invalid character.");std::string out(n,0);WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,s.data(),(int)s.size(),&out[0],n,NULL,NULL);return out;}
+inline std::wstring ToWide(const std::string &s){if(s.empty())return L"";int n=MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,s.data(),(int)s.size(),NULL,0);if(!n)throw std::runtime_error("The AI service returned invalid text.");std::wstring out(n,0);MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,s.data(),(int)s.size(),&out[0],n);return out;}
+inline void Erase(std::wstring &s){if(!s.empty())SecureZeroMemory(&s[0],s.size()*sizeof(wchar_t));s.clear();}
+inline const wchar_t *CredentialTarget(){return L"Mathomir/OpenAI/PersonalKey";}
+inline std::wstring StoredKey(){
+    PCREDENTIALW value=NULL;if(CredReadW(CredentialTarget(),CRED_TYPE_GENERIC,0,&value)){std::wstring key;if(value->CredentialBlobSize<=8192&&value->CredentialBlobSize%sizeof(wchar_t)==0)key.assign((wchar_t*)value->CredentialBlob,value->CredentialBlobSize/sizeof(wchar_t));SecureZeroMemory(value->CredentialBlob,value->CredentialBlobSize);CredFree(value);if(KeyValid(key))return key;Erase(key);}
+    DWORD n=GetEnvironmentVariableW(L"OPENAI_API_KEY",NULL,0);if(n&&n<=4097){std::vector<wchar_t> buffer(n,0);DWORD written=GetEnvironmentVariableW(L"OPENAI_API_KEY",buffer.data(),n);std::wstring key=written&&written<n?std::wstring(buffer.data(),written):L"";SecureZeroMemory(buffer.data(),buffer.size()*sizeof(wchar_t));if(KeyValid(key))return key;Erase(key);}return L"";
+}
+inline bool SaveKey(const std::wstring &key){if(!KeyValid(key))return false;CREDENTIALW c={};c.Type=CRED_TYPE_GENERIC;c.TargetName=(LPWSTR)CredentialTarget();c.UserName=(LPWSTR)L"Personal OpenAI API key";c.CredentialBlob=(LPBYTE)key.data();c.CredentialBlobSize=(DWORD)(key.size()*sizeof(wchar_t));c.Persist=CRED_PERSIST_LOCAL_MACHINE;return CredWriteW(&c,0)!=FALSE;}
+inline bool ForgetKey(){if(CredDeleteW(CredentialTarget(),CRED_TYPE_GENERIC,0))return true;return GetLastError()==ERROR_NOT_FOUND;}
+struct InternetHandle{HINTERNET h;InternetHandle(HINTERNET value=NULL):h(value){}~InternetHandle(){if(h)WinHttpCloseHandle(h);}InternetHandle(const InternetHandle&)=delete;InternetHandle &operator=(const InternetHandle&)=delete;};
+struct Job {
+    std::atomic<bool> cancelled,done;std::wstring reply;bool success;
+    Job():cancelled(false),done(false),success(false){}
+};
+inline void NetworkFailure(){DWORD e=GetLastError();throw std::runtime_error(e==ERROR_WINHTTP_TIMEOUT?"The AI connection timed out. Try again; no automatic retry was sent.":e==ERROR_WINHTTP_SECURE_FAILURE?"A secure connection could not be established. Check your Windows updates, clock, and network.":"Could not connect to OpenAI. Check your internet connection, proxy, or firewall.");}
+inline std::wstring Perform(const std::shared_ptr<Job> &job,const std::wstring &key,const std::string &body){
