+void CMathomirView::OnAiHelp()
+{
+    if(ViewOnlyMode)return;std::wstring selection;
+    if(m_SelectionApproxPanel&&m_SelectionApproxPanel->IsWindowVisible())selection=MathDisplay::HelpNotation(m_SelectionApproxPanel->formula);
+    if(selection.empty()){
+        tDocumentStruct *object=NULL;for(int i=0;i<NumDocumentElements;i++)if(TheDocument[i].Type==1&&((NumSelectedObjects==1&&TheDocument[i].MovingDotState==3)||(!NumSelectedObjects&&(TheDocument+i==KeyboardEntryBaseObject||TheDocument+i==prevTouchedObject)))){object=TheDocument+i;break;}
