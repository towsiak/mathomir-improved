+    WinHttpSetTimeouts(session.h,5000,10000,15000,45000);DWORD protocols=WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2;WinHttpSetOption(session.h,WINHTTP_OPTION_SECURE_PROTOCOLS,&protocols,sizeof(protocols));
